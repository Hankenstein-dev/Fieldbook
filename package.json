{
  "name": "fieldbook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:https": "vite --host 0.0.0.0 --mode https",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "phone:setup": "node scripts/phone-setup.mjs",
    "phone": "node scripts/phone.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "npm run test && npm run build",
    "prepare:fieldbook": "python3 scripts/prepare_fieldbook.py --offline",
    "prepare:catalogue": "python3 scripts/prepare_catalogue.py",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"config/*.ts\" \"tests/**/*.ts\" \"*.ts\"",
    "predev": "node scripts/prepare_runtime.mjs",
    "predev:https": "node scripts/prepare_runtime.mjs",
    "prebuild": "node scripts/prepare_runtime.mjs",
    "build:android": "node scripts/prepare-android.mjs && tsc -b && vite build --mode android",
    "android:build": "bash scripts/android-build.sh",
    "android:open": "cap open android",
    "build:web": "node scripts/prepare-web.mjs && tsc -b && vite build --mode web && node scripts/check-web-build.mjs",
    "preview:web": "vite preview --mode web --host 0.0.0.0",
    "test:iphone": "playwright test --config playwright.iphone.config.ts",
    "deploy:web": "node scripts/deploy-web.mjs",
    "check:web:live": "node scripts/check-live-web.mjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@huggingface/tokenizers": "^0.2.0",
    "@mapbox/vector-tile": "^3.0.0",
    "dexie": "^4.4.5",
    "lucide-react": "^1.43.0",
    "maplibre-gl": "^6.8.0",
    "onnxruntime-web": "^1.29.0",
    "pbf": "^5.1.2",
    "pmtiles": "^4.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@capacitor/cli": "^8.5.1",
    "@playwright/test": "^1.63.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
