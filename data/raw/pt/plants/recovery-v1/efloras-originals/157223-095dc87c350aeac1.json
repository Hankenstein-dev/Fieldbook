chBox\" action=\"browse.aspx\" method=\"get\">\r\n          <TABLE borderColor=\"#ccffcc\" cellSpacing=\"0\" cellPadding=\"2\" width=\"200\" border=\"1\">\r\n            <TR>\r\n              <TD>\r\n                <span id=\"ucEfloraHeader_lblSearchBox\"><INPUT TYPE='Hidden' NAME='flora_id' ' id='flora_id' VALUE='4' >\n&nbsp;<input id=name_str name=name_str &nbsp;  value=''  class=small title='Use % as the wildcard\r\n(e.g. pinus % or pinus a%)'  onfocus='jsClearTextBox(this);' accessKey=s size=15> <input class=small type=submit value=Search name=btnSearch><br>\n <input name=chkAllFloras type=checkbox   > <span class=small>All Floras &nbsp; &nbsp; &nbsp;<A HREF='search_page.aspx?flora_id=4'  TARGET='_top'  class='a.link.small'>Advanced Search</A></span>\n</span></TD>\r\n            </TR>\r\n          </TABLE>\r\n        </FORM> <!-- end of search box -->\r\n      \r\n\t\t</div>\r\n    </TD>\r\n\t</tr>\r\n</table>\r\n\r\n</TD>\r\n      </TR>\r\n      <TR>\r\n        <TD id=\"tdSubHeader\">\r\n<table id=\"FooterTableOut\" width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\r\n  <tr>\r\n    <td bgcolor=\"#999999\"><img src=\"~/images/layout/dot.gif\" alt=\"\" width=\"100%\" height=\"1\"></td>\r\n  </tr>\r\n  <tr>\r\n    <TD>\r\n      <table bgcolor=\"#ffffcc\" id=\"footerTable\" width=\"100%\" border=\"0\" cellpadding=\"2\" cellspacing=\"0\">\r\n        <tr>\r\n          <td style=\"WIDTH: 291px\">Moss China V. 2 Page 175</td>\r\n          <TD align=\"right\">\r\n            <span id=\"ucEfloraSubHeader_lblLinks\"><a target='_top' href='/login.aspx'>Login</a>\n | <A HREF='/index.aspx'  TARGET='_top' >eFloras Home</A> | <A HREF='/help_page.aspx'  TARGET='_top' >Help</A></span></TD>\r\n        </tr>\r\n      </table>\r\n    </TD>\r\n  </tr>\r\n  <tr>\r\n    <td bgcolor=\"#999999\"><img src=\"~/images/layout/dot.gif\" alt=\"\" width=\"100%\" height=\"1\"></td>\r\n  </tr>\r\n</table>\r\n</TD>\r\n      </TR>\r\n      <TR>\r\n        <TD id=\"tdBody\">\r\n          <table id=\"tableBody\" cellSpacing=\"0\" cellPadding=\"0\" width=\"100%\" border=\"0\">\r\n            <tr>\r\n              <td id=\"tdLeftBar\" valign=\"top\" width=\"0\"></td>\r\n\r\n              <td id=\"tdContent\" vAlign=\"top\" width=\"1930\">\r\n                <table width=\"100%\" border=\"0\">\r\n                  <tr>\r\n                    <td vAlign=\"top\">\r\n                      <table id=\"tableTaxonChain\" cellspacing=\"0\" cellpadding=\"1\" width=\"100%\" border=\"0\">\r\n\t<tr>\r\n\t\t<td><span id=\"lblTaxonChain\"><font size=\"2\"><A HREF='flora_page.aspx?flora_id=4'  TARGET='_top' \n\tTITLE='Flora homepage' >Moss China</A> | <A HREF='browse.aspx?flora_id=4'  TARGET='_top' >Family List</A> | <A HREF='volume_page.aspx?volume_id=4002&flora_id=4'  TARGET='_top' >Moss China V. 2</A> | <A HREF='florataxon.aspx?flora_id=4&taxon_id=10727'  TARGET='_top' >Pottiaceae</A> <A HREF='browse.aspx?flora_id=4&start_taxon_id=10727'  TARGET='_top' \n\tTITLE='lower taxa' ><img border='0' src='images/layout/icon-list.gif'></A></font></span></td>\r\n\t</tr>\r\n</table>\r\n\r\n                      <P></P>\r\n                      <div id=\"panelTaxonTreatment\">\r\n\t\r\n                        <span id=\"lblTaxonDesc\"><!-- Default Template -->\r\n12. <b>Gymnostomum</b> Nees & Hornsch., Bryologia Germanica.  1:153.  1823.  \n<p>净口藓属  \r\n<P>\r\n\r\n<P>\r\n\r\n<P>\r\n<p>\r\n<p>\r\n\r\nPlants perennial, small to rather large, in dense tufts, growth by annual renovation at the stem apices. Stems erect, simple, rarely branched; central strand present, weak. Leaves contorted when dry, erect-spreading when moist, oblong-elliptically lanceolate to narrowly lanceolate; margins plane, entire; costa stout, usually ending below the apex; upper leaf cells small, rounded quadrate to rounded hexagonal, densely papillose; basal cells irregularly rectangular, smooth, hyaline or pale yellowish. Dioicous. Perichaetial leaves somewhat sheathing at the base. Setae straight, slender; capsules erect, oblong-ovoid; peristome teeth absent; opercula conic-rostrate, with a long beak, deciduous or persistent with columella. Calyptrae cucullate. Spores yellowish brown, smooth or densely papillose.<p>\r\n\r\n<p>\r\n\r\n<p>\r\n<p>\r\n<p>\r\n\r\n<p>\r\n<p>\r\n<p>\r\n<P>\r\n</span>\r\n                        <P><!-- Key -->\r\n                        <div id=\"panelKey\">\r\n\t\t\r\n                          <BR clear=\"all\">\r\n                          <table id=\"tableKey\" cellspacing=\"0\" cellpadding=\"4\" width=\"100%\" border=\"0\">\r\n\t\t\t<tr bgcolor=\"#d5ffff\">\r\n\t\t\t\t<TD width=\"347\">\r\n                                <P>\r\n                                  <span id=\"lblKeyTitle\"><b><font size=\"2\"></font></b></span></P>\r\n                              </TD>\r\n\t\t\t\t<TD nowrap=\"nowrap\" align=\"right\">\r\n                                <P>\r\n                                  <span id=\"lblKeyEditLink\"><font size=\"1\"></font></span></P>\r\n                              </TD>\r\n\t\t\t</tr>\r\n\t\t\t<tr bgcolor=\"#f1ffff\">\r\n\t\t\t\t<TD colspan=\"2\">\r\n                                <P>\r\n                                  <span id=\"lblKeyDesc\"><font size=\"2\"></font></span></P>\r\n                                <P>\r\n                                  <span id=\"lblKey\"><TABLE  WIDTH='100%' BORDER='0' >\n<TR >\n  <td WIDTH=50 NOWRAP VALIGN=TOP><A NAME='KEY-1-1'>1</A></td>\n  <td WIDTH=400 VALIGN=TOP>Plants less than 10 mm high, blackish yellow-green; leaves oblong-elliptic to nearly ligulate</td>\n  <td >&nbsp;</td>\n  <td VALIGN=TOP NOWRAP>2 <A HREF='florataxon.aspx?flora_id=4&taxon_id=200001164'  TARGET='_top' >Gymnostomum calcareum</A></td>\n</TR>\n<TR >\n  <td WIDTH=50 NOWRAP VALIGN=TOP>+</td>\n  <td WIDTH=400 VALIGN=TOP>Plants 20-60 mm high, bright green; leaves lanceolate to ovate-lanceolate</td>\n  <td >&nbsp;</td>\n  <td VALIGN=TOP NOWRAP><A HREF='#KEY-1-2'>(2)</A></td>\n</TR>\n<TR >\n  <td >&nbsp;</td>\n  <td >&nbsp;</td>\n  <td >&nbsp;</td>\n  <td >&nbsp;</td>\n</TR>\n<TR >\n  <td WIDTH=50 NOWRAP VALIGN=TOP><A NAME='KEY-1-2'>2</A> <A HREF='#KEY-1-1'>(1)</A></td>\n  <td WIDTH=400 VALIGN=TOP>Leaf bases oblong; leaf cells moderately thick-walled, pluripapillose</td>\n  <td >&nbsp;</td>\n  <td VALIGN=TOP NOWRAP>1 <A HREF='florataxon.aspx?flora_id=4&taxon_id=200001162'  TARGET='_top' >Gymnostomum aeruginosum</A></td>\n</TR>\n<TR >\n  <td WIDTH=50 NOWRAP VALIGN=TOP>+</td>\n  <td WIDTH=400 VALIGN=TOP>Leaf bases ovate; leaf cells strongly thick-walled, smooth</td>\n  <td >&nbsp;</td>\n  <td VALIGN=TOP NOWRAP>3 <A HREF='florataxon.aspx?flora_id=4&taxon_id=200001165'  TARGET='_top' >Gymnostomum laxirete</A></td>\n</TR>\n</TABLE>\n</span></P>\r\n                              </TD>\r\n\t\t\t</tr>\r\n\t\t\t<tr bgcolor=\"#d5ffff\">\r\n\t\t\t\t<TD colspan=\"2\">\r\n                                <span id=\"lblKeyList\"><font size=\"2\"></font></span></TD>\r\n\t\t\t</tr>\r\n\t\t</table>\r\n\t\t\r\n                        \r\n\t</div></P> \r\n                        <P>\r\n                          <span id=\"lblLowerTaxonList\"><p>\n<B>Lower Taxa</B><br>\n<ul>\n<li><A HREF='florataxon.aspx?flora_id=4&taxon_id=200001162' \n\tTITLE='Accepted Name' ><b>Gymnostomum</b> <b>aeruginosum</b>  Smith</A><li><A HREF='florataxon.aspx?flora_id=4&taxon_id=200001164' \n\tTITLE='Accepted Name' ><b>Gymnostomum</b> <b>calcareum</b>  Nees & Hornsch.</A><li><A HREF='florataxon.aspx?flora_id=4&taxon_id=200001165' \n\tTITLE='Accepted Name' ><b>Gymnostomum</b> <b>laxirete</b>  (Broth.) P.-C. Chen</A></ul>\n<p>\n</span></P>\r\n                        <BR clear=\"all\">\r\n                        <P>&nbsp;</P>\r\n                        \r\n                        <P></P>\r\n                      \r\n</div>\r\n                      <P><div id=\"panelTaxonLinks\">\r\n\t&nbsp;</P>\r\n                      <P>\r\n                        <table id=\"tableLinkList\" cellspacing=\"0\" cellpadding=\"4