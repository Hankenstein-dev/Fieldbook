  "html": "\r\n<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0 Transitional//EN\" >\r\n<HTML>\r\n  <!--%@ OutputCache Duration=60 VaryByParam=\"flora_id;taxon_id\"  %-->\r\n\r\n<head>\r\n<!-- Google Tag Manager -->\r\n<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\r\nnew Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\r\nj=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\r\n'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\r\n})(window,document,'script','dataLayer','GTM-TGK4SMV');</script>\r\n<!-- End Google Tag Manager -->\r\n<title>Grimmia lisae in Bryophyte Flora of North America @ efloras.org</title>\r\n<link rel=\"stylesheet\" type=\"text/css\" href='/templates/eflora.css' />\r\n<script src=\"JavaScript/eflora.js\" type=\"text/javascript\" ></script>\r\n</head>\r\n\r\n\r\n  <!-- body onload=\"formMOMap.submit()\" -->\r\n  <body>\r\n\r\n    <TABLE id=\"TableMain\" cellSpacing=\"1\" cellPadding=\"1\" width=\"640\" border=\"0\">\r\n      <TR>\r\n        <TD><!--%@ Register TagPrefix=\"ucFlora\" TagName=\"TaxonSearchBox\" Src=\"TaxonSearchBox.ascx\" %-->\r\n\r\n<script language=\"javascript\">\r\n\r\nfunction jsClearTextBox(sender)\r\n{\r\n  // alert(formSearchBox[\"name_str\"].id);\r\n  // alert(sender.value);\r\n  if (sender.value == \"taxon name\")\r\n  {\r\n    sender.value = \"\";\r\n  }\r\n}\r\n\r\n</script>\r\n<table id=\"ucEfloraHeader_tableHeaderWrapper\" cellspacing=\"0\" cellpadding=\"0\" width=\"100%\" border=\"0\">\r\n\t<tr>\r\n\t\t<TD style=\"WIDTH: 479px\"><a id=\"ucEfloraHeader_linkFloraHome\" title=\"Flora Homepage\" href=\"flora_page.aspx?flora_id=50\"><img src=\"images/flora/eflora-logo-50.gif\" id=\"ucEfloraHeader_imageLogo\" border=\"0\" alt=\"Link to Bryophyte Flora of North America home\" /><br>\r\n        </a></TD>\r\n\t\t<TD valign=\"bottom\" align=\"right\">\r\n      <div id=\"ucEfloraHeader_panelSearchBox\">\r\n\t\t\t <!-- begin of search box -->\r\n        <FORM name=\"formSearchBox\" action=\"browse.aspx\" method=\"get\">\r\n          <TABLE borderColor=\"#ccffcc\" cellSpacing=\"0\" cellPadding=\"2\" width=\"200\" border=\"1\">\r\n            <TR>\r\n              <TD>\r\n                <span id=\"ucEfloraHeader_lblSearchBox\"><INPUT TYPE='Hidden' NAME='flora_id' ' id='flora_id' VALUE='50' >\n&nbsp;<input id=name_str name=name_str &nbsp;  value=''  class=small title='Use % as the wildcard\r\n(e.g. pinus % or pinus a%)'  onfocus='jsClearTextBox(this);' accessKey=s size=15> <input class=small type=submit value=Search name=btnSearch><br>\n <input name=chkAllFloras type=checkbox   > <span class=small>All Floras &nbsp; &nbsp; &nbsp;<A HREF='search_page.aspx?flora_id=50'  TARGET='_top'  class='a.link.small'>Advanced Search</A></span>\n</span></TD>\r\n            </TR>\r\n          </TABLE>\r\n        </FORM> <!-- end of search box -->\r\n      \r\n\t\t</div>\r\n    </TD>\r\n\t</tr>\r\n</table>\r\n\r\n</TD>\r\n      </TR>\r\n      <TR>\r\n        <TD id=\"tdSubHeader\">\r\n<table id=\"FooterTableOut\" width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\r\n  <tr>\r\n    <td bgcolor=\"#999999\"><img src=\"~/images/layout/dot.gif\" alt=\"\" width=\"100%\" height=\"1\"></td>\r\n  </tr>\r\n  <tr>\r\n    <TD>\r\n      <table bgcolor=\"#ffffcc\" id=\"footerTable\" width=\"100%\" border=\"0\" cellpadding=\"2\" cellspacing=\"0\">\r\n        <tr>\r\n          <td style=\"WIDTH: 291px\">BFNA Vol. 1</td>\r\n          <TD align=\"right\">\r\n            <span id=\"ucEfloraSubHeader_lblLinks\"><a target='_top' href='/login.aspx'>Login</a>\n | <A HREF='/index.aspx'  TARGET='_top' >eFloras Home</A> | <A HREF='/help_page.aspx'  TARGET='_top' >Help</A></span></TD>\r\n        </tr>\r\n      </table>\r\n    </TD>\r\n  </tr>\r\n  <tr>\r\n    <td bgcolor=\"#999999\"><img src=\"~/images/layout/dot.gif\" alt=\"\" width=\"100%\" height=\"1\"></td>\r\n  </tr>\r\n</table>\r\n</TD>\r\n      </TR>\r\n      <TR>\r\n        <TD id=\"tdBody\">\r\n          <table id=\"tableBody\" cellSpacing=\"0\" cellPadding=\"0\" width=\"100%\" border=\"0\">\r\n            <tr>\r\n              <td id=\"tdLeftBar\" valign=\"top\" width=\"0\"></td>\r\n\r\n              <td id=\"tdContent\" vAlign=\"top\" width=\"1930\">\r\n                <table width=\"100%\" border=\"0\">\r\n                  <tr>\r\n                    <td vAlign=\"top\">\r\n                      <table id=\"tableTaxonChain\" cellspacing=\"0\" cellpadding=\"1\" width=\"100%\" border=\"0\">\r\n\t<tr>\r\n\t\t<td><span id=\"lblTaxonChain\"><font size=\"2\"><A HREF='flora_page.aspx?flora_id=50'  TARGET='_top' \n\tTITLE='Flora homepage' >BFNA</A> | <A HREF='browse.aspx?flora_id=50'  TARGET='_top' >Family List</A> | <A HREF='volume_page.aspx?volume_id=50001&flora_id=50'  TARGET='_top' >BFNA Vol. 1</A> | <A HREF='florataxon.aspx?flora_id=50&taxon_id=10385'  TARGET='_top' >Grimmiaceae</A> <A HREF='browse.aspx?flora_id=50&start_taxon_id=10385'  TARGET='_top' \n\tTITLE='lower taxa' ><img border='0' src='images/layout/icon-list.gif'></A> | <A HREF='florataxon.aspx?flora_id=50&taxon_id=114085'  TARGET='_top' >Grimmia</A> <A HREF='browse.aspx?flora_id=50&start_taxon_id=114085'  TARGET='_top' \n\tTITLE='lower taxa' ><img border='0' src='images/layout/icon-list.gif'></A></font></span></td>\r\n\t</tr>\r\n</table>\r\n\r\n                      <P></P>\r\n                      <div id=\"panelTaxonTreatment\">\r\n\t\r\n                        <span id=\"lblTaxonDesc\"><!-- Default Template -->\r\n<b>Grimmia lisae</b> De Notaris, Musc. Ital. Spic.  15.  1837.   \r\n<P>\r\nAuthors: <A HREF='person_profile.aspx?person_id=8396' \n\tTITLE='Profile page' >Roxanne I. Hastings</A> & <A HREF='person_profile.aspx?person_id=8397' \n\tTITLE='Profile page' >Dr. Henk C. Greven</A>\r\n<P>\r\n\r\n<P>\r\n<p>\r\n<li><A HREF='florataxon.aspx?flora_id=50&taxon_id=242443460' \n\tTITLE='Synonym' ><i>Grimmia</i> <i>ancistrodes</i>  Durieu & Montagne</A><li><A HREF='florataxon.aspx?flora_id=50&taxon_id=242443461' \n\tTITLE='Synonym' ><i>Grimmia</i> <i>arcuatifolia</i>  Kindberg</A><li><A HREF='florataxon.aspx?flora_id=50&taxon_id=242443462' \n\tTITLE='Synonym' ><i>Grimmia</i> <i>californica</i>  Sullivant</A><li><A HREF='florataxon.aspx?flora_id=50&taxon_id=242443463' \n\tTITLE='Synonym' ><i>Grimmia</i> <i>canadensis</i>  Kindberg</A><li><A HREF='florataxon.aspx?flora_id=50&taxon_id=242443464' \n\tTITLE='Synonym' ><i>Grimmia</i> <i>flettii</i>  (Holzinger) Cardot</A><p>\r\n\r\n<b>Plants</b> in dense to loose tufts, olive green, brownish to blackish below. <b>Stems</b> 1--4 cm, central strand present. <b>Stem</b> <b>leaves</b> erect and appressed when dry, recurved to squarrose when moist, broadly lanceolate, tapering to an acute apex, 1.5--2.5 × 0.4--0.6 mm, keeled, margins recurved on one or both sides, awns absent to rather long, stout and denticulate, costa firm, projecting on dorsal side, median layer of stereids present; distal laminal cells 1-stratose with 2-stratose ridges, margins 2-stratose; medial laminal cells rounded-quadrate to oblate, straight, thick-walled; basal juxtacostal laminal cells rectangular, straight, thin or slightly thick-walled; basal marginal laminal cells rectangular, thickened transverse walls. <b>Gemmae</b> in clusters, multicellular, occasionally present in leaf axils. <b>Sexual</b> <b>condition</b> dioicous. <b>Seta</b> arcuate, 3--4.5 mm. <b>Capsule</b> occasionally present, exserted, ovoid, brown, shiny, weakly striate, exothecial cells thin-walled, annulus present, operculum rostrate, peristome teeth orange, fully developed to irregularly cleft at apex, papillose. <b>Calyptra</b> mitrate.<p>\r\n\r\n<p>\r\n\r\n<p>\r\n<p>\r\nDry acidic to basic rock; 100--1000 m; B.C.; Calif., Oreg., Wash.; Mexico; north Africa; Eurasia; Pacific Islands (Hawaii).<p>\r\n\r\n<i>Grimmia</i> <i>lisae</i> is a thermophilous species with a preference for subtropical coastal areas. In North America, it occurs along the west coast, from Vancouver Island south to Mexico. From this region, it has been described frequently as a new species, see synonymy above. <i>Grimmia</i> <i>lisae</i> is closely related to <i>G</i>. <i>trichophylla</i>, differing by somewhat shorter and broader leaves that are straight and appressed when dry and recurved to squarrose when moist, and a reniform costa. Furthermore, it is characterized by a grass-green mid leaf areolation with small, rounded, frequently oblate cells with straight walls.<p>\r\n<p>\r\n<p>\r\n<P>\r\n</span>\r\n                        <P><!-- Key -->\r\n                        </P> \r\n                        <P>\r\n                          <span id=\"lblLowerTaxonList\"></span></P>\r\n                        <BR clear=\"all\">\r\n                        <P>&nbsp;</P>\r\n                        <table id=\"tableObjectList\" cellspacing=\"0\" cellpadding=\"4\" width=\"100%\" border=\"1\">\r\n\t\t<tr bgcolor=\"#ffffcc\">\r\n\t\t\t<TD>\r\n                              <TABLE cellSpacing=\"0\" cellPadding=\"0\" width=\"100%\" border=\"0\">\r\n                                <TR>\r\n                                  <TD>\r\n                                    <span id=\"Label1\"><font size=\"2\">\r\n                                      <b>Related Objects</b>\r\n                                    </font></span></TD>\r\n                                  <TD align=\"right\">\r\n                                    <span id=\"lblGalleryLink\"><font size=\"1\"></font></span>&nbsp;</TD>\r\n                                </TR>\r\n                              </TABLE>\r\n                            </TD>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<TD>\r\n                              <span id=\"lblObjectList\"><p>\n<TABLE  WIDTH='100%' BORDER='0' \n\t cellspacing=0>\n<TR >\n  <td class='bold'>Flora of North America</td>\n  <td >&nbsp;</td>\n</TR>\n<TR >\n  <td width=400><li><A HREF='object_page.aspx?object_id=84925&flora_id=1' \n\tTITLE='Map' >Distribution Map</A></td>\n  <td class='small'>Map</td>\n</TR>\n</TABLE>\n</span></TD>\r\n\t\t</tr>\r\n\t</table>\r\n\t\r\n                        <P></P>\r\n                      \r\n</div>\r\n                      <P><div id=\"panelTaxonLinks\">\r\n\t&nbsp;</P>\r\n                      <P>\r\n                        <table id=\"tableLinkList\" cellspacing=\"0\" cellpadding=\"4\" width=\"100%\" border=\"1\">\r\n\t\t<tr bgcolor=\"#ffffcc\">\r\n\t\t\t<TD><span id=\"lblLinkTitle\"><font size=\"2\"><b>Related Links</b> (opens in a new window)</font></span></TD>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<TD>\r\n                              <P><span id=\"lblLinkList\"><b>Treatments in Other Floras @ www.efloras.org</b><ul>\n<li><A HREF='florataxon.aspx?flora_id=1&taxon_id=242443459'  TARGET='_top' \n\tTITLE='treatment in Flora of North America' >Flora of North America</A></ul>\n<p>\n<b>Other Databases</b>\n<ul>\n\n<li><A HREF='http://mobot.mobot.org/cgi-bin/search_pick?name=Grimmia+lisae'  TARGET='FLORA_LINK' \n\tTITLE='W3TROPICOS' >W<SUP>3</SUP>TROPICOS</A>\n<li><A HREF='http://www.ipni.org/ipni/IpniServlet?family=&infrafamily=&genus=Grimmia&infragenus=&species=lisae&infraspecies=&author_abbrev=&publication_title=&is_apni_record=on&is_gci_record=on&is_ik_record=on&include_authors=on&include_basionym_authors=on&query_type=by_query'  TARGET='FLORA_LINK' \n\tTITLE='IPNI' >IPNI</A></ul>\n</span></P>\r\n                            </TD>\r\n\t\t</tr>\r\n\t</table>\r\n\t\r\n                        \r\n</div></P>\r\n                    </td>\r\n                  </tr>\r\n                  <tr>\r\n                    <td>\r\n                      <!-- Links -->\r\n                      <P></P>\r\n                      <P><span id=\"lblEditLinks\"><font size=\"2\"></font></span></P>\r\n                      <P>\r\n                        <!-- Comment List --></P>\r\n                    </td>\r\n                  </tr>\r\n                </table>\r\n              </td>\r\n              <TD id=\"tdRightBar\" valign=\"top\"></TD>\r\n\r\n            </tr>\r\n          </table>\r\n        </TD>\r\n      <tr>\r\n        <td>\r\n<table id=\"SubHeaderTableOut\" width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\r\n  <tr>\r\n    <td bgcolor=\"#999999\"><img src=\"~/images/layout/dot.gif\" alt=\"\" width=\"100%\" height=\"1\"></td>\r\n  </tr>\r\n  <tr>\r\n    <TD>\r\n      <table bgcolor=\"#99cc99\" id=\"SubHeaderTable\" width=\"100%\" border=\"0\" cellpadding=\"2\" cellspacing=\"0\">\r\n        <tr>\r\n          <TD align=\"center\" bgColor=\"#ffffcc\">\r\n            &nbsp;|&nbsp;\r\n            <a id=\"ucEfloraFooter_linkHome\" href=\"index.aspx\" target=\"_top\">eFlora Home</a>&nbsp;|&nbsp;\r\n            <a id=\"ucEfloraFooter_linkPeopleSearch\" href=\"person_search.aspx\" target=\"_top\">People Search</a>\r\n            &nbsp;|&nbsp;\r\n            <a id=\"ucEfloraFooter_linkHelp\" href=\"help_page.aspx\" target=\"_top\">Help</a>\r\n            &nbsp;|&nbsp;\r\n            <a id=\"ucEfloraFooter_linkActKey\" href=\"http://flora.huh.harvard.edu/china/ActKey\" target=\"_top\">ActKey</a>\r\n            &nbsp;|&nbsp;\r\n            <a id=\"ucEfloraFooter_Hyperlink2\" href=\"http://flora.huh.harvard.edu/HuCards/\" target=\"_top\">Hu Cards</a>\r\n            &nbsp;|&nbsp;\r\n            <a id=\"ucEfloraFooter_Hyperlink1\" href=\"glossary.aspx\" target=\"_top\">Glossary</a>\r\n            &nbsp;|&nbsp;\r\n          </TD>\r\n        </tr>\r\n      </table>\r\n    </TD>\r\n  </tr>\r\n  <tr>\r\n    <td bgcolor=\"#999999\"><img src=\"~/images/layout/dot.gif\" alt=\"\" width=\"100%\" height=\"1\"></td>\r\n  </tr>\r\n</table>\r\n<p></p>\r\n\r\n</td>\r\n      </tr>\r\n    </TABLE>\r\n  <a href=\"/url.html\" style='display:none'>login</a></body>\r\n</HTML>\r\n",
