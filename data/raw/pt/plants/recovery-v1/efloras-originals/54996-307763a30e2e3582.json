ox -->\r\n        <FORM name=\"formSearchBox\" action=\"browse.aspx\" method=\"get\">\r\n          <TABLE borderColor=\"#ccffcc\" cellSpacing=\"0\" cellPadding=\"2\" width=\"200\" border=\"1\">\r\n            <TR>\r\n              <TD>\r\n                <span id=\"ucEfloraHeader_lblSearchBox\"><INPUT TYPE='Hidden' NAME='flora_id' ' id='flora_id' VALUE='201' >\n&nbsp;<input id=name_str name=name_str &nbsp;  value=''  class=small title='Use % as the wildcard\r\n(e.g. pinus % or pinus a%)'  onfocus='jsClearTextBox(this);' accessKey=s size=15> <input class=small type=submit value=Search name=btnSearch><br>\n <input name=chkAllFloras type=checkbox   > <span class=small>All Floras &nbsp; &nbsp; &nbsp;<A HREF='search_page.aspx?flora_id=201'  TARGET='_top'  class='a.link.small'>Advanced Search</A></span>\n</span></TD>\r\n            </TR>\r\n          </TABLE>\r\n        </FORM> <!-- end of search box -->\r\n      \r\n\t\t</div>\r\n    </TD>\r\n\t</tr>\r\n</table>\r\n\r\n</TD>\r\n      </TR>\r\n      <TR>\r\n        <TD id=\"tdSubHeader\">\r\n<table id=\"FooterTableOut\" width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\r\n  <tr>\r\n    <td bgcolor=\"#999999\"><img src=\"~/images/layout/dot.gif\" alt=\"\" width=\"100%\" height=\"1\"></td>\r\n  </tr>\r\n  <tr>\r\n    <TD>\r\n      <table bgcolor=\"#ffffcc\" id=\"footerTable\" width=\"100%\" border=\"0\" cellpadding=\"2\" cellspacing=\"0\">\r\n        <tr>\r\n          <td style=\"WIDTH: 291px\">Andes Trees</td>\r\n          <TD align=\"right\">\r\n            <span id=\"ucEfloraSubHeader_lblLinks\"><a target='_top' href='/login.aspx'>Login</a>\n | <A HREF='/index.aspx'  TARGET='_top' >eFloras Home</A> | <A HREF='/help_page.aspx'  TARGET='_top' >Help</A></span></TD>\r\n        </tr>\r\n      </table>\r\n    </TD>\r\n  </tr>\r\n  <tr>\r\n    <td bgcolor=\"#999999\"><img src=\"~/images/layout/dot.gif\" alt=\"\" width=\"100%\" height=\"1\"></td>\r\n  </tr>\r\n</table>\r\n</TD>\r\n      </TR>\r\n      <TR>\r\n        <TD id=\"tdBody\">\r\n          <table id=\"tableBody\" cellSpacing=\"0\" cellPadding=\"0\" width=\"100%\" border=\"0\">\r\n            <tr>\r\n              <td id=\"tdLeftBar\" valign=\"top\" width=\"0\"></td>\r\n\r\n              <td id=\"tdContent\" vAlign=\"top\" width=\"1930\">\r\n                <table width=\"100%\" border=\"0\">\r\n                  <tr>\r\n                    <td vAlign=\"top\">\r\n                      <table id=\"tableTaxonChain\" cellspacing=\"0\" cellpadding=\"1\" width=\"100%\" border=\"0\">\r\n\t<tr>\r\n\t\t<td><span id=\"lblTaxonChain\"><font size=\"2\"><A HREF='flora_page.aspx?flora_id=201'  TARGET='_top' \n\tTITLE='Flora homepage' >Andes Trees</A> | <A HREF='browse.aspx?flora_id=201'  TARGET='_top' >Family List</A> | <A HREF='florataxon.aspx?flora_id=201&taxon_id=10534'  TARGET='_top' >Malvaceae</A> <A HREF='browse.aspx?flora_id=201&start_taxon_id=10534'  TARGET='_top' \n\tTITLE='lower taxa' ><img border='0' src='images/layout/icon-list.gif'></A></font></span></td>\r\n\t</tr>\r\n</table>\r\n\r\n                      <P></P>\r\n                      <div id=\"panelTaxonTreatment\">\r\n\t\r\n                        <span id=\"lblTaxonDesc\"><!-- Default Template -->\r\n3. <b>Sida</b> L. \r\n<P>\r\n\r\n<P>\r\n\r\n<P>\r\n<p>\r\n<p>\r\n\r\nHierbas o pequeños arbustos. Hojas dentadas o lobuladas. Flores solitarias, axilares, amarillas, blancas o anaranjadas; cáliz fusionado, 5-lobulado, con una costilla en cada sutura de los lóbulos y en la mitad de cada sépalo; 5 pétalos; columna de estambres más corta que los pétalos y dividida en el ápice en numerosos filamentos; 5–8 carpelos unidos e igual número de estilos, estigmas secos. Cápsula.<p>\r\n\r\nEl género Sida consta de 150 especies distribuidas en regiones tropicales y templadas, especialmente en América. En el Ecuador están representadas 15 especies; 2 especies arbustivas,  Sida cordifolia L. y S. rhombifolia L., se conocen sobre los 2400 m de altitud.<p>\r\n\r\n<p>\r\n<p>\r\n<p>\r\n\r\n<p>\r\n<p>\r\nReferencia:\n<br>Kearney, T. B. 1958. A tentative key to the South American species of Sida. Leafl. W. Bot. 11: 249–270.<p>\r\n<P>\r\n</span>\r\n                        <P><!-- Key -->\r\n                        </P> \r\n                        <P>\r\n                          <span id=\"lblLowerTaxonList\"></span></P>\r\n                        <BR clear=\"all\">\r\n                        <P>&nbsp;</P>\r\n                        <table id=\"tableObjectList\" cellspacing=\"0\" cellpadding=\"4\" width=\"100%\" border=\"1\">\r\n\t\t<tr bgcolor=\"#ffffcc\">\r\n\t\t\t<TD>\r\n                              <TABLE cellSpacing=\"0\" cellPadding=\"0\" width=\"100%\" border=\"0\">\r\n                                <TR>\r\n                                  <TD>\r\n                                    <span id=\"Label1\"><font size=\"2\">\r\n                                      <b>Related Objects</b>\r\n                                    </font></span></TD>\r\n                                  <TD align=\"right\">\r\n                                    <span id=\"lblGalleryLink\"><font size=\"1\"></font></span>&nbsp;</TD>\r\n                                </TR>\r\n                              </TABLE>\r\n                            </TD>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<TD>\r\n                              <span id=\"lblObjectList\"><p>\n<TABLE  WIDTH='100%' BORDER='0' \n\t cellspacing=0>\n<TR >\n  <td class='bold'>Flora of Chile</td>\n  <td >&nbsp;</td>\n</TR>\n<TR >\n  <td width=400><li><A HREF='https://images.mobot.org/efloras/FloraData/060/PDF/V01/Volume1-Part2_Sida.pdf' \n\tTITLE='PDF' >PDF</A></td>\n  <td class='small'>PDF</td>\n</TR>\n<TR >\n  <td class='bold'>Flora of China</td>\n  <td >&nbsp;</td>\n</TR>\n<TR >\n  <td width=400><li><A HREF='http://flora.huh.harvard.edu/china//PDF/PDF12/Sida.pdf' \n\tTITLE='PDF' >Sida.pdf</A></td>\n  <td class='small'>PDF</td>\n</TR>\n</TABLE>\n</span></TD>\r\n\t\t</tr>\r\n\t</table>\r\n\t\r\n               