  "html": "\r\n<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0 Transitional//EN\" >\r\n<HTML>\r\n  <!--%@ OutputCache Duration=60 VaryByParam=\"flora_id;taxon_id\"  %-->\r\n\r\n<head>\r\n<!-- Google Tag Manager -->\r\n<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\r\nnew Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\r\nj=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\r\n'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\r\n})(window,document,'script','dataLayer','GTM-TGK4SMV');</script>\r\n<!-- End Google Tag Manager -->\r\n<title>Zygodon in Flora of North America @ efloras.org</title>\r\n<link rel=\"stylesheet\" type=\"text/css\" href='/templates/eflora.css' />\r\n<script src=\"JavaScript/eflora.js\" type=\"text/javascript\" ></script>\r\n</head>\r\n\r\n\r\n  <!-- body onload=\"formMOMap.submit()\" -->\r\n  <body>\r\n\r\n    <TABLE id=\"TableMain\" cellSpacing=\"1\" cellPadding=\"1\" width=\"640\" border=\"0\">\r\n      <TR>\r\n        <TD><!--%@ Register TagPrefix=\"ucFlora\" TagName=\"TaxonSearchBox\" Src=\"TaxonSearchBox.ascx\" %-->\r\n\r\n<script language=\"javascript\">\r\n\r\nfunction jsClearTextBox(sender)\r\n{\r\n  // alert(formSearchBox[\"name_str\"].id);\r\n  // alert(sender.value);\r\n  if (sender.value == \"taxon name\")\r\n  {\r\n    sender.value = \"\";\r\n  }\r\n}\r\n\r\n</script>\r\n<table id=\"ucEfloraHeader_tableHeaderWrapper\" cellspacing=\"0\" cellpadding=\"0\" width=\"100%\" border=\"0\">\r\n\t<tr>\r\n\t\t<TD style=\"WIDTH: 479px\"><a id=\"ucEfloraHeader_linkFloraHome\" title=\"Flora Homepage\" href=\"flora_page.aspx?flora_id=1\"><img src=\"images/flora/eflora-logo-1.gif\" id=\"ucEfloraHeader_imageLogo\" border=\"0\" alt=\"Link to Flora of North America home\" /><br>\r\n        </a></TD>\r\n\t\t<TD valign=\"bottom\" align=\"right\">\r\n      <div id=\"ucEfloraHeader_panelSearchBox\">\r\n\t\t\t <!-- begin of search box -->\r\n        <FORM name=\"formSearchBox\" action=\"browse.aspx\" method=\"get\">\r\n          <TABLE borderColor=\"#ccffcc\" cellSpacing=\"0\" cellPadding=\"2\" width=\"200\" border=\"1\">\r\n            <TR>\r\n              <TD>\r\n                <span id=\"ucEfloraHeader_lblSearchBox\"><INPUT TYPE='Hidden' NAME='flora_id' ' id='flora_id' VALUE='1' >\n&nbsp;<input id=name_str name=name_str &nbsp;  value=''  class=small title='Use % as the wildcard\r\n(e.g. pinus % or pinus a%)'  onfocus='jsClearTextBox(this);' accessKey=s size=15> <input class=small type=submit value=Search name=btnSearch><br>\n <input name=chkAllFloras type=checkbox   > <span class=small>All Floras &nbsp; &nbsp; &nbsp;<A HREF='search_page.aspx?flora_id=1'  TARGET='_top'  class='a.link.small'>Advanced Search</A></span>\n</span></TD>\r\n            </TR>\r\n          </TABLE>\r\n        </FORM> <!-- end of search box -->\r\n      \r\n\t\t</div>\r\n    </TD>\r\n\t</tr>\r\n</table>\r\n\r\n</TD>\r\n      </TR>\r\n      <TR>\r\n        <TD id=\"tdSubHeader\">\r\n<table id=\"FooterTableOut\" width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\r\n  <tr>\r\n    <td bgcolor=\"#999999\"><img src=\"~/images/layout/dot.gif\" alt=\"\" width=\"100%\" height=\"1\"></td>\r\n  </tr>\r\n  <tr>\r\n    <TD>\r\n      <table bgcolor=\"#ffffcc\" id=\"footerTable\" width=\"100%\" border=\"0\" cellpadding=\"2\" cellspacing=\"0\">\r\n        <tr>\r\n          <td style=\"WIDTH: 291px\">FNA Vol. 28 Page 78</td>\r\n          <TD align=\"right\">\r\n            <span id=\"ucEfloraSubHeader_lblLinks\"><a target='_top' href='/login.aspx'>Login</a>\n | <A HREF='/index.aspx'  TARGET='_top' >eFloras Home</A> | <A HREF='/help_page.aspx'  TARGET='_top' >Help</A></span></TD>\r\n        </tr>\r\n      </table>\r\n    </TD>\r\n  </tr>\r\n  <tr>\r\n    <td bgcolor=\"#999999\"><img src=\"~/images/layout/dot.gif\" alt=\"\" width=\"100%\" height=\"1\"></td>\r\n  </tr>\r\n</table>\r\n</TD>\r\n      </TR>\r\n      <TR>\r\n        <TD id=\"tdBody\">\r\n          <table id=\"tableBody\" cellSpacing=\"0\" cellPadding=\"0\" width=\"100%\" border=\"0\">\r\n            <tr>\r\n              <td id=\"tdLeftBar\" valign=\"top\" width=\"0\"></td>\r\n\r\n              <td id=\"tdContent\" vAlign=\"top\" width=\"1930\">\r\n                <table width=\"100%\" border=\"0\">\r\n                  <tr>\r\n                    <td vAlign=\"top\">\r\n                      <table id=\"tableTaxonChain\" cellspacing=\"0\" cellpadding=\"1\" width=\"100%\" border=\"0\">\r\n\t<tr>\r\n\t\t<td><span id=\"lblTaxonChain\"><font size=\"2\"><A HREF='flora_page.aspx?flora_id=1'  TARGET='_top' \n\tTITLE='Flora homepage' >FNA</A> | <A HREF='browse.aspx?flora_id=1'  TARGET='_top' >Family List</A> | <A HREF='volume_page.aspx?volume_id=1028&flora_id=1'  TARGET='_top' >FNA Vol. 28</A> | <A HREF='florataxon.aspx?flora_id=1&taxon_id=10640'  TARGET='_top' >Orthotrichaceae</A> <A HREF='browse.aspx?flora_id=1&start_taxon_id=10640'  TARGET='_top' \n\tTITLE='lower taxa' ><img border='0' src='images/layout/icon-list.gif'></A></font></span></td>\r\n\t</tr>\r\n</table>\r\n\r\n                      <P></P>\r\n                      <div id=\"panelTaxonTreatment\">\r\n\t\r\n                        <span id=\"lblTaxonDesc\"><!-- FNA Template -->\r\n9. <b>Zygodon</b> Hooker & Taylor, Muscol. Brit.  70, plates 3 [upper left], 21 [upper left].  1818.   \r\n<P>\r\n\r\n<P>\r\n\r\n<P>\r\n<p>\r\n<p>\r\n\r\n<b>Plants</b> small, in tufts or loose cushions. <b>Stems</b> erect to ascending, branches erect to ascending. <b>Leaves</b> loosely erect, irregularly twisted or curved around stem, sometimes undulate when dry, erect-spreading to squarrose-recurved when moist, oblong-lanceolate to linear-lanceolate, not rugose; base decurrent; margins entire, serrate or serrulate near apex; apex acute, usually apiculate; costa percurrent, ending near apex, or rarely excurrent; basal laminal cells subquadrate to rectangular; distal cells rounded-quadrate to rounded-hexagonal, 4-14 µm, smooth or densely multipapillose only over lumina, papillae 2-6 per cell, clavate; marginal cells not differentiated from basal. <b>Sexual condition</b> dioicous, autoicous, or synoicous; perichaetial leaves little different from stem leaves. <b>Seta</b> 3-13 mm. <b>Capsule</b> long-exserted, elliptic-oblong to fusiform, strongly 8-ribbed entire length, not constricted below mouth; stomata superficial; peristome double, single, or absent; exostome teeth 8, or 16 partially connate in 8 pairs, papillose; endostome segments 0, 8, or 16. <b>Calyptra</b> cucullate, conic, smooth, naked or rarely hairy, not plicate, covering distal portion of capsule. <b>Spores</b> isosporous.<p>\r\nSpecies ca. 90 (5 in the flora): North America, Mexico, West Indies, Central America, South America, Europe, Asia, Africa, Pacific Islands (New Zealand), Australia.<p>\r\n\r\n<p>\r\n<p>\r\n<p>\r\n\r\nMany species of <i>Zygodon</i> rarely produce sporophytes, and taxa are delimited on characters derived exclusively from the gametophyte. The genus is largely pantropical with several widespread temperate species. None of the species are found farther north than 60± Nlatitude. The leaves are keeled; the basal laminal cells are usually pale yellow; the capsules are 1-2 mm; and the spores are 11-22 µm.<p><p><p>\r\n<p>\r\n<p>\r\n<P>\r\n</span>\r\n                        <P><!-- Key -->\r\n                        <div id=\"panelKey\">\r\n\t\t\r\n                          <BR clear=\"all\">\r\n                          <table id=\"tableKey\" cellspacing=\"0\" cellpadding=\"4\" width=\"100%\" border=\"0\">\r\n\t\t\t<tr bgcolor=\"#d5ffff\">\r\n\t\t\t\t<TD width=\"347\">\r\n                                <P>\r\n                                  <span id=\"lblKeyTitle\"><b><font size=\"2\"></font></b></span></P>\r\n                              </TD>\r\n\t\t\t\t<TD nowrap=\"nowrap\" align=\"right\">\r\n                                <P>\r\n                                  <span id=\"lblKeyEditLink\"><font size=\"1\"></font></span></P>\r\n                              </TD>\r\n\t\t\t</tr>\r\n\t\t\t<tr bgcolor=\"#f1ffff\">\r\n\t\t\t\t<TD colspan=\"2\">\r\n                                <P>\r\n                                  <span id=\"lblKeyDesc\"><font size=\"2\"></font></span></P>\r\n                                <P>\r\n                                  <span id=\"lblKey\"><TABLE  WIDTH='100%' BORDER='0' >\n<TR >\n  <td WIDTH=50 NOWRAP VALIGN=TOP><A NAME='KEY-1-1'>1</A></td>\n  <td WIDTH=400 VALIGN=TOP>Distal laminal cells smooth.</td>\n  <td >&nbsp;</td>\n  <td VALIGN=TOP NOWRAP>3 <A HREF='florataxon.aspx?flora_id=1&taxon_id=250062041'  TARGET='_top' ><i>Zygodon menziesii</i></A></td>\n</TR>\n<TR >\n  <td WIDTH=50 NOWRAP VALIGN=TOP>+</td>\n  <td WIDTH=400 VALIGN=TOP>Distal laminal cells papillose</td>\n  <td >&nbsp;</td>\n  <td VALIGN=TOP NOWRAP><A HREF='#KEY-1-2'>(2)</A></td>\n</TR>\n<TR >\n  <td >&nbsp;</td>\n  <td >&nbsp;</td>\n  <td >&nbsp;</td>\n  <td >&nbsp;</td>\n</TR>\n<TR >\n  <td WIDTH=50 NOWRAP VALIGN=TOP><A NAME='KEY-1-2'>2</A> <A HREF='#KEY-1-1'>(1)</A></td>\n  <td WIDTH=400 VALIGN=TOP>Leaves wide-spreading to squarrose-recurved when moist; apices bluntly acute, apiculus absent; distal laminal cells 4-9 µm, walls very thick; gemmae absent.</td>\n  <td >&nbsp;</td>\n  <td VALIGN=TOP NOWRAP>2 <A HREF='florataxon.aspx?flora_id=1&taxon_id=250062040'  TARGET='_top' ><i>Zygodon gracilis</i></A></td>\n</TR>\n<TR >\n  <td WIDTH=50 NOWRAP VALIGN=TOP>+</td>\n  <td WIDTH=400 VALIGN=TOP>Leaves spreading, ± recurved or rarely subsquarrose when moist; apices sharply acute, apiculus present; distal laminal cells 5-14 µm, walls somewhat thick; gemmae present</td>\n  <td >&nbsp;</td>\n  <td VALIGN=TOP NOWRAP><A HREF='#KEY-1-3'>(3)</A></td>\n</TR>\n<TR >\n  <td >&nbsp;</td>\n  <td >&nbsp;</td>\n  <td >&nbsp;</td>\n  <td >&nbsp;</td>\n</TR>\n<TR >\n  <td WIDTH=50 NOWRAP VALIGN=TOP><A NAME='KEY-1-3'>3</A> <A HREF='#KEY-1-2'>(2)</A></td>\n  <td WIDTH=400 VALIGN=TOP>Costal abaxial surface smooth or covered by cells only at apex; sexual condition synoicous or autoicous.</td>\n  <td >&nbsp;</td>\n  <td VALIGN=TOP NOWRAP>4 <A HREF='florataxon.aspx?flora_id=1&taxon_id=200001677'  TARGET='_top' ><i>Zygodon reinwardtii</i></A></td>\n</TR>\n<TR >\n  <td WIDTH=50 NOWRAP VALIGN=TOP>+</td>\n  <td WIDTH=400 VALIGN=TOP>Costal abaxial surface covered by cells distally; sexual condition dioicous</td>\n  <td >&nbsp;</td>\n  <td VALIGN=TOP NOWRAP><A HREF='#KEY-1-4'>(4)</A></td>\n</TR>\n<TR >\n  <td >&nbsp;</td>\n  <td >&nbsp;</td>\n  <td >&nbsp;</td>\n  <td >&nbsp;</td>\n</TR>\n<TR >\n  <td WIDTH=50 NOWRAP VALIGN=TOP><A NAME='KEY-1-4'>4</A> <A HREF='#KEY-1-3'>(3)</A></td>\n  <td WIDTH=400 VALIGN=TOP>Gemmae cylindric to fusiform, longitudinal walls absent; distal laminal cells 9-14 µm.</td>\n  <td >&nbsp;</td>\n  <td VALIGN=TOP NOWRAP>1 <A HREF='florataxon.aspx?flora_id=1&taxon_id=200001675'  TARGET='_top' ><i>Zygodon conoideus</i></A></td>\n</TR>\n<TR >\n  <td WIDTH=50 NOWRAP VALIGN=TOP>+</td>\n  <td WIDTH=400 VALIGN=TOP>Gemmae clavate, elliptic, or subcylindric, longitudinal walls present or absent; distal laminal cells 7-11 µm.</td>\n  <td >&nbsp;</td>\n  <td VALIGN=TOP NOWRAP>5 <A HREF='florataxon.aspx?flora_id=1&taxon_id=250062046'  TARGET='_top' ><i>Zygodon viridissimus</i></A></td>\n</TR>\n</TABLE>\n</span></P>\r\n                              </TD>\r\n\t\t\t</tr>\r\n\t\t\t<tr bgcolor=\"#d5ffff\">\r\n\t\t\t\t<TD colspan=\"2\">\r\n                                <span id=\"lblKeyList\"><font size=\"2\"></font></span></TD>\r\n\t\t\t</tr>\r\n\t\t</table>\r\n\t\t\r\n                        \r\n\t</div></P> \r\n                        <P>\r\n                          <span id=\"lblLowerTaxonList\"><p>\n<B>Lower Taxa</B><br>\n<ul>\n<li><A HREF='florataxon.aspx?flora_id=1&taxon_id=200001675' \n\tTITLE='Accepted Name' ><b>Zygodon</b> <b>conoideus</b>  (Dickson) Hooker & Taylor</A><li><A HREF='florataxon.aspx?flora_id=1&taxon_id=250062040' \n\tTITLE='Accepted Name' ><b>Zygodon</b> <b>gracilis</b>  Wilson</A><li><A HREF='florataxon.aspx?flora_id=1&taxon_id=250062041' \n\tTITLE='Accepted Name' ><b>Zygodon</b> <b>menziesii</b>  (Schwagrichen) Arnott</A><li><A HREF='florataxon.aspx?flora_id=1&taxon_id=200001677' \n\tTITLE='Accepted Name' ><b>Zygodon</b> <b>reinwardtii</b>  (Hornschuch) A. Braun</A><li><A HREF='florataxon.aspx?flora_id=1&taxon_id=250062046' \n\tTITLE='Accepted Name' ><b>Zygodon</b> <b>viridissimus</b>  (Dickson) Bridel</A><li><A HREF='florataxon.aspx?flora_id=1&taxon_id=250062050' \n\tTITLE='Accepted Name' ><b>Zygodon</b> <b>viridissimus</b> var. <b>dentatus</b>  Limpricht</A><li><A HREF='florataxon.aspx?flora_id=1&taxon_id=250062052' \n\tTITLE='Accepted Name' ><b>Zygodon</b> <b>viridissimus</b> var. <b>rupestris</b>  Lindberg</A><li><A HREF='florataxon.aspx?flora_id=1&taxon_id=250062053' \n\tTITLE='Accepted Name' ><b>Zygodon</b> <b>viridissimus</b> var. <b>viridissimus</b>  </A></ul>\n<p>\n</span></P>\r\n                        <BR clear=\"all\">\r\n                        <P>&nbsp;</P>\r\n                        <table id=\"tableObjectList\" cellspacing=\"0\" cellpadding=\"4\" width=\"100%\" border=\"1\">\r\n\t\t<tr bgcolor=\"#ffffcc\">\r\n\t\t\t<TD>\r\n                              <TABLE cellSpacing=\"0\" cellPadding=\"0\" width=\"100%\" border=\"0\">\r\n                                <TR>\r\n                                  <TD>\r\n                                    <span id=\"Label1\"><font size=\"2\">\r\n                                      <b>Related Objects</b>\r\n                                    </font></span></TD>\r\n                                  <TD align=\"right\">\r\n                                    <span id=\"lblGalleryLink\"><font size=\"1\"><A HREF='image_list.aspx?flora_id=1&taxon_id=135394'  TARGET='_top' >Image Gallery</A></font></span>&nbsp;</TD>\r\n                                </TR>\r\n                              </TABLE>\r\n                            </TD>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<TD>\r\n                              <span id=\"lblObjectList\"><TABLE  WIDTH='100%' BORDER='0' \n\t cellspacing=0>\n<TR >\n  <td width=400><li><A HREF='object_page.aspx?object_id=126021&flora_id=1' \n\tTITLE='Illustration' >Illustration</A></td>\n  <td class='small'>Illustration</td>\n</TR>\n<TR >\n  <td width=400><li><A HREF='object_page.aspx?object_id=126035&flora_id=1' \n\tTITLE='Illustration' >Illustration</A></td>\n  <td class='small'>Illustration</td>\n</TR>\n</TABLE>\n</span></TD>\r\n\t\t</tr>\r\n\t</table>\r\n\t\r\n                        <P></P>\r\n                      \r\n</div>\r\n                      <P><div id=\"panelTaxonLinks\">\r\n\t&nbsp;</P>\r\n                      <P>\r\n                        <table id=\"tableLinkList\" cellspacing=\"0\" cellpadding=\"4\" width=\"100%\" border=\"1\">\r\n\t\t<tr bgcolor=\"#ffffcc\">\r\n\t\t\t<TD><span id=\"lblLinkTitle\"><font size=\"2\"><b>Related Links</b> (opens in a new window)</font></span></TD>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<TD>\r\n                              <P><span id=\"lblLinkList\"><b>Treatments in Other Floras @ www.efloras.org</b><ul>\n<li><A HREF='florataxon.aspx?flora_id=3&taxon_id=135394'  TARGET='_top' \n\tTITLE='treatment in Chinese Plant Names' >Chinese Plant Names</A></ul>\n<p>\n<b>Other Databases</b>\n<ul>\n\n<li><A HREF='http://mobot.mobot.org/cgi-bin/search_pick?name=Zygodon'  TARGET='FLORA_LINK' \n\tTITLE='W3TROPICOS' >W<SUP>3</SUP>TROPICOS</A>\n<li><A HREF='http://www.ipni.org/ipni/IpniServlet?family=&infrafamily=&genus=Zygodon&infragenus=&species=&infraspecies=&author_abbrev=&publication_title=&is_apni_record=on&is_gci_record=on&is_ik_record=on&include_authors=on&include_basionym_authors=on&query_type=by_query'  TARGET='FLORA_LINK' \n\tTITLE='IPNI' >IPNI</A>\n<li><A HREF='http://ravenel.si.edu/botany/ing//INGsearch.cfm?searchWord=Zygodon'  TARGET='FLORA_LINK' \n\tTITLE='ING' >ING Genus Search</A></ul>\n</span></P>\r\n                           