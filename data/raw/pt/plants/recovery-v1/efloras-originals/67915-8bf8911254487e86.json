  "html": "\r\n<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0 Transitional//EN\" >\r\n<HTML>\r\n  <!--%@ OutputCache Duration=60 VaryByParam=\"flora_id;taxon_id\"  %-->\r\n\r\n<head>\r\n<!-- Google Tag Manager -->\r\n<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\r\nnew Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\r\nj=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\r\n'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\r\n})(window,document,'script','dataLayer','GTM-TGK4SMV');</script>\r\n<!-- End Google Tag Manager -->\r\n<title>Syntrichia princeps in Moss Flora of China @ efloras.org</title>\r\n<link rel=\"stylesheet\" type=\"text/css\" href='/templates/eflora.css' />\r\n<script src=\"JavaScript/eflora.js\" type=\"text/javascript\" ></script>\r\n</head>\r\n\r\n\r\n  <!-- body onload=\"formMOMap.submit()\" -->\r\n  <body>\r\n\r\n    <TABLE id=\"TableMain\" cellSpacing=\"1\" cellPadding=\"1\" width=\"640\" border=\"0\">\r\n      <TR>\r\n        <TD><!--%@ Register TagPrefix=\"ucFlora\" TagName=\"TaxonSearchBox\" Src=\"TaxonSearchBox.ascx\" %-->\r\n\r\n<script language=\"javascript\">\r\n\r\nfunction jsClearTextBox(sender)\r\n{\r\n  // alert(formSearchBox[\"name_str\"].id);\r\n  // alert(sender.value);\r\n  if (sender.value == \"taxon name\")\r\n  {\r\n    sender.value = \"\";\r\n  }\r\n}\r\n\r\n</script>\r\n<table id=\"ucEfloraHeader_tableHeaderWrapper\" cellspacing=\"0\" cellpadding=\"0\" width=\"100%\" border=\"0\">\r\n\t<tr>\r\n\t\t<TD style=\"WIDTH: 479px\"><a id=\"ucEfloraHeader_linkFloraHome\" title=\"Flora Homepage\" href=\"flora_page.aspx?flora_id=4\"><img src=\"images/flora/eflora-logo-4.gif\" id=\"ucEfloraHeader_imageLogo\" border=\"0\" alt=\"Link to Moss Flora of China home\" /><br>\r\n        </a></TD>\r\n\t\t<TD valign=\"bottom\" align=\"right\">\r\n      <div id=\"ucEfloraHeader_panelSearchBox\">\r\n\t\t\t <!-- begin of search box -->\r\n        <FORM name=\"formSearchBox\" action=\"browse.aspx\" method=\"get\">\r\n          <TABLE borderColor=\"#ccffcc\" cellSpacing=\"0\" cellPadding=\"2\" width=\"200\" border=\"1\">\r\n            <TR>\r\n              <TD>\r\n                <span id=\"ucEfloraHeader_lblSearchBox\"><INPUT TYPE='Hidden' NAME='flora_id' ' id='flora_id' VALUE='4' >\n&nbsp;<input id=name_str name=name_str &nbsp;  value=''  class=small title='Use % as the wildcard\r\n(e.g. pinus % or pinus a%)'  onfocus='jsClearTextBox(this);' accessKey=s size=15> <input class=small type=submit value=Search name=btnSearch><br>\n <input name=chkAllFloras type=checkbox   > <span class=small>All Floras &nbsp; &nbsp; &nbsp;<A HREF='search_page.aspx?flora_id=4'  TARGET='_top'  class='a.link.small'>Advanced Search</A></span>\n</span></TD>\r\n            </TR>\r\n          </TABLE>\r\n        </FORM> <!-- end of search box -->\r\n      \r\n\t\t</div>\r\n    </TD>\r\n\t</tr>\r\n</table>\r\n\r\n</TD>\r\n      </TR>\r\n      <TR>\r\n        <TD id=\"tdSubHeader\">\r\n<table id=\"FooterTableOut\" width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\r\n  <tr>\r\n    <td bgcolor=\"#999999\"><img src=\"~/images/layout/dot.gif\" alt=\"\" width=\"100%\" height=\"1\"></td>\r\n  </tr>\r\n  <tr>\r\n    <TD>\r\n      <table bgcolor=\"#ffffcc\" id=\"footerTable\" width=\"100%\" border=\"0\" cellpadding=\"2\" cellspacing=\"0\">\r\n        <tr>\r\n          <td style=\"WIDTH: 291px\">Moss China V. 2 Page 220</td>\r\n          <TD align=\"right\">\r\n            <span id=\"ucEfloraSubHeader_lblLinks\"><a target='_top' href='/login.aspx'>Login</a>\n | <A HREF='/index.aspx'  TARGET='_top' >eFloras Home</A> | <A HREF='/help_page.aspx'  TARGET='_top' >Help</A></span></TD>\r\n        </tr>\r\n      </table>\r\n    </TD>\r\n  </tr>\r\n  <tr>\r\n    <td bgcolor=\"#999999\"><img src=\"~/images/layout/dot.gif\" alt=\"\" width=\"100%\" height=\"1\"></td>\r\n  </tr>\r\n</table>\r\n</TD>\r\n      </TR>\r\n      <TR>\r\n        <TD id=\"tdBody\">\r\n          <table id=\"tableBody\" cellSpacing=\"0\" cellPadding=\"0\" width=\"100%\" border=\"0\">\r\n            <tr>\r\n              <td id=\"tdLeftBar\" valign=\"top\" width=\"0\"></td>\r\n\r\n              <td id=\"tdContent\" vAlign=\"top\" width=\"1930\">\r\n                <table width=\"100%\" border=\"0\">\r\n                  <tr>\r\n                    <td vAlign=\"top\">\r\n                      <table id=\"tableTaxonChain\" cellspacing=\"0\" cellpadding=\"1\" width=\"100%\" border=\"0\">\r\n\t<tr>\r\n\t\t<td><span id=\"lblTaxonChain\"><font size=\"2\"><A HREF='flora_page.aspx?flora_id=4'  TARGET='_top' \n\tTITLE='Flora homepage' >Moss China</A> | <A HREF='browse.aspx?flora_id=4'  TARGET='_top' >Family List</A> | <A HREF='volume_page.aspx?volume_id=4002&flora_id=4'  TARGET='_top' >Moss China V. 2</A> | <A HREF='florataxon.aspx?flora_id=4&taxon_id=10727'  TARGET='_top' >Pottiaceae</A> <A HREF='browse.aspx?flora_id=4&start_taxon_id=10727'  TARGET='_top' \n\tTITLE='lower taxa' ><img border='0' src='images/layout/icon-list.gif'></A> | <A HREF='florataxon.aspx?flora_id=4&taxon_id=132132'  TARGET='_top' >Syntrichia</A> <A HREF='browse.aspx?flora_id=4&start_taxon_id=132132'  TARGET='_top' \n\tTITLE='lower taxa' ><img border='0' src='images/layout/icon-list.gif'></A></font></span></td>\r\n\t</tr>\r\n</table>\r\n\r\n                      <P></P>\r\n                      <div id=\"panelTaxonTreatment\">\r\n\t\r\n                        <span id=\"lblTaxonDesc\"><!-- Default Template -->\r\n4. <b>Syntrichia princeps</b> (De Not.) Mitt., J. Proc. Linn. Soc., Bot., Suppl.  1:39.  1859; Tortula princeps De Not., Mem. Reale Accad. Sci. Torino 40: 288. 1838.  \r\n<P>\r\n\r\n<P>\r\n\r\n<P>\r\n<p>\r\nBarbula princeps (De Not.) C. Müll., Syn. Musc. Frond. 1: 636. 1849.<p>\r\n\r\nPlants medium-sized to large, 2.0–5.0 cm high, dark green to reddish brown, in dense tufts. Stems erect, simple or irregularly branched, radiculose at base; central strand present. Leaves appressed or somewhat contorted-curved when dry, spreading when moist, oblong-ligulate to spathulate, obtusely acute at apex, upper lamina broadly channeled or keeled, weakly sheathing at base; margins often recurved, crenulate by projecting papillae; costa rather stout, reddish brown, excurrent, ending in a long, hyaline awn, denticulate on the back or at tips; upper leaf cells quadrate to hexagonal, each cell densely covered with several C-shaped papillae; basal cells distinctly differentiated, rectangular, thin-walled, smooth, hyaline or reddish. Autoicous (synoicous). Setae elongate, straight, reddish; capsules erect, cylindrical; peristome teeth linear, twisted, papillose; basal membrane high.<p>\r\n\r\n<p>\r\n\r\n<p>\r\nType. Sardinia, 1847, Rabenhorst s.n.  \n<p>\nChinese specimens examined: SHAANXI: Tai-bai Shan (Mt.), S.-E. Liu 4328 (PE). XINJIANG: Qing-he Co., R.-C. Qin 1213 (MO, PE); Sha-wan Co., R.-C. Qin 3467 (MO, PE); Xiang-Ke-gang Co., C.-Y. Yang 68 (HKAS). <p>\r\nHabitat: on rocks; Distribution: China, India, Himalayas, Turkey, Europe, North and South America, Africa, and Australia. <p>\r\n\r\n<p>\r\n<p>\r\n<p>\nIllustrations: C. Gao (ed.) 1996 (Pl. 84, fig. 6, as Tortula princeps).<p>\r\n<P>\r\n</span>\r\n                        <P><!-- Key -->\r\n                        </P> \r\n                        <P>\r\n                          <span id=\"lblLowerTaxonList\"></span></P>\r\n                        <BR clear=\"all\">\r\n                        <P>&nbsp;</P>\r\n                        <table id=\"tableObjectList\" cellspacing=\"0\" cellpadding=\"4\" width=\"100%\" border=\"1\">\r\n\t\t<tr bgcolor=\"#ffffcc\">\r\n\t\t\t<TD>\r\n                              <TABLE cellSpacing=\"0\" cellPadding=\"0\" width=\"100%\" border=\"0\">\r\n                                <TR>\r\n                                  <TD>\r\n                                    <span id=\"Label1\"><font size=\"2\">\r\n                                      <b>Related Objects</b>\r\n                                    </font></span></TD>\r\n                                  <TD align=\"right\">\r\n                                    <span id=\"lblGalleryLink\"><font size=\"1\"></font></span>&nbsp;</TD>\r\n                                </TR>\r\n                              </TABLE>\r\n                            </TD>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<TD>\r\n                              <span id=\"lblObjectList\"><TABLE  WIDTH='100%' BORDER='0' \n\t cellspacing=0>\n<TR >\n  <td width=400><li><A HREF='object_page.aspx?object_id=2844&flora_id=4' \n\tTITLE='Map' >Distribution Map</A></td>\n  <td class='small'>Map</td>\n</TR>\n</TABLE>\n<p>\n<TABLE  WIDTH='100%' BORDER='0' \n\t cellspacing=0>\n<TR >\n  <td class='bold'>Flora of North America</td>\n  <td >&nbsp;</td>\n</TR>\n<TR >\n  <td width=400><li><A HREF='object_page.aspx?object_id=84835&flora_id=1' \n\tTITLE='Map' >Distribution Map</A></td>\n  <td class='small'>Map</td>\n</TR>\n</TABLE>\n</span></TD>\r\n\t\t</tr>\r\n\t</table>\r\n\t\r\n                        <P></P>\r\n                      \r\n</div>\r\n                      <P><div id=\"panelTaxonLinks\">\r\n\t&nbsp;</P>\r\n                      <P>\r\n                        <table id=\"tableLinkList\" cellspacing=\"0\" cellpadding=\"4\" width=\"100%\" border=\"1\">\r\n\t\t<tr bgcolor=\"#ffffcc\">\r\n\t\t\t<TD><span id=\"lblLinkTitle\"><font size=\"2\"><b>Related Links</b> (opens in a new window)</font></span></TD>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<TD>\r\n                              <P><span id=\"lblLinkList\"><b>Treatments in Other Floras @ www.efloras.org</b><ul>\n<li><A HREF='florataxon.aspx?flora_id=1&taxon_id=240002109'  TARGET='_top' \n\tTITLE='treatment in Flora of North America' >Flora of North America</A></ul>\n<p>\n<b>Other Databases</b>\n<ul>\n\n<li><A HREF='http://mobot.mobot.org/cgi-bin/search_pick?name=Syntrichia+princeps'  TARGET='FLORA_LINK' \n\tTITLE='W3TROPICOS' >W<SUP>3</SUP>TROPICOS</A>\n<li><A HREF='http://www.ipni.org/ipni/IpniServlet?family=&infrafamily=&genus=Syntrichia&infragenus=&species=princeps&infraspecies=&author_abbrev=&publication_title=&is_apni_record=on&is_gci_record=on&is_ik_record=on&include_authors=on&include_basionym_authors=on&query_type=by_query'  TARGET='FLORA_LINK' \n\tTITLE='IPNI' >IPNI</A></ul>\n</span></P>\r\n                            </TD>\r\n\t\t</tr>\r\n\t</table>\r\n\t\r\n                        \r\n</div></P>\r\n                    </td>\r\n                  </tr>\r\n                  <tr>\r\n                    <td>\r\n                      <!-- Links -->\r\n                      <P></P>\r\n                      <P><span id=\"lblEditLinks\"><font size=\"2\"></font></span></P>\r\n                      <P>\r\n                        <!-- Comment List --></P>\r\n                    </td>\r\n                  </tr>\r\n                </table>\r\n              </td>\r\n              <TD id=\"tdRightBar\" valign=\"top\"></TD>\r\n\r\n            </tr>\r\n          </table>\r\n        </TD>\r\n      <tr>\r\n        <td>\r\n<table id=\"SubHeaderTableOut\" width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\r\n  <tr>\r\n    <td bgcolor=\"#999999\"><img src=\"~/images/layout/dot.gif\" alt=\"\" width=\"100%\" height=\"1\"></td>\r\n  </tr>\r\n  <tr>\r\n    <TD>\r\n      <table bgcolor=\"#99cc99\" id=\"SubHeaderTable\" width=\"100%\" border=\"0\" cellpadding=\"2\" cellspacing=\"0\">\r\n        <tr>\r\n          <TD align=\"center\" bgColor=\"#ffffcc\">\r\n            &nbsp;|&nbsp;\r\n            <a id=\"ucEfloraFooter_linkHome\" href=\"index.aspx\" target=\"_top\">eFlora Home</a>&nbsp;|&nbsp;\r\n            <a id=\"ucEfloraFooter_linkPeopleSearch\" href=\"person_search.aspx\" target=\"_top\">People Search</a>\r\n            &nbsp;|&nbsp;\r\n            <a id=\"ucEfloraFooter_linkHelp\" href=\"help_page.aspx\" target=\"_top\">Help</a>\r\n            &nbsp;|&nbsp;\r\n            <a id=\"ucEfloraFooter_linkActKey\" href=\"http://flora.huh.harvard.edu/china/ActKey\" target=\"_top\">ActKey</a>\r\n            &nbsp;|&nbsp;\r\n            <a id=\"ucEfloraFooter_Hyperlink2\" href=\"http://flora.huh.harvard.edu/HuCards/\" target=\"_top\">Hu Cards</a>\r\n            &nbsp;|&nbsp;\r\n            <a id=\"ucEfloraFooter_Hyperlink1\" href=\"glossary.aspx\" target=\"_top\">Glossary</a>\r\n            &nbsp;|&nbsp;\r\n          </TD>\r\n        </tr>\r\n      </table>\r\n    </TD>\r\n  </tr>\r\n  <tr>\r\n    <td bgcolor=\"#999999\"><img src=\"~/images/layout/dot.gif\" alt=\"\" width=\"100%\" height=\"1\"></td>\r\n  </tr>\r\n</table>\r\n<p></p>\r\n\r\n</td>\r\n      </tr>\r\n    </TABLE>\r\n  <a href=\"/url.html\" style='display:none'>login</a></body>\r\n</HTML>\r\n",
