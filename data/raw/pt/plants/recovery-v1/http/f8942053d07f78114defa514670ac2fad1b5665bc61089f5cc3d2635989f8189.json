t\r\n                        \r\n</div></P>\r\n                    </td>\r\n                  </tr>\r\n                  <tr>\r\n                    <td>\r\n                      <!-- Links -->\r\n                      <P></P>\r\n                      <P><span id=\"lblEditLinks\"><font size=\"2\"></font></span></P>\r\n                      <P>\r\n                        <!-- Comment List --></P>\r\n                    </td>\r\n                  </tr>\r\n                </table>\r\n              </td>\r\n              <TD id=\"tdRightBar\" valign=\"top\" bgcolor=\"#ccccff\" width=\"100\"><span id=\"ucRightBar_lblSideBar\"><TABLE  borderColor=\"#ccccee\"  cellSpacing=\"0\" cellPadding=\"6\"  width=\"100\" border=\"1\">\r\n<TR>\r\n   <TD style=\"font-size:8pt\" height=\"100%\" align=center >\r\n<a href=\"flora_page.aspx?flora_id=2\">Flora of China @ efloras.org</a>\r\n<hr >\r\n<b>Browse by </b><br>\r\n<a href=\"flora_page.aspx?flora_id=2\">Volume</a>\r\n<br>\r\n<a href=\"browse.aspx?flora_id=2&letter=a\"> Family </a>\r\n<br>\r\n<a href=\"browse.aspx?flora_id=2&rank_id=10040&letter=a\"> Genera</a>\r\n<hr >\r\n<A href=\"search_page.aspx?flora_id=2\">\r\nAdvanced Search</A><br>\r\n<hr >\r\n<center>\r\n<A HREF='http://flora.huh.harvard.edu/china/index.html' target=\"FOC\">\r\n<img src=\"http://www.efloras.org/images/project/0002/foc_logo.gif\" border=0><br>Flora of China Home</A>\r\n<p>\r\n<hr>\r\n<A HREF='http://mobot.mobot.org/W3T/Search/FOC/projsfoc.html'  target=\"FOC\">Checklist</A>\r\n<p>\r\n</center>\r\n<p>\r\n <p>\r\n</TD>\r\n</TR>\r\n</TABLE>\r\n</form>\r\n <p></span>\r\n</TD>\r\n\r\n            </tr>\r\n          </table>\r\n        </TD>\r\n      <tr>\r\n        <td>\r\n<table id=\"SubHeaderTableOut\" width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\r\n  <tr>\r\n    <td bgcolor=\"#999999\"><img src=\"~/images/layout/dot.gif\" alt=\"\" width=\"100%\" height=\"1\"></td>\r\n  </tr>\r\n  <tr>\r\n    <TD>\r\n      <table bgcolor=\"#99cc99\" id=\"SubHeaderTable\" width=\"100%\" border=\"0\" cellpadding=\"2\" cellspacing=\"0\">\r\n        <tr>\r\n          <TD align=\"center\" bgColor=\"#ffffcc\">\r\n            &nbsp;|&nbsp;\r\n            <a id=\"ucEfloraFooter_linkHome\" href=\"index.aspx\" target=\"_top\">eFlora Home</a>&nbsp;|&nbsp;\r\n            <a id=\"ucEfloraFooter_linkPeopleSearch\" href=\"person_search.aspx\" target=\"_top\">People Search</a>\r\n            &nbsp;|&nbsp;\r\n            <a id=\"ucEfloraFooter_linkHelp\" href=\"help_page.aspx\" target=\"_top\">Help</a>\r\n            &nbsp;|&nbsp;\r\n            <a id=\"ucEfloraFooter_linkActKey\" href=\"http://flora.huh.harvard.edu/china/ActKey\" target=\"_top\">ActKey</a>\r\n            &nbsp;|&nbsp;\r\n            <a id=\"ucEfloraFooter_Hyperlink2\" href=\"http://flora.huh.harvard.edu/HuCards/\" target=\"_top\">Hu Cards</a>\r\n            &nbsp;|&nbsp;\r\n            <a id=\"ucEfloraFooter_Hyperlink1\" href=\"glossary.aspx\" target=\"_top\">Glossary</a>\r\n            &nbsp;|&nbsp;\r\n          </TD>\r\n        </tr>\r\n      </table>\r\n    </TD>\r\n  </tr>\r\n  <tr>\r\n    <td bgcolor=\"#999999\"><img src=\"~/images/layout/dot.gif\" alt=\"\" width=\"100%\" height=\"1\"></td>\r\n  </tr>\r\n</table>\r\n<p></p>\r\n\r\n</td>\r\n      </tr>\r\n    </TABLE>\r\n  <a href=\"/url.html\" style='display:none'>login</a></body>\r\n</HTML>\r\n"
