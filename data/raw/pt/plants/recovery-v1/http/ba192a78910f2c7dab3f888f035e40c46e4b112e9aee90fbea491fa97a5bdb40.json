        "genusKey": 165552661,
        "scientificName": "Coilostylis (Raf.) Withner & P.A.Harding, 2004",
        "canonicalName": "Coilostylis",
        "authorship": "(Raf.) Withner and P. A. Harding (2004)",
        "nameType": "SCIENTIFIC",
        "taxonomicStatus": "ACCEPTED",
