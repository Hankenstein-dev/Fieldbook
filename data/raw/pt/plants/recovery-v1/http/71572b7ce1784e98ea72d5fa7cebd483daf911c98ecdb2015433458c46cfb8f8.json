  "text": "\r\n<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0 Transitional//EN\" >\r\n<HTML>\r\n  <!--%@ OutputCache Duration=60 VaryByParam=\"flora_id;taxon_id\"  %-->\r\n\r\n<head>\r\n<!-- Google Tag Manager -->\r\n<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\r\nnew Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\r\nj=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\r\n'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\r\n})(window,document,'script','dataLayer','GTM-TGK4SMV');</script>\r\n<!-- End Google Tag Manager -->\r\n<title>Gamochaeta impatiens in Flora of China @ efloras.org</title>\r\n<link rel=\"stylesheet\" type=\"text/css\" href='/templates/eflora.css' />\r\n<script src=\"JavaScript/eflora.js\" type=\"text/javascript\" ></script>\r\n</head>\r\n\r\n\r\n  <!-- body onload=\"formMOMap.submit()\" -->\r\n  <body>\r\n\r\n    <TABLE id=\"TableMain\" cellSpacing=\"1\" cellPadding=\"1\" width=\"640\" border=\"0\">\r\n      <TR>\r\n        <TD><!--%@ Register TagPrefix=\"ucFlora\" TagName=\"TaxonSearchBox\" Src=\"TaxonSearchBox.ascx\" %-->\r\n\r\n<script language=\"javascript\">\r\n\r\nfunction jsClearTextBox(sender)\r\n{\r\n  // alert(formSearchBox[\"name_str\"].id);\r\n  // alert(sender.value);\r\n  if (sender.value == \"taxon name\")\r\n  {\r\n    sender.value = \"\";\r\n  }\r\n}\r\n\r\n</script>\r\n<table id=\"ucEfloraHeader_tableHeaderWrapper\" cellspacing=\"0\" cellpadding=\"0\" width=\"100%\" border=\"0\">\r\n\t<tr>\r\n\t\t<TD style=\"WIDTH: 479px\"><a id=\"ucEfloraHeader_linkFloraHome\" title=\"Flora Homepage\" href=\"flora_page.aspx?flora_id=2\"><img src=\"images/flora/eflora-logo-2.gif\" id=\"ucEfloraHeader_imageLogo\" border=\"0\" alt=\"Link to Flora of China home\" /><br>\r\n        </a></TD>\r\n\t\t<TD valign=\"bottom\" align=\"right\">\r\n      <div id=\"ucEfloraHeader_panelSearchBox\">\r\n\t\t\t <!-- begin of search box -->\r\n        <FORM name=\"formSearchBox\" action=\"browse.aspx\" method=\"get\">\r\n          <TABLE borderColor=\"#ccffcc\" cellSpacing=\"0\" cellPadding=\"2\" width=\"200\" border=\"1\">\r\n            <TR>\r\n              <TD>\r\n                <span id=\"ucEfloraHeader_lblSearchBox\"><INPUT TYPE='Hidden' NAME='flora_id' ' id='flora_id' VALUE='2' >\n&nbsp;<input id=name_str name=name_str &nbsp;  value=''  class=small title='Use % as the wildcard\r\n(e.g. pinus % or pinus a%)'  onfocus='jsClearTextBox(this);' accessKey=s size=15> <input class=small type=submit value=Search name=btnSearch><br>\n <input name=chkAllFloras type=checkbox   > <span class=small>All Floras &nbsp; &nbsp; &nbsp;<A HREF='search_page.aspx?flora_id=2'  TARGET='_top'  class='a.link.small'>Advanced Search</A></span>\n</span></TD>\r\n            </TR>\r\n          </TABLE>\r\n        </FORM> <!-- end of search box -->\r\n      \r\n\t\t</div>\r\n    </TD>\r\n\t</tr>\r\n</table>\r\n\r\n</TD>\r\n      </TR>\r\n      <TR>\r\n        <TD id=\"tdSubHeader\">\r\n<table id=\"FooterTableOut\" width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\r\n  <tr>\r\n    <td bgcolor=\"#999999\"><img src=\"~/images/layout/dot.gif\" alt=\"\" width=\"100%\" height=\"1\"></td>\r\n  </tr>\r\n  <tr>\r\n    <TD>\r\n      <table bgcolor=\"#ffffcc\" id=\"footerTable\" width=\"100%\" border=\"0\" cellpadding=\"2\" cellspacing=\"0\">\r\n        <tr>\r\n          <td style=\"WIDTH: 291px\">FOC Vol. 20-21 Page 776, <b>777</b></td>\r\n          <TD align=\"right\">\r\n            <span id=\"ucEfloraSubHeader_lblLinks\"><a target='_top' href='/login.aspx'>Login</a>\n | <A HREF='/index.aspx'  TARGET='_top' >eFloras Home</A> | <A HREF='/help_page.aspx'  TARGET='_top' >Help</A></span></TD>\r\n        </tr>\r\n      </table>\r\n    </TD>\r\n  </tr>\r\n  <tr>\r\n    <td bgcolor=\"#999999\"><img src=\"~/images/layout/dot.gif\" alt=\"\" width=\"100%\" height=\"1\"></td>\r\n  </tr>\r\n</table>\r\n</TD>\r\n      </TR>\r\n      <TR>\r\n        <TD id=\"tdBody\">\r\n          <table id=\"tableBody\" cellSpacing=\"0\" cellPadding=\"0\" width=\"100%\" border=\"0\">\r\n            <tr>\r\n              <td id=\"tdLeftBar\" valign=\"top\" width=\"0\"></td>\r\n\r\n              <td id=\"tdContent\" vAlign=\"top\" width=\"1930\">\r\n                <table width=\"100%\" border=\"0\">\r\n                  <tr>\r\n                    <td vAlign=\"top\">\r\n                      <table id=\"tableTaxonChain\" cellspacing=\"0\" cellpadding=\"1\" width=\"100%\" border=\"0\">\r\n\t<tr>\r\n\t\t<td><span id=\"lblTaxonChain\"><font size=\"2\"><A HREF='flora_page.aspx?flora_id=2'  TARGET='_top' \n\tTITLE='Flora homepage' >FOC</A> | <A HREF='browse.aspx?flora_id=2'  TARGET='_top' >Family List</A> | <A HREF='volume_page.aspx?volume_id=2020&flora_id=2'  TARGET='_top' >FOC Vol. 20-21</A> | <A HREF='florataxon.aspx?flora_id=2&taxon_id=10074'  TARGET='_top' >Asteraceae</A> <A HREF='browse.aspx?flora_id=2&start_taxon_id=10074'  TARGET='_top' \n\tTITLE='lower taxa' ><img border='0' src='images/layout/icon-list.gif'></A> | <A HREF='florataxon.aspx?flora_id=2&taxon_id=113220'  TARGET='_top' >Gamochaeta</A> <A HREF='browse.aspx?flora_id=2&start_taxon_id=113220'  TARGET='_top' \n\tTITLE='lower taxa' ><img border='0' src='images/layout/icon-list.gif'></A></font></span></td>\r\n\t</tr>\r\n</table>\r\n\r\n                      <P></P>\r\n                      <div id=\"panelTaxonTreatment\">\r\n\t\r\n                        <span id=\"lblTaxonDesc\"><!-- Default Template -->\r\n3. <b>Gamochaeta impatiens</b> Nesom, Phytoneuron.  35: 2.  2022.  \n<p>凤仙花合冠鼠麴草属 feng xian hua he guan shu qu cao shu \r\n<P>\r\n\r\n<P>\r\n\r\n<P>\r\n<p>\r\n<p>\r\n\r\nHerbs, winter annual or biennial, 15-35(-50) cm tall, fibrous rooted. Stems ascending, white pannose. Leaves basal and cauline, basal leaves in rosettes, present at anthesis, blades bicolored on both surfaces, spatulate to oblanceolate-obovate, (1.5-)3-8(-12) cm × 6-15(-22) mm, abaxially closely white pannose, adaxially glabrous or glabrate; leaves distally gradually smaller, slightly succulent, margin often crenulate on drying. Capitula initially usually in dense, continuous, pressed spiciform arrays 2-20 cm × 10-14 mm, later branched, interrupted. Involucre cylindric-campanulate, 2.5-3 mm, base glabrous; phyllaries 4- or 5-seriate; outer ones purplish or rosy, elliptic-obovate to broadly ovate-elliptic, 1/4-1/3 as long as inner ones, apices rounded to obtuse; inner ones oblong, laminae brown hyaline, apices rounded to obtuse or blunt, apiculate. Bisexual florets 2 or 3. Corollas of all florets usually purplish distally. Achenes oblong-elliptic, 0.5-0.6 mm. Pappus white, ca. 2.5 mm, connate at base into a ring, deciduous. Fl. Apr-Jun. 2<i>n</i> = 28.<p>\r\n\r\n<p>\r\n\r\n<p>\r\n<p>\r\nWaste fields, roadsides, ditches; 400-1400 m. Naturalized in Guizhou and Taiwan [native to South America; widely introduced in Asia, Caribbean, Europe, North America, Oceania, Pacific islands].<p>\r\n\r\nThe present report of this species is its first record in mainland China.<p>\r\n<p>\r\n<p>\r\n<P>\r\n</span>\r\n                        <P><!-- Key -->\r\n                        </P> \r\n                        <P>\r\n                          <span id=\"lblLowerTaxonList\"></span></P>\r\n                        <BR clear=\"all\">\r\n                        <P>&nbsp;</P>\r\n                        <table id=\"tableObjectList\" cellspacing=\"0\" cellpadding=\"4\" width=\"100%\" border=\"1\">\r\n\t\t<tr bgcolor=\"#ffffcc\">\r\n\t\t\t<TD>\r\n                              <TABLE cellSpacing=\"0\" cellPadding=\"0\" width=\"100%\" border=\"0\">\r\n                                <TR>\r\n                                  <TD>\r\n                                    <span id=\"Label1\"><font size=\"2\">\r\n                                      <b>Related Objects</b>\r\n                                    </font></span></TD>\r\n                                  <TD align=\"right\">\r\n                                    <span id=\"lblGalleryLink\"><font size=\"1\"></font></span>&nbsp;</TD>\r\n                                </TR>\r\n                              </TABLE>\r\n                            </TD>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<TD>\r\n                              <span id=\"lblObjectList\"><p>\n<TABLE  WIDTH='100%' BORDER='0' \n\t cellspacing=0>\n<TR >\n  <td class='bold'>Flora of North America</td>\n  <td >&nbsp;</td>\n</TR>\n<TR >\n  <td width=400><li><A HREF='object_page.aspx?object_id=54611&flora_id=1' \n\tTITLE='Map' >Distribution Map</A></td>\n  <td class='small'>Map</td>\n</TR>\n</TABLE>\n</span></TD>\r\n\t\t</tr>\r\n\t</table>\r\n\t\r\n                        <P></P>\r\n                      \r\n</div>\r\n                      <P><div id=\"panelTaxonLinks\">\r\n\t&nbsp;</P>\r\n                      <P>\r\n                        <table id=\"tableLinkList\" cellspacing=\"0\" cellpadding=\"4\" width=\"100%\" border=\"1\">\r\n\t\t<tr bgcolor=\"#ffffcc\">\r\n\t\t\t<TD><span id=\"lblLinkTitle\"><font size=\"2\"><b>Related Links</b> (opens in a new window)</font></span></TD>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<TD>\r\n                              <P><span id=\"lblLinkList\"><b>Treatments in Other Floras @ www.efloras.org</b><ul>\n<li><A HREF='florataxon.aspx?flora_id=1&taxon_id=250054376'  TARGET='_top' \n\tTITLE='treatment in Flora of North America' >Flora of North America</A></ul>\n<p>\n<b>Other Databases</b>\n<ul>\n\n<li><A HREF='http://mobot.mobot.org/cgi-bin/search_pick?name=Gamochaeta+impatiens'  TARGET='FLORA_LINK' \n\tTITLE='W3TROPICOS' >W<SUP>3</SUP>TROPICOS</A>\n<li><A HREF='http://www.ipni.org/ipni/IpniServlet?family=&infrafamily=&genus=Gamochaeta&infragenus=&species=impatiens&infraspecies=&author_abbrev=&publication_title=&is_apni_record=on&is_gci_record=on&is_ik_record=on&include_authors=on&include_basionym_authors=on&query_type=by_query'  TARGET='FLORA_LINK' \n\tTITLE='IPNI' >IPNI</A></ul>\n</span></P>\r\n                            </TD>\r\n\t\t</tr>\r\n\t</table>\r\n\t\r\n                        \r\n</div></P>\r\n                    </td>\r\n                  </tr>\r\n                  <tr>\r\n                    <td>\r\n                      <!-- Links -->\r\n                      <P></P>\r\n                      <P><span id=\"lblEditLinks\"><font size=\"2\"></font></span></P>\r\n                      <P>\r\n                        <!-- Comment List --></P>\r\n                    </td>\r\n                  </tr>\r\n                </table>\r\n              </td>\r\n              <TD id=\"tdRightBar\" valign=\"top\" bgcolor=\"#ccccff\" width=\"100\"><span id=\"ucRightBar_lblSideBar\"><TABLE  borderColor=\"#ccccee\"  cellSpacing=\"0\" cellPadding=\"6\"  width=\"100\" border=\"1\">\r\n<TR>\r\n   <TD style=\"font-size:8pt\" height=\"100%\" align=center >\r\n<a href=\"flora_page.aspx?flora_id=2\">Flora of China @ efloras.org</a>\r\n<hr >\r\n<b>Browse by </b><br>\r\n<a href=\"flora_page.aspx?flora_id=2\">Volume</a>\r\n<br>\r\n<a href=\"browse.aspx?flora_id=2&letter=a\"> Family </a>\r\n<br>\r\n<a href=\"browse.aspx?flora_id=2&rank_id=10040&letter=a\"> Genera</a>\r\n<hr >\r\n<A href=\"search_page.aspx?flora_id=2\">\r\nAdvanced Search</A><br>\r\n<hr >\r\n<center>\r\n<A HREF='http://flora.huh.harvard.edu/china/index.html' target=\"FOC\">\r\n<img src=\"http://www.efloras.org/images/project/0002/foc_logo.gif\" border=0><br>Flora of China Home</A>\r\n<p>\r\n<hr>\r\n<A HREF='http://mobot.mobot.org/W3T/Search/FOC/projsfoc.html'  target=\"FOC\">Checklist</A>\r\n<p>\r\n</center>\r\n<p>\r\n <p>\r\n</TD>\r\n</TR>\r\n</TABLE>\r\n</form>\r\n <p></span>\r\n</TD>\r\n\r\n            </tr>\r\n          </table>\r\n        </TD>\r\n      <tr>\r\n        <td>\r\n<table id=\"SubHeaderTableOut\" width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\r\n  <tr>\r\n    <td bgcolor=\"#999999\"><img src=\"~/images/layout/dot.gif\" alt=\"\" width=\"100%\" height=\"1\"></td>\r\n  </tr>\r\n  <tr>\r\n    <TD>\r\n     