  "text": "\r\n<!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0 Transitional//EN\" >\r\n<HTML>\r\n  <!--%@ OutputCache Duration=60 VaryByParam=\"flora_id;taxon_id\"  %-->\r\n\r\n<head>\r\n<!-- Google Tag Manager -->\r\n<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':\r\nnew Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],\r\nj=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=\r\n'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);\r\n})(window,document,'script','dataLayer','GTM-TGK4SMV');</script>\r\n<!-- End Google Tag Manager -->\r\n<title>Ptychomitrium in Flora of North America @ efloras.org</title>\r\n<link rel=\"stylesheet\" type=\"text/css\" href='/templates/eflora.css' />\r\n<script src=\"JavaScript/eflora.js\" type=\"text/javascript\" ></script>\r\n</head>\r\n\r\n\r\n  <!-- body onload=\"formMOMap.submit()\" -->\r\n  <body>\r\n\r\n    <TABLE id=\"TableMain\" cellSpacing=\"1\" cellPadding=\"1\" width=\"640\" border=\"0\">\r\n      <TR>\r\n        <TD><!--%@ Register TagPrefix=\"ucFlora\" TagName=\"TaxonSearchBox\" Src=\"TaxonSearchBox.ascx\" %-->\r\n\r\n<script language=\"javascript\">\r\n\r\nfunction jsClearTextBox(sender)\r\n{\r\n  // alert(formSearchBox[\"name_str\"].id);\r\n  // alert(sender.value);\r\n  if (sender.value == \"taxon name\")\r\n  {\r\n    sender.value = \"\";\r\n  }\r\n}\r\n\r\n</script>\r\n<table id=\"ucEfloraHeader_tableHeaderWrapper\" cellspacing=\"0\" cellpadding=\"0\" width=\"100%\" border=\"0\">\r\n\t<tr>\r\n\t\t<TD style=\"WIDTH: 479px\"><a id=\"ucEfloraHeader_linkFloraHome\" title=\"Flora Homepage\" href=\"flora_page.aspx?flora_id=1\"><img src=\"images/flora/eflora-logo-1.gif\" id=\"ucEfloraHeader_imageLogo\" border=\"0\" alt=\"Link to Flora of North America home\" /><br>\r\n        </a></TD>\r\n\t\t<TD valign=\"bottom\" align=\"right\">\r\n      <div id=\"ucEfloraHeader_panelSearchBox\">\r\n\t\t\t <!-- begin of search box -->\r\n        <FORM name=\"formSearchBox\" action=\"browse.aspx\" method=\"get\">\r\n          <TABLE borderColor=\"#ccffcc\" cellSpacing=\"0\" cellPadding=\"2\" width=\"200\" border=\"1\">\r\n            <TR>\r\n              <TD>\r\n                <span id=\"ucEfloraHeader_lblSearchBox\"><INPUT TYPE='Hidden' NAME='flora_id' ' id='flora_id' VALUE='1' >\n&nbsp;<input id=name_str name=name_str &nbsp;  value=''  class=small title='Use % as the wildcard\r\n(e.g. pinus % or pinus a%)'  onfocus='jsClearTextBox(this);' accessKey=s size=15> <input class=small type=submit value=Search name=btnSearch><br>\n <input name=chkAllFloras type=checkbox   > <span class=small>All Floras &nbsp; &nbsp; &nbsp;<A HREF='search_page.aspx?flora_id=1'  TARGET='_top'  class='a.link.small'>Advanced Search</A></span>\n</span></TD>\r\n            </TR>\r\n          </TABLE>\r\n        </FORM> <!-- end of search box -->\r\n      \r\n\t\t</div>\r\n    </TD>\r\n\t</tr>\r\n</table>\r\n\r\n</TD>\r\n      </TR>\r\n      <TR>\r\n        <TD id=\"tdSubHeader\">\r\n<table id=\"FooterTableOut\" width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\r\n  <tr>\r\n    <td bgcolor=\"#999999\"><img src=\"~/images/layout/dot.gif\" alt=\"\" width=\"100%\" height=\"1\"></td>\r\n  </tr>\r\n  <tr>\r\n    <TD>\r\n      <table bgcolor=\"#ffffcc\" id=\"footerTable\" width=\"100%\" border=\"0\" cellpadding=\"2\" cellspacing=\"0\">\r\n        <tr>\r\n          <td style=\"WIDTH: 291px\">FNA Vol. 27 Page 266, 306, <b>307</b>, 309</td>\r\n          <TD align=\"right\">\r\n            <span id=\"ucEfloraSubHeader_lblLinks\"><a target='_top' href='/login.aspx'>Login</a>\n | <A HREF='/index.aspx'  TARGET='_top' >eFloras Home</A> | <A HREF='/help_page.aspx'  TARGET='_top' >Help</A></span></TD>\r\n        </tr>\r\n      </table>\r\n    </TD>\r\n  </tr>\r\n  <tr>\r\n    <td bgcolor=\"#999999\"><img src=\"~/images/layout/dot.gif\" alt=\"\" width=\"100%\" height=\"1\"></td>\r\n  </tr>\r\n</table>\r\n</TD>\r\n      </TR>\r\n      <TR>\r\n        <TD id=\"tdBody\">\r\n          <table id=\"tableBody\" cellSpacing=\"0\" cellPadding=\"0\" width=\"100%\" border=\"0\">\r\n            <tr>\r\n              <td id=\"tdLeftBar\" valign=\"top\" width=\"0\"></td>\r\n\r\n              <td id=\"tdContent\" vAlign=\"top\" width=\"1930\">\r\n                <table width=\"100%\" border=\"0\">\r\n                  <tr>\r\n                    <td vAlign=\"top\">\r\n                      <table id=\"tableTaxonChain\" cellspacing=\"0\" cellpadding=\"1\" width=\"100%\" border=\"0\">\r\n\t<tr>\r\n\t\t<td><span id=\"lblTaxonChain\"><font size=\"2\"><A HREF='flora_page.aspx?flora_id=1'  TARGET='_top' \n\tTITLE='Flora homepage' >FNA</A> | <A HREF='browse.aspx?flora_id=1'  TARGET='_top' >Family List</A> | <A HREF='volume_page.aspx?volume_id=1027&flora_id=1'  TARGET='_top' >FNA Vol. 27</A> | <A HREF='florataxon.aspx?flora_id=1&taxon_id=10743'  TARGET='_top' >Ptychomitriaceae</A> <A HREF='browse.aspx?flora_id=1&start_taxon_id=10743'  TARGET='_top' \n\tTITLE='lower taxa' ><img border='0' src='images/layout/icon-list.gif'></A></font></span></td>\r\n\t</tr>\r\n</table>\r\n\r\n                      <P></P>\r\n                      <div id=\"panelTaxonTreatment\">\r\n\t\r\n                        <span id=\"lblTaxonDesc\"><!-- FNA Template -->\r\n2. <b>Ptychomitrium</b> Fürnrohr, Flora.  12(Ergänzungsbl.): 19.  1829.  \n<p>[Greek <i>ptyx</i>, fold, and <i>mitra</i>, turban, alluding to plicate calyptra]  \r\n<P>\r\n\r\n<P>\r\n\r\n<P>\r\n<p>\r\n<p>\r\n\r\n<b>Plants</b> small to robust, tufted or caspitose, dark green to blackish. <b>Stems</b> erect or repent. <b>Leaves</b> erect to crispate when dry, margins entire to serrulate or serrate; medial cells smooth or slightly papillose. <b>Specialized asexual reproduction</b> rare, by 1-seriate gemmae on branched axillary filaments. <b>Seta</b> straight. <b>Capsule</b> ovoid to cylindric, symmetric or slightly curved, smooth to wrinkled or ribbed when dry. <b>Calyptra</b> mitrate, more or less plicate, lobed proximally. <b>Spores</b> smooth to papillose.<p>\r\nSpecies 40-50 (5 in the flora): nearly worldwide, mostly in temperate regions.<p>\r\n\r\n<p>\r\n<p>\r\n<p>\r\n\r\n<b>Excluded Species:</b><p>\r\n<i>Glyphomitrium canadense</i> Mitten<br>\r\n<p>This taxon was included for western Canada by G. N. Jones (1933), but was excluded from North America by H. A. Crum (1972) and L. E. Anderson et al. (1990). Crum considered <i>Glyphomitrium canadense</i> to be a synonym of the British <i>G. daviesii</i> (Withering) Bridel and suggested that the specimen on which Mitten based the name came from Great Britain.<p>\r\n<p>\r\nSELECTED REFERENCE<p> Cao, T. and D. H. Vitt. 1994. North American-East Asian similarities in the genus <i>Ptychomitrium</i> (Bryopsida). Bryologist 97: 34-41.<p>\r\n<P>\r\n</span>\r\n                        <P><!-- Key -->\r\n                        <div id=\"panelKey\">\r\n\t\t\r\n                          <BR clear=\"all\">\r\n                          <table id=\"tableKey\" cellspacing=\"0\" cellpadding=\"4\" width=\"100%\" border=\"0\">\r\n\t\t\t<tr bgcolor=\"#d5ffff\">\r\n\t\t\t\t<TD width=\"347\">\r\n                                <P>\r\n                                  <span id=\"lblKeyTitle\"><b><font size=\"2\"></font></b></span></P>\r\n                              </TD>\r\n\t\t\t\t<TD nowrap=\"nowrap\" align=\"right\">\r\n                                <P>\r\n                                  <span id=\"lblKeyEditLink\"><font size=\"1\"></font></span></P>\r\n                              </TD>\r\n\t\t\t</tr>\r\n\t\t\t<tr bgcolor=\"#f1ffff\">\r\n\t\t\t\t<TD colspan=\"2\">\r\n                                <P>\r\n                                  <span id=\"lblKeyDesc\"><font size=\"2\"></font></span></P>\r\n                                <P>\r\n                                  <span id=\"lblKey\"><TABLE  WIDTH='100%' BORDER='0' >\n<TR >\n  <td WIDTH=50 NOWRAP VALIGN=TOP><A NAME='KEY-1-1'>1</A></td>\n  <td WIDTH=400 VALIGN=TOP>Leaves coarsely serrate distally</td>\n  <td >&nbsp;</td>\n  <td VALIGN=TOP NOWRAP><A HREF='#KEY-1-2'>(2)</A></td>\n</TR>\n<TR >\n  <td WIDTH=50 NOWRAP VALIGN=TOP>+</td>\n  <td WIDTH=400 VALIGN=TOP>Leaves entire or obscurely irregularly serrulate distally</td>\n  <td >&nbsp;</td>\n  <td VALIGN=TOP NOWRAP><A HREF='#KEY-1-3'>(3)</A></td>\n</TR>\n<TR >\n  <td >&nbsp;</td>\n  <td >&nbsp;</td>\n  <td >&nbsp;</td>\n  <td >&nbsp;</td>\n</TR>\n<TR >\n  <td WIDTH=50 NOWRAP VALIGN=TOP><A NAME='KEY-1-2'>2</A> <A HREF='#KEY-1-1'>(1)</A></td>\n  <td WIDTH=400 VALIGN=TOP>Leaves slenderly long-acuminate, 4-6 mm; basal leaf margins broadly recurved on one or both sides; calyptra deeply lobed proximally, lobes half length of calyptra.</td>\n  <td >&nbsp;</td>\n  <td VALIGN=TOP NOWRAP>1 <A HREF='florataxon.aspx?flora_id=1&taxon_id=240002103'  TARGET='_top' ><i>Ptychomitrium gardneri</i></A></td>\n</TR>\n<TR >\n  <td WIDTH=50 NOWRAP VALIGN=TOP>+</td>\n  <td WIDTH=400 VALIGN=TOP>Leaves broadly acuminate, 3-4 mm; basal leaf margins plane and erect or irregularly narrowly recurved on one side proximally; calyptra shallowly lobed proximally, lobes less than <sup>1</sup>/2 length of calyptra.</td>\n  <td >&nbsp;</td>\n  <td VALIGN=TOP NOWRAP>2 <A HREF='florataxon.aspx?flora_id=1&taxon_id=242443498'  TARGET='_top' ><i>Ptychomitrium serratum</i></A></td>\n</TR>\n<TR >\n  <td >&nbsp;</td>\n  <td >&nbsp;</td>\n  <td >&nbsp;</td>\n  <td >&nbsp;</td>\n</TR>\n<TR >\n  <td WIDTH=50 NOWRAP VALIGN=TOP><A NAME='KEY-1-3'>3</A> <A HREF='#KEY-1-1'>(1)</A></td>\n  <td WIDTH=400 VALIGN=TOP>Plants dull, mostly corticolous; leaves straight or slightly contorted but not crispate when dry, margins mostly obscurely serrulate distally.</td>\n  <td >&nbsp;</td>\n  <td VALIGN=TOP NOWRAP>5 <A HREF='florataxon.aspx?flora_id=1&taxon_id=242443503'  TARGET='_top' ><i>Ptychomitrium drummondii</i></A></td>\n</TR>\n<TR >\n  <td WIDTH=50 NOWRAP VALIGN=TOP>+</td>\n  <td WIDTH=400 VALIGN=TOP>Plants glossy, mostly on rock; leaves crispate when dry, margins entire</td>\n  <td >&nbsp;</td>\n  <td VALIGN=TOP NOWRAP><A HREF='#KEY-1-4'>(4)</A></td>\n</TR>\n<TR >\n  <td >&nbsp;</td>\n  <td >&nbsp;</td>\n  <td >&nbsp;</td>\n  <td >&nbsp;</td>\n</TR>\n<TR >\n  <td WIDTH=50 NOWRAP VALIGN=TOP><A NAME='KEY-1-4'>4</A> <A HREF='#KEY-1-3'>(3)</A></td>\n  <td WIDTH=400 VALIGN=TOP>Longest leaves mostly 2.5-4 mm.</td>\n  <td >&nbsp;</td>\n  <td VALIGN=TOP NOWRAP>3 <A HREF='florataxon.aspx?flora_id=1&taxon_id=200001258'  TARGET='_top' ><i>Ptychomitrium sinense</i></A></td>\n</TR>\n<TR >\n  <td WIDTH=50 NOWRAP VALIGN=TOP>+</td>\n  <td WIDTH=400 VALIGN=TOP>Longest leaves mostly 2 mm.</td>\n  <td >&nbsp;</td>\n  <td VALIGN=TOP NOWRAP>4 <A HREF='florataxon.aspx?flora_id=1&taxon_id=242443501'  TARGET='_top' ><i>Ptychomitrium incurvum</i></A></td>\n</TR>\n</TABLE>\n</span></P>\r\n                              </TD>\r\n\t\t\t</tr>\r\n\t\t\t<tr bgcolor=\"#d5ffff\">\r\n\t\t\t\t<TD colspan=\"2\">\r\n                                <span id=\"lblKeyList\"><font size=\"2\"></font></span></TD>\r\n\t\t\t</tr>\r\n\t\t</table>\r\n\t\t\r\n                        \r\n\t</div></P> \r\n                        <P>\r\n                          <span id=\"lblLowerTaxonList\"><p>\n<B>Lower Taxa</B><br>\n<ul>\n<li><A HREF='florataxon.aspx?flora_id=1&taxon_id=242443503' \n\tTITLE='Accepted Name' ><b>Ptychomitrium</b> <b>drummondii</b>  (Wilson) Sullivant</A><li><A HREF='florataxon.aspx?flora_id=1&taxon_id=240002103' \n\tTITLE='Accepted Name' ><b>Ptychomitrium</b> <b>gardneri</b>  Lesquereux</A><li><A HREF='florataxon.aspx?flora_id=1&taxon_id=242443501' \n\tTITLE='Accepted Name' ><b>Ptychomitrium</b> <b>incurvum</b>  (Schwägrichen) Spruce</A><li><A HREF='florataxon.aspx?flora_id=1&taxon_id=242443498' \n\tTITLE='Accepted Name' ><b>Ptychomitrium</b> <b>serratum</b>  Bruch & Schimper</A><li><A HREF='florataxon.aspx?flora_id=1&taxon_id=200001258' \n\tTITLE='Accepted Name' ><b>Ptychomitrium</b> <b>sinense</b>  (Mitten) A. Jaeger</A></ul>\n<p>\n</span></P>\r\n                        <BR clear=\"all\">\r\n                        <P>&nbsp;</P>\r\n                        \r\n                        <P></P>\r\n                      \r\n</div>\r\n                      <P><div id=\"panelTaxonLinks\">\r\n\t&nbsp;</P>\r\n                      <P>\r\n                        <table id=\"tableLinkList\" cellspacing=\"0\" cellpadding=\"4\" width=\"100%\" border=\"1\">\r\n\t\t<tr bgcolor=\"#ffffcc\">\r\n\t\t\t<TD><span id=\"lblLinkTitle\"><font size=\"2\"><b>Related Links</b> (opens in a new window)</font></span></TD>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<TD>\r\n                              <P><span id=\"lblLinkList\"><b>Treatments in Other Floras @ www.efloras.org</b><ul>\n<li><A HREF='florataxon.aspx?flora_id=3&taxon_id=127592'  TARGET='_top' \n\tTITLE='treatment in Chinese Plant Names' >Chinese Plant Names</A><li><A HREF='florataxon.aspx?flora_id=4&taxon_id=127592'  TARGET='_top' \n\tTITLE='treatment in Moss Flora of China' >Moss Flora of China</A></ul>\n<p>\n<b>Other Databases</b>\n<ul>\n\n<li><A HREF='http://mobot.mobot.org/cgi-bin/search_pick?name=Ptychomitrium'  TARGET='FLORA_LINK' \n\tTITLE='W3TROPICOS' >W<SUP>3</SUP>TROPICOS</A>\n<li><A HREF='http://www.ipni.org/ipni/IpniServlet?family=&infrafamily=&genus=Ptychomitrium&infragenus=&species=&infraspecies=&author_abbrev=&publication_title=&is_apni_record=on&is_gci_record=on&is_ik_record=on&include_authors=on&include_basionym_authors=on&query_type=by_query'  TARGET='FLORA_LINK' \n\tTITLE='IPNI' >IPNI</A>\n<li><A HREF='http://ravenel.si.edu/botany/ing//INGsearch.cfm?searchWord=Ptychomitrium'  TARGET='FLORA_LINK' \n\tTITLE='ING' >ING Genus Search</A></ul>\n</span></P>\r\n                            </TD>\r\n\t\t</tr>\r\n\t</table>\r\n\t\r\n                        \r\n</div></P>\r\n                    </td>\r\n                  </tr>\r\n                  <tr>\r\n                    <td>\r\n                      <!-- Links -->\r\n                      <P></P>\r\n                      <P><span id=\"lblEditLinks\"><font size=\"2\"></font></span></P>\r\n                      <P>\r\n                        <!-- Comment List --></P>\r\n                    </td>\r\n                  </tr>\r\n                </table>\r\n              </td>\r\n              <TD id=\"tdRightBar\" valign=\"top\"></TD>\r\n\r\n            </tr>\r\n          </table>\r\n        </TD>\r\n      <tr>\r\n        <td>\r\n<table id=\"SubHeaderTableOut\" width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\r\n  <tr>\r\n    <td bgcolor=\"#999999\"><img src=\"~/images/layout/dot.gif\" alt=\"\" width=\"100%\" height=\"1\"></td>\r\n  </tr>\r\n  <tr>\r\n    <TD>\r\n      <table bgcolor=\"#99cc99\" id=\"SubHeaderTable\" width=\"100%\" border=\"0\" cellpadding=\"2\" cellspacing=\"0\">\r\n        <tr>\r\n          <TD align=\"center\" bgColor=\"#ffffcc\">\r\n            &nbsp;|&nbsp;\r\n            <a id=\"ucEfloraFooter_linkHome\" href=\"index.aspx\" target=\"_top\">eFlora Home</a>&nbsp;|&nbsp;\r\n            <a id=\"ucEfloraFooter_linkPeopleSearch\" href=\"person_search.aspx\" target=\"_top\">People Search</a>\r\n            &nbsp;|&nbsp;\r\n            <a id=\"ucEfloraFooter_linkHelp\" href=\"help_page.aspx\" target=\"_top\">Help</a>\r\n            &nbsp;|&nbsp;\r\n            <a id=\"ucEfloraFooter_linkActKey\" href=\"http://flora.huh.harvard.edu/china/ActKey\" target=\"_top\">ActKey</a>\r\n            &nbsp;|&nbsp;\r\n            <a id=\"ucEfloraFooter_Hyperlink2\" href=\"http://flora.huh.harvard.edu/HuCards/\" target=\"_top\">Hu Cards</a>\r\n            &nbsp;|&nbsp;\r\n            <a id=\"ucEfloraFooter_Hyperlink1\" href=\"glossary.aspx\" target=\"_top\">Glossary</a>\r\n            &nbsp;|&nbsp;\r\n          </TD>\r\n        </tr>\r\n      </table>\r\n    </TD>\r\n  </tr>\r\n  <tr>\r\n    <td bgcolor=\"#999999\"><img src=\"~/images/layout/dot.gif\" alt=\"\" width=\"100%\" height=\"1\"></td>\r\n  </tr>\r\n</table>\r\n<p></p>\r\n\r\n</td>\r\n     