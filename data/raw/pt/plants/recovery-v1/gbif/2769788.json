    "descriptions": [
      {
        "description": "Se usa para tratar el sarpullido."
      },
      {
        "description": "Las fibras de las hojas y del escapo floral se usan para elaborar sogas o cuerdas, chilpes, rodapies, lonas, alfombras, carteras, zapatos y bolsos."
      },
      {
        "description": "La raíz y las hojas sirven para elaborar jabón y champú."
      },
      {
        "description": "La infusión de la raíz se usa en casos de enfriamiento."
      },
      {
        "description": "La infusión de la raíz combate hongos de la piel, úlceras, hematomas, inflamación del hígado y dolor estomacal."
      },
      {
        "description": "El escapo floral se usa para elaborar escaleras, corrales para aves, postes y chozas."
      }
