      {
        "id": 509076,
        "taxon_id": 790400,
        "taxon_name": "Orchidinae",
        "taxon_rank": "subtribe",
        "status": "Precautionary (Strict National Protection / Illegal Harvesting Risk)",
        "authority": "Turkish Ministry of Agriculture and Forestry / CITES Appendix II",
        "iucn": 0,
        "url": "",
        "description": "*All wild orchid species in Turkey* are subject to **strict national conservation laws** and **international trade regulations**. Under the *Regulation on Harvesting, Production, and Export of Flower Bulbs* (Official Gazette No. 22371) and the *Turkish Penal Code*, the **unauthorized uprooting, collection, or damaging of wild orchids and their underground parts is strictly prohibited**. As all members of *Orchidinae* are listed under **CITES Appendix II**, and **precise locality data** has been documented to facilitate **illegal extraction in violation of national law**, geoprivacy is **obscured** to ensure compliance with Turkish conservation mandates and to **prevent the unauthorized removal of protected biological resources**.",
        "source_id": null,
        "geoprivacy": "obscured",
