        "passages": [
          {
            "id": "s1:p1",
            "text": "Bulbophyllum annandalei or Annandale's Bulbophyllum is a species of orchid in the genus Bulbophyllum in section Cirrhopetalum. "
          },
          {
            "id": "s1:p2",
            "text": "It is found in peninsular Thailand and Malaysia at elevations of around 1000 meters above sea level."
          },
          {
            "id": "s1:p3",
            "text": "Description\nBulbophyllum annandalei has conical pseudobulbs that each carry a single apical succulent leaf."
          },
          {
            "id": "s1:p4",
            "text": "As with many other species the plant blooms on a flower spike that grows from the base of a pseudobulb. Each flowers spike holds between 2 and 4 small yellow flowers."
          }
        ]
      }
    ]
