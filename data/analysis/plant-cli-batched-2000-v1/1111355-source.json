        "passages": [
          {
            "id": "s1:p1",
            "text": "Lotus castellanus, also known as Flea Grass is a plant in the genus Lotus native from Western France to the Western Mediterranean."
          },
          {
            "id": "s1:p2",
            "text": " Description \nThe flowers of Lotus castellanus are bright yellow on the top and lighter on the bottom."
          },
          {
            "id": "s1:p3",
            "text": "The small, clustered, oval leaves of Lotus castellanus are about four mm with unspaced small hairs."
          },
          {
            "id": "s1:p4",
            "text": "The flowers have a small tooth towards the top with a small white end."
          },
          {
            "id": "s1:p5",
            "text": " Conservation status \nLotus castellanus is not threatened and can be common in some areas."
          }
        ]
      }
    ]
