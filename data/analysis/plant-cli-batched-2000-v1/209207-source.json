        "passages": [
          {
            "id": "s1:p1",
            "text": "Attalea cohune, commonly known as the cohune palm (also rain tree, American oil palm, corozo palm or manaca palm), is a species of palm tree native to Mexico and parts of Central America."
          },
          {
            "id": "s1:p2",
            "text": "The cohune palm is used in the production of cohune oil and its nut can be used as a variety of vegetable ivory."
          },
          {
            "id": "s1:p3",
            "text": "Example occurrences\nA chief occurrence as a dominant plant is in the Belizean pine forests ecoregion."
          }
        ]
      }
    ]
