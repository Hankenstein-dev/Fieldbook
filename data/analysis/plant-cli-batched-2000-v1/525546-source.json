        "passages": [
          {
            "id": "s1:p1",
            "text": "Lavandula canariensis (common name, Canary Island lavender) is a species of flowering plant in the family Lamiaceae, native to the Canary Islands. It was first described by Philip Miller in 1768."
          },
          {
            "id": "s1:p2",
            "text": " Description \nLavandula canariensis is a half-hardy, woody, evergreen shrub. The leaves are bipinnate, rich green, and covered in fine, downy hairs. Flowers appear in spikes of small, fragrant blue, opening from dark purple buds, and are borne on branching stems in summer."
          }
        ]
      }
