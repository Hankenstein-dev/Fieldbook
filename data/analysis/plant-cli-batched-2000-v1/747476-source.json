        "passages": [
          {
            "id": "s1:p1",
            "text": "Euphorbia oxyphylla é uma espécie de planta com flor pertencente à família Euphorbiaceae. "
          },
          {
            "id": "s1:p2",
            "text": "A autoridade científica da espécie é Boiss., tendo sido publicada em Prodromus Systematis Naturalis Regni Vegetabilis 15(2): 1268. 1866."
          },
          {
            "id": "s1:p3",
            "text": " Portugal \nTrata-se de uma espécie presente no território português, nomeadamente em Portugal Continental."
          },
          {
            "id": "s1:p4",
            "text": "Em termos de naturalidade é endémica da Península Ibérica."
          },
          {
            "id": "s1:p5",
            "text": " Protecção \nNão se encontra protegida por legislação portuguesa ou da Comunidade Europeia."
          }
        ]
      }
    ]
