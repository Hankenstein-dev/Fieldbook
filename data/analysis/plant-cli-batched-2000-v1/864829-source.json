        "passages": [
          {
            "id": "s1:p1",
            "text": "Teucrium algarbiense é uma espécie de planta com flor pertencente à família Lamiaceae. "
          },
          {
            "id": "s1:p2",
            "text": "A autoridade científica da espécie é (Cout.) Cout., tendo sido publicada em Esboco Fl. Lenh. Portug. ed. 2: 262. 1936."
          },
          {
            "id": "s1:p3",
            "text": " Portugal \nTrata-se de uma espécie presente no território português, nomeadamente em Portugal Continental."
          },
          {
            "id": "s1:p4",
            "text": "Em termos de naturalidade é endémica da Península Ibérica."
          },
          {
            "id": "s1:p5",
            "text": " Protecção \nNão se encontra protegida por legislação portuguesa ou da Comunidade Europeia."
          }
        ]
      }
    ]
