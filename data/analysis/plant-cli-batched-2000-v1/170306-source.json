        "passages": [
          {
            "id": "s1:p1",
            "text": "Weissia controversa, the green-tufted stubble-moss, is a species of moss in the Pottiaceae family."
          },
          {
            "id": "s1:p2",
            "text": "It is widely found on all continents, except in Antarctica. Weissia controversa is a hermaphroditic species. The plants usually grow to less than 1 cm in height and the spores measure 14–20 μm."
          }
        ]
      }
    ]
