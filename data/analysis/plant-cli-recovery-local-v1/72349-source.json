    "sources": [
      {
        "id": "s1",
        "title": "Sclerochloa",
        "language": "en",
        "scope": "verified_requested_taxon",
        "passages": [
          {
            "id": "s1:p1",
            "text": "Sclerochloa is a genus of Eurasian and North African plants in the grass family. Hardgrass is a common name for plants in this genus."
          },
          {
            "id": "s1:p2",
            "text": "Species"
          },
          {
            "id": "s1:p3",
            "text": "Sclerochloa dura (L.) P.Beauv. - Europe, Asia, and North Africa from Spain + Morocco to Pakistan + Xinjiang; naturalized in Australia + North America\nSclerochloa woronowii (Hack.) Tzvelev - Tajikistan, Afghanistan, Iraq, Syria, Caucasus, Turkey"
          },
          {
            "id": "s1:p4",
            "text": "Formerly included"
          },
          {
            "id": "s1:p5",
            "text": "numerous species now considered better suited to other genera: Catapodium Cutandia Desmazeria Festuca Poa Puccinellia Sphenopus"
          }
        ]
      },
      {
        "id": "s2",
        "title": "Sclerochloa",
        "language": "pt",
        "scope": "verified_requested_taxon",
        "passages": [
          {
            "id": "s2:p1",
            "text": "{{Info/Taxonomia\n |nome =Sclerochloa\n |imagem = Sclerochloadura.jpg\n |reino = [[Plantae]]\n |divisão = [[Magnoliophyta]]\n |classe = [[Liliopsida]]\n |ordem = [[Poales]]\n |família = [[Poaceae]]\n |género = '''''Sclerochloa'''''\n |subdivisão_nome = Espécies\n |subdivisão =\n<center>\n}}"
          },
          {
            "id": "s2:p2",
            "text": "Sclerochloa é um género botânico pertencente à família Poaceae."
          },
          {
            "id": "s2:p3",
            "text": "{{Esboço-gramínea}}"
          }
        ]
      }
