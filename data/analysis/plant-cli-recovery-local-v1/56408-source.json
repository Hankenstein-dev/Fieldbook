        "scope": "verified_requested_taxon",
        "passages": [
          {
            "id": "s1:p1",
            "text": "Reboulia hemisphaerica, the hemisphaeric liverwort or small mushroom-headed liverwort, is the only species of liverwort in the genus Reboulia."
          },
          {
            "id": "s1:p2",
            "text": "A possible second species Reboulia queenslandica (Stephani) M. Hicks was published in 1992, but it was later determined to be a polyploid cross between two varieties of R. hemisphaerica, so not a distinct species. Subsequent lists and publications do not recognize it as distinct."
          },
          {
            "id": "s1:p3",
            "text": "Riccardin C is a phenolic cyclic bibenzyl secondary metabolite isolated from R. hemisphaerica, as is marchantinquinone."
          }
        ]
      }
    ]
  },
