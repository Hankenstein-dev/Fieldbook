      {
        "id": "s2",
        "title": "Torilis leptophylla",
        "language": "pt",
        "scope": "verified_requested_taxon",
        "passages": [
          {
            "id": "s2:p1",
            "text": "{{Título em itálico}}\n{{Info/Taxonomia\n| nome = ''Torilis leptophylla''\n| imagem = Torilis lepthophylla - 02052010.jpg\n| imagem_legenda = \n| reino = [[Plantae]]\n| clado1 = [[Angiosperma|angiospérmicas]]\n| clado2 = [[Eudicotiledôneas|eudicotiledóneas]]\n| clado3 = \n| ordem = [[Umbellales]]\n| família = [[Apiaceae]]\n| género = ''[[Torilis]]''\n| espécie = '''''T. leptophylla'''''\n| binomial = ''Torilis leptophylla''\n| binomial_autoridade = (L.) Rchb.f.\n}}\nTorilis leptophylla é uma espécie de planta com flor pertencente à família Apiaceae."
          },
          {
            "id": "s2:p2",
            "text": "A autoridade científica da espécie é (L.) Rchb.f., tendo sido publicada em Icones florae germanicae et helveticae 21: 83, t. 169."
          },
          {
            "id": "s2:p3",
            "text": " Portugal "
          },
          {
            "id": "s2:p4",
            "text": "Trata-se de uma espécie presente no território português, nomeadamente em Portugal Continental."
          },
          {
            "id": "s2:p5",
            "text": "Em termos de naturalidade é nativa da região atrás indicada."
          },
          {
            "id": "s2:p6",
            "text": " Protecção "
          },
          {
            "id": "s2:p7",
            "text": "Não se encontra protegida por legislação portuguesa ou da Comunidade Europeia."
          }
        ]
      }
    ]
  },
