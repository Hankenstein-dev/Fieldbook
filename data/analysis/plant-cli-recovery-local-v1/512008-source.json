        "passages": [
          {
            "id": "s1:p1",
            "text": "Orobanche densiflora is a species of plant in the family Orobanchaceae. O. densiflora f. melitensis was reputed to be endemic to Malta however such information is not corroborated by recent accounts."
          }
        ]
      },
      {
        "id": "s2",
        "title": "Orobanche densiflora",
        "language": "pt",
        "scope": "verified_requested_taxon",
        "passages": [
          {
            "id": "s2:p1",
            "text": "{{Título em itálico}}\n{{Info/Taxonomia\n| nome = ''Orobanche densiflora''\n| imagem = \n| imagem_legenda = \n| reino = [[Plantae]]\n| clado1 = [[angiospérmicas]]\n| clado2 = [[eudicotiledóneas]]\n| clado3 = \n| ordem = [[Scrophulariales]]\n| família = [[Orobanchaceae]]\n| género = ''[[Orobanche]]''\n| espécie = '''''O. densiflora'''''\n| binomial = ''Orobanche densiflora''\n| binomial_autoridade = Salzm. ex Reut.\n}}\nOrobanche densiflora é uma espécie de planta com flor pertencente à família Orobanchaceae. "
          },
          {
            "id": "s2:p2",
            "text": "A autoridade científica da espécie é Salzm. ex Reut., tendo sido publicada em Prodr. [A. P. de Candolle] 11: 19. 1847."
          },
          {
            "id": "s2:p3",
            "text": " Portugal "
          },
          {
            "id": "s2:p4",
            "text": "Trata-se de uma espécie presente no território português, nomeadamente em Portugal Continental."
          },
          {
            "id": "s2:p5",
            "text": "Em termos de naturalidade é nativa da região atrás indicada."
          },
          {
            "id": "s2:p6",
            "text": " Protecção "
          },
          {
            "id": "s2:p7",
            "text": "Não se encontra protegida por legislação portuguesa ou da Comunidade Europeia."
          }
        ]
      }
    ]
  },
