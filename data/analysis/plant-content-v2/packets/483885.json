        "passages": [
          {
            "id": "s1:p1",
            "text": "Medicago intertexta, the hedgehog medick, Calvary clover, or Calvary medick, is a flowering plant of the family Fabaceae. It is found primarily in the western Mediterranean basin. It forms a symbiotic relationship with the bacterium Sinorhizobium medicae, which is capable of nitrogen fixation."
          },
          {
            "id": "s1:p2",
            "text": "A form with red-blotched leaves was formerly much grown as a garden plant.{{Citation needed|date=November 2008}}"
          }
        ]
      }
    ]
