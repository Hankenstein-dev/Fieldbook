        "title": "Flora-On — Sanguisorba hybrida",
        "language": "pt",
        "scope": "requested_taxon_regional_habitat_Portugal",
        "passages": [
          {
            "id": "s2:p1",
            "text": "Flora-On botanical account for Sanguisorba hybrida. Geographic scope: Portugal; habitat descriptions and native status on this site refer to Portugal, not the global native range."
          },
          {
            "id": "s2:p2",
            "text": "Ecologia Em bosques, sobreirais e azinhais, sempre em sítios frescos, algo sombrios e algo húmidos. Por vezes perto de linhas de água."
          },
          {
            "id": "s2:p3",
            "text": "Endémica de Península Ibérica"
          },
          {
            "id": "s2:p4",
            "text": "Características a confirmar -Caules com pêlos glandulosos."
          },
          {
            "id": "s2:p5",
            "text": "Ligações externas Descrição na Flora Iberica"
          },
          {
            "id": "s2:p6",
            "text": "Distância ao mar (n=239)"
          },
          {
            "id": "s2:p7",
            "text": "Preferências bioclimáticas explorar gráficos carregando... carregando..."
          },
          {
            "id": "s2:p8",
            "text": "Espécies com distribuição semelhante Cistus crispus , Rhamnus alaternus , Pistacia lentiscus , Erophaca baetica , Smilax aspera , Pulicaria odora , Urginea maritima ver todas"
          },
          {
            "id": "s2:p9",
            "text": "Tipo biológico Hemicriptófito"
          }
        ]
      }
