        "passages": [
          {
            "id": "s1:p1",
            "text": "Colombia a Perú"
          },
          {
            "id": "s1:p2",
            "text": "Andes"
          },
          {
            "id": "s1:p3",
            "text": "2200 - 3600 msnm"
          },
          {
            "id": "s1:p4",
            "text": "Se usa como juguete."
          },
          {
            "id": "s1:p5",
            "text": "Se usa como instrumento musical."
          },
          {
            "id": "s1:p6",
            "text": "Las hojas sirven para tratar la inflamación por golpes, tumores y el reumatismo."
          },
          {
            "id": "s1:p7",
            "text": "La flor, en infusión, se usa para tratar el “chuchaqui”."
          },
          {
            "id": "s1:p8",
            "text": "La flor, en infusión, se usa para tratar el dolor de hígado."
          },
          {
            "id": "s1:p9",
            "text": "La flor se usa para tratar la sarna y los hongos del pie."
          },
          {
            "id": "s1:p10",
            "text": "La corteza, en infusión, es utilizada para tratar la diarrea y la fiebre."
          },
          {
            "id": "s1:p11",
            "text": "El tallo, sin médula, se utiliza como aventador, para soplar y avivar el fuego."
          },
          {
            "id": "s1:p12",
            "text": "El tallo y las hojas contienen un látex de color blanco, el que por evaporación produce goma de mascar de gran calidad."
          },
          {
            "id": "s1:p13",
            "text": "El tallo seco sirve como combustible."
          },
          {
            "id": "s1:p14",
            "text": "El tallo se usa para entablillar animales enfermos."
          },
          {
            "id": "s1:p15",
            "text": "El tallo inmaduro es usado en la construcción de cercas y viviendas."
          },
          {
            "id": "s1:p16",
            "text": "El tallo hueco se usaba como tubo de bocina."
          },
          {
            "id": "s1:p17",
            "text": "El tallo hueco se usa para elaborar cerbatanas (en especial lo usan los niños)."
          }
        ]
      }
    ]
