        "scope": "verified_requested_taxon",
        "passages": [
          {
            "id": "s1:p1",
            "text": "Vulpia bromoides, squirreltail fescue,{{rp|170–171}} barren fescue{{rp|450}} or brome fescue, is a species of grass in the family Poaceae. It is a winter annual native to Europe, North Africa, and West Asia, but has been introduced to parts of the America, South Africa, Australia, New Zealand and isolated parts of East Asia."
          }
        ]
