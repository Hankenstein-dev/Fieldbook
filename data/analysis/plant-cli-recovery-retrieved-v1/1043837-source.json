        "scope": "verified_requested_taxon",
        "passages": [
          {
            "id": "s1:p1",
            "text": "Chrysojasminum odoratissimum is een plantensoort uit de olijffamilie (Oleaceae). Het is bladverliezende struik met gele bloemen. Deze bloemen hebben een sterk zoetgeurend parfum."
          },
          {
            "id": "s1:p2",
            "text": "De soort komt voor op Madeira en op de Canarische Eilanden. "
          },
          {
            "id": "s1:p3",
            "text": "De bloemen worden elke ochtend kort na het openen van de bloemen geplukt. De geplukte bloemen worden vers gebruikt voor oliewinning. De uit de bloemen afkomstige etherische olie wordt gebruikt in de parfumerie."
          },
          {
            "id": "s1:p4",
            "text": " Synoniemen \n Jasminum augeronii A.Cabrera\n Jasminum barrelieri Webb & Berthel.\n Jasminum gomeraeum Gand.\n Jasminum odoratissimum L.\n Jasminum odorum Salisb."
          },
          {
            "id": "s1:p5",
            "text": "thumb|left|Bloemen"
          },
          {
            "id": "s1:p6",
            "text": "{{Appendix}}"
          },
          {
            "id": "s1:p7",
            "text": "Categorie:Oleaceae"
          }
        ]
      }
    ]
