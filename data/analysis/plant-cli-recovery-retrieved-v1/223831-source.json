        "scope": "verified_requested_taxon",
        "passages": [
          {
            "id": "s1:p1",
            "text": "{{Título em itálico}}\n{{Info/Taxonomia\n| nome = ''Linaria incarnata''\n| imagem = Linaria incarnata flowerhead2 (14446625397).jpg\n| imagem_legenda = \n| reino = [[Plantae]]\n| clado1 = [[angiospérmicas]]\n| clado2 = [[eudicotiledóneas]]\n| clado3 = \n| ordem = [[Scrophulariales]]\n| família = [[Scrophulariaceae]]\n| género = ''[[Linaria]]''\n| espécie = '''''L. incarnata'''''\n| binomial = ''Linaria incarnata''\n| binomial_autoridade = (Vent.) Spreng.\n}}\nLinaria incarnata é uma espécie de planta com flor pertencente à família Scrophulariaceae. "
          },
          {
            "id": "s1:p2",
            "text": "A autoridade científica da espécie é (Vent.) Spreng., tendo sido publicada em Systema Vegetabilium, editio decima sexta 2: 796. 1825."
          },
          {
            "id": "s1:p3",
            "text": " Portugal "
          },
          {
            "id": "s1:p4",
            "text": "Trata-se de uma espécie presente no território português, nomeadamente em Portugal Continental."
          },
          {
            "id": "s1:p5",
            "text": "Em termos de naturalidade é nativa da região atrás indicada."
          },
          {
            "id": "s1:p6",
            "text": " Protecção "
          },
          {
            "id": "s1:p7",
            "text": "Não se encontra protegida por legislação portuguesa ou da Comunidade Europeia."
          }
        ]
      },
