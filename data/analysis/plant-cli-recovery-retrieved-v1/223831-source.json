        "passages": [
          {
            "id": "s3:p1",
            "text": "Flora-On botanical account for Linaria incarnata. Geographic scope: Portugal; habitat descriptions and native status on this site refer to Portugal, not the global native range."
          },
          {
            "id": "s3:p2",
            "text": "Ecologia Pousios, pastagens e prados secos. Em solo ácido, geralmente arenoso."
          },
          {
            "id": "s3:p3",
            "text": "Ligações externas Descrição na Flora Iberica"
          },
          {
            "id": "s3:p4",
            "text": "Distância ao mar (n=124)"
          },
          {
            "id": "s3:p5",
            "text": "Preferências bioclimáticas explorar gráficos carregando... carregando..."
          },
          {
            "id": "s3:p6",
            "text": "Espécies com distribuição semelhante Fraxinus angustifolia , Briza maxima , Mentha suaveolens , Quercus rotundifolia , Oenanthe crocata , Andryala integrifolia , Crataegus monogyna ver todas"
          },
          {
            "id": "s3:p7",
            "text": "Tipo biológico Terófito"
          }
        ]
