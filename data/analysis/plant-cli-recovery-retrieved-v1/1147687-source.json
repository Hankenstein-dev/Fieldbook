      {
        "id": "s1",
        "title": "Astragalus cymbaecarpos",
        "language": "pt",
        "scope": "verified_requested_taxon",
        "passages": [
          {
            "id": "s1:p1",
            "text": "Astragalus cymbaecarpos, saveirinho, é uma espécie de planta com flor pertencente à família Fabaceae."
          },
          {
            "id": "s1:p2",
            "text": "A autoridade científica da espécie é Brot., tendo sido publicada em Phytogr. Lusit. Select. 63 (1800)."
          },
          {
            "id": "s1:p3",
            "text": " Portugal "
          },
          {
            "id": "s1:p4",
            "text": "Trata-se de uma espécie presente no território português, nomeadamente em Portugal Continental."
          },
          {
            "id": "s1:p5",
            "text": "Em termos de naturalidade é nativa da região atrás indicada."
          },
          {
            "id": "s1:p6",
            "text": " Protecção "
          },
          {
            "id": "s1:p7",
            "text": "Não se encontra protegida por legislação portuguesa ou da Comunidade Europeia."
          }
        ]
      },
      {
        "id": "s2",
        "title": "Flora-On — Astragalus cymbaecarpos",
        "language": "pt",
        "scope": "requested_taxon_regional_habitat_Portugal",
        "passages": [
          {
            "id": "s2:p1",
            "text": "Flora-On botanical account for Astragalus cymbaecarpos. Geographic scope: Portugal; habitat descriptions and native status on this site refer to Portugal, not the global native range."
          },
          {
            "id": "s2:p2",
            "text": "Ecologia Prados e pastagens em solos pobres, pedregosos ou arenosos, ácidos e algo húmidos."
          },
          {
            "id": "s2:p3",
            "text": "Ligações externas Descrição na Flora Iberica"
          },
          {
            "id": "s2:p4",
            "text": "Distância ao mar (n=53)"
          },
          {
            "id": "s2:p5",
            "text": "Preferências bioclimáticas explorar gráficos carregando... carregando..."
          },
          {
            "id": "s2:p6",
            "text": "Espécies com distribuição semelhante Centaurea ornata , Sanguisorba verrucosa , Hymenocarpos lotoides , Fraxinus angustifolia , Ornithopus compressus , Quercus rotundifolia , Briza maxima ver todas"
          },
          {
            "id": "s2:p7",
            "text": "Tipo biológico Terófito"
          }
        ]
      }
    ]
  },
