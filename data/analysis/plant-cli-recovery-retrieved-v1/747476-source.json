        "passages": [
          {
            "id": "s1:p1",
            "text": "Euphorbia oxyphylla é uma espécie de planta com flor pertencente à família Euphorbiaceae. "
          },
          {
            "id": "s1:p2",
            "text": "A autoridade científica da espécie é Boiss., tendo sido publicada em Prodromus Systematis Naturalis Regni Vegetabilis 15(2): 1268. 1866."
          },
          {
            "id": "s1:p3",
            "text": " Portugal \nTrata-se de uma espécie presente no território português, nomeadamente em Portugal Continental."
          },
          {
            "id": "s1:p4",
            "text": "Em termos de naturalidade é endémica da Península Ibérica."
          },
          {
            "id": "s1:p5",
            "text": " Protecção \nNão se encontra protegida por legislação portuguesa ou da Comunidade Europeia."
          }
        ]
      },
      {
        "id": "s2",
        "title": "Flora-On — Euphorbia oxyphylla",
        "language": "pt",
        "scope": "requested_taxon_regional_habitat_Portugal",
        "passages": [
          {
            "id": "s2:p1",
            "text": "Flora-On botanical account for Euphorbia oxyphylla. Geographic scope: Portugal; habitat descriptions and native status on this site refer to Portugal, not the global native range."
          },
          {
            "id": "s2:p2",
            "text": "Ecologia Clareiras de matos, frequentemente estevais, giestais e azinhais abertos, também em bermas de caminhos e taludes. Em solos algo revolvidos ou pedregosos, ácidos."
          },
          {
            "id": "s2:p3",
            "text": "Observações Espécie com um látex particularmente tóxico."
          },
          {
            "id": "s2:p4",
            "text": "Endémica de Península Ibérica"
          },
          {
            "id": "s2:p5",
            "text": "Ligações externas Descrição na Flora Iberica"
          },
          {
            "id": "s2:p6",
            "text": "Distância ao mar (n=354)"
          },
          {
            "id": "s2:p7",
            "text": "Preferências bioclimáticas explorar gráficos carregando... carregando..."
          },
          {
            "id": "s2:p8",
            "text": "Espécies com distribuição semelhante Cytisus multiflorus , Cnicus benedictus , Quercus pyrenaica , Geranium lucidum , Fraxinus angustifolia , Sedum brevifolium , Eryngium tenue ver todas"
          },
          {
            "id": "s2:p9",
            "text": "Tipo biológico Caméfito"
          }
        ]
      }
    ]
