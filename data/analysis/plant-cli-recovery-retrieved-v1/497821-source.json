        "passages": [
          {
            "id": "s1:p1",
            "text": "{{Título em itálico}}\n{{Info/Taxonomia\n| nome = ''Centaurea aristata''\n| imagem = \n| imagem_legenda = \n| reino = [[Plantae]]\n| clado1 = [[angiospérmicas]]\n| clado2 = [[eudicotiledóneas]]\n| clado3 = \n| ordem = [[Asterales]]\n| família = [[Asteraceae]]\n| género = ''[[Centaurea]]''\n| espécie = '''''C. aristata'''''\n| binomial = ''Centaurea aristata''\n| binomial_autoridade = Hoffmanns. & Link\n}}\nCentaurea aristata é uma espécie de planta com flor pertencente à família Asteraceae. "
          },
          {
            "id": "s1:p2",
            "text": "A autoridade científica da espécie é Hoffmanns. & Link, tendo sido publicada em Fl. Portug. (Hoffmannsegg) 2: 226. (1820-1834)."
          },
          {
            "id": "s1:p3",
            "text": " Portugal "
          },
          {
            "id": "s1:p4",
            "text": "Trata-se de uma espécie presente no território português, nomeadamente em Portugal Continental."
          },
          {
            "id": "s1:p5",
            "text": "Em termos de naturalidade é endémica da Península Ibérica."
          },
          {
            "id": "s1:p6",
            "text": " Protecção "
          },
          {
            "id": "s1:p7",
            "text": "Não se encontra protegida por legislação portuguesa ou da Comunidade Europeia."
          }
        ]
      },
