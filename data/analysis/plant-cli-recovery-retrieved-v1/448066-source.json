    "sources": [
      {
        "id": "s1",
        "title": "錦帶花",
        "language": "zh",
        "scope": "verified_requested_taxon",
        "passages": [
          {
            "id": "s1:p1",
            "text": "{{japanese|japanese=タニウツギ|kana=タニウツギ|romaji=Taniutsugi}}"
          },
          {
            "id": "s1:p2",
            "text": "錦帶花（學名：）為忍冬科之一種美丽的观赏植物。"
          },
          {
            "id": "s1:p3",
            "text": "形态\n落叶直立灌木。叶子对生，椭圆形或卵状长椭圆形，表面仅中脉上有毛，背面脉上有柔毛或绒毛；花期於5～6月之際開出外面蔷薇紅色里面较淡的花，喇叭狀花冠，1-4朵成聚伞花序。"
          },
          {
            "id": "s1:p4",
            "text": "分布\n插秧時期開花，故而以「田植花」知名。梅雨時期通過山道時，錦帶花朵在欣欣向榮的新綠花草之中呈粉紅色明顯易見。"
          },
          {
            "id": "s1:p5",
            "text": "北海道西部、本州日本海側中心生長之落葉低木，沿著山地谷斜面經常可以見到。多用在庭園等之植栽作為鑑賞目的之用。"
          },
          {
            "id": "s1:p6",
            "text": "參考文獻\nFlowering Plants of the World, [1987], Vernon H. Heywood, Andromeda Oxford Ltd., ISBN 90-5210-165-5"
          },
          {
            "id": "s1:p7",
            "text": "關連項目\n金銀花"
          },
          {
            "id": "s1:p8",
            "text": "外部連結\nWeigela hortensis {{Wayback|url=http://www.flickr.com/photos/brucewood/2052238530/ |date=20190701135530 }}"
          },
          {
            "id": "s1:p9",
