          {
            "id": "s1:p3",
            "text": " Underarter "
          },
          {
            "id": "s1:p4",
            "text": "Arten delas in i följande underarter:"
          },
          {
            "id": "s1:p5",
            "text": " C. h. grandiflorus\n C. h. hybridus\n C. h. australis\n C. h. secallianus"
          },
          {
            "id": "s1:p6",
            "text": " Källor "
          },
          {
