      },
      {
        "id": "s2",
        "title": "Cistus × hybridus Pourr. — Plants of the World Online",
        "language": "en",
        "scope": "requested_taxon_Kew_account",
        "passages": [
          {
            "id": "s2:p1",
            "text": "Plants of the World Online account: Cistus × hybridus Pourr.."
          },
          {
            "id": "s2:p2",
            "text": "The native range of this hybrid is W. Medit. It is a shrub and grows primarily in the subtropical biome. The hybrid formula is C. populifolius × C. salviifolius."
          }
        ]
