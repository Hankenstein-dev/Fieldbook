          {
            "id": "s1:p1",
            "text": "{{Título em itálico}}\n{{Info/Taxonomia\n| nome = ''Blackstonia imperfoliata''\n| imagem = \n| imagem_legenda = \n| reino = [[Plantae]]\n| clado1 = [[angiospérmicas]]\n| clado2 = [[eudicotiledóneas]]\n| clado3 = \n| ordem = [[Gentianales]]\n| família = [[Gentianaceae]]\n| género = ''[[Blackstonia]]''\n| espécie = '''''B. imperfoliata'''''\n| binomial = ''Blackstonia imperfoliata''\n| binomial_autoridade = (L.f.) Samp.\n}}\nBlackstonia imperfoliata é uma espécie de planta com flor pertencente à família Gentianaceae. "
          },
          {
            "id": "s1:p2",
            "text": "A autoridade científica da espécie é (L.f.) Samp., tendo sido publicada em Herbário Português 105. 1913."
          },
          {
            "id": "s1:p3",
            "text": " Portugal "
          },
          {
            "id": "s1:p4",
            "text": "Trata-se de uma espécie presente no território português, nomeadamente em Portugal Continental."
          },
          {
            "id": "s1:p5",
            "text": "Em termos de naturalidade é nativa da região atrás indicada."
          },
          {
            "id": "s1:p6",
            "text": " Protecção "
          },
          {
            "id": "s1:p7",
            "text": "Não se encontra protegida por legislação portuguesa ou da Comunidade Europeia."
          }
        ]
