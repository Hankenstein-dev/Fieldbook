    "sources": [
      {
        "id": "s1",
        "title": "Hypericum linariifolium",
        "language": "pt",
        "scope": "verified_requested_taxon",
        "passages": [
          {
            "id": "s1:p1",
            "text": "Hypericum linariifolium é uma espécie de planta com flor pertencente à família Hypericaceae. "
          },
          {
            "id": "s1:p2",
            "text": "A autoridade científica da espécie é Vahl, tendo sido publicada em Symb. Bot. (Vahl) 1: 65. 1790."
          },
          {
            "id": "s1:p3",
            "text": " Portugal "
          },
          {
            "id": "s1:p4",
            "text": "Trata-se de uma espécie presente no território português, nomeadamente em Portugal Continental e no Arquipélago da Madeira."
          },
          {
            "id": "s1:p5",
            "text": "Em termos de naturalidade é nativa das duas regiões atrás indicadas."
          },
          {
            "id": "s1:p6",
            "text": " Protecção "
          },
          {
            "id": "s1:p7",
            "text": "Não se encontra protegida por legislação portuguesa ou da Comunidade Europeia."
          }
        ]
      },
      {
        "id": "s2",
        "title": "Flora-On — Hypericum linariifolium",
        "language": "pt",
        "scope": "requested_taxon_regional_habitat_Portugal",
        "passages": [
          {
            "id": "s2:p1",
            "text": "Flora-On botanical account for Hypericum linariifolium. Geographic scope: Portugal; habitat descriptions and native status on this site refer to Portugal, not the global native range."
          },
          {
            "id": "s2:p2",
            "text": "Ecologia Clareiras de matos (urzais-tojais, giestais). Em solos pobres e ácidos."
          },
          {
            "id": "s2:p3",
            "text": "Características a confirmar -Folhas revolutas, isto é, com a margem enrolada para baixo."
          },
          {
            "id": "s2:p4",
            "text": "Ligações externas Descrição na Flora Iberica"
          },
          {
            "id": "s2:p5",
            "text": "Distância ao mar (n=555)"
          },
          {
            "id": "s2:p6",
            "text": "Preferências bioclimáticas explorar gráficos carregando... carregando..."
          },
          {
            "id": "s2:p7",
            "text": "Espécies com distribuição semelhante Castanea sativa , Arenaria montana , Sedum brevifolium , Chelidonium majus , Cytisus striatus , Viola riviniana , Quercus pyrenaica ver todas"
          },
          {
            "id": "s2:p8",
            "text": "Tipo biológico Hemicriptófito"
          }
        ]
      }
    ]
  },
