        "passages": [
          {
            "id": "s2:p1",
            "text": "Flora-On botanical account for Nonea vesicaria. Geographic scope: Portugal; habitat descriptions and native status on this site refer to Portugal, not the global native range."
          },
          {
            "id": "s2:p2",
            "text": "Ecologia Em prados arvenses, pastagens, campos agrícolas, cultivados ou incultos e bermas de caminhos. Preferentemente em solos básicos, mas também pode ocorrer em solos ácidos. Com alguma preferência por solos algo perturbados e nitrofilizados."
          },
          {
            "id": "s2:p3",
            "text": "Tipo biológico Terófito , Hemicriptófito"
          },
          {
            "id": "s2:p4",
            "text": "Não confundir com Anchusa undulata subsp. granatensis | como distinguir?"
          },
          {
            "id": "s2:p5",
            "text": "Ligações externas Descrição na Flora Iberica"
          },
          {
            "id": "s2:p6",
            "text": "Distância ao mar (n=241)"
          },
          {
            "id": "s2:p7",
            "text": "Preferências bioclimáticas explorar gráficos carregando... carregando..."
          },
          {
            "id": "s2:p8",
            "text": "Espécies com distribuição semelhante Gynandriris sisyrinchium , Atractylis cancellata , Silene colorata , Cynara humilis , Cynara cardunculus , Scolymus maculatus , Centaurea pullata ver todas"
          }
        ]
      }
