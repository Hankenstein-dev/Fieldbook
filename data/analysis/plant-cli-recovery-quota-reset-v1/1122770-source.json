        "passages": [
          {
            "id": "s1:p1",
            "text": "Flexitrichum is a genus of haplolepideous mosses (Dicranidae) in the family Flexitrichaceae."
          },
          {
            "id": "s1:p2",
            "text": "Species\nThe genus contains two species:"
          },
          {
            "id": "s1:p3",
            "text": "Flexitrichum flexicaule {{small|(Schwägr.) Ignatov & Fedosov}}\nFlexitrichum gracile {{small|(Mitt.) Ignatov & Fedosov}}"
          },
          {
            "id": "s1:p4",
            "text": "These species were previously considered members of the genus Ditrichum in the family Ditrichaceae, either as two species or both included in Ditrichum flexicaule."
          }
        ]
      }
    ]
