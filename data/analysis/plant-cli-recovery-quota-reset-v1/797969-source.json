        "passages": [
          {
            "id": "s1:p1",
            "text": "Trihesperus is a small genus of flowering plants in the family Asparagaceae, generally found in the Andes of Colombia, Ecuador, Peru, Bolivia, and northwest Argentina. Veitch Nurseries developed a cultivar of Trihesperus latifolius with striped foliage which they called Anthericum latifolium albo media pictum."
          },
          {
            "id": "s1:p2",
            "text": "Species\nCurrently accepted species include:"
          },
          {
            "id": "s1:p3",
            "text": "Trihesperus glaucus (Ruiz & Pav.) Herb.\nTrihesperus latifolius (Kunth) Herb."
          }
        ]
      }
    ]
  },
