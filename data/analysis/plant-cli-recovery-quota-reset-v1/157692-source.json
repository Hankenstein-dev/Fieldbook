        "scope": "verified_requested_taxon",
        "passages": [
          {
            "id": "s1:p1",
            "text": "Lejeunea is a genus of leafy liverworts in the Lejeuneaceae family. The GBIF lists up to 592 species (as of October 2022), along with a worldwide distribution. World Flora Online lists up to 531 species (as of July 2023)."
          },
          {
            "id": "s1:p2",
            "text": "The genus was circumscribed by Marie-Anne Libert in Ann. Gen. Sci. Phys. vol.6 on page 372 in 1820."
          },
          {
            "id": "s1:p3",
            "text": "The genus name of Lejeunea is in honour of Alexandre Louis Simon Lejeune (1779–1858), who was a Belgian physician and botanist. "
          },
          {
            "id": "s1:p4",
            "text": " Selected species \n Lejeunea cavifolia (Ehrh.) Lindb.\n Lejeunea drehwaldii Heinrichs & Schäf.-Verw.\n Lejeunea flava (Sw.) Nees\n Lejeunea hodgsoniana\n Lejeunea sordida - Sri Lanka"
          },
          {
            "id": "s1:p5",
            "text": "See List of Lejeunea species"
          }
        ]
      }
    ]
  },
