        "passages": [
          {
            "id": "s1:p1",
            "text": "Senna polyphylla är en ärtväxtart som först beskrevs av Nikolaus Joseph von Jacquin, och fick sitt nu gällande namn av Howard Samuel Irwin och Rupert Charles Barneby. Senna polyphylla ingår i släktet sennor, och familjen ärtväxter. "
          },
          {
            "id": "s1:p2",
            "text": " Underarter "
          },
          {
            "id": "s1:p3",
            "text": "Arten delas in i följande underarter:"
          },
          {
            "id": "s1:p4",
            "text": " S. p. montis-christi\n S. p. neglecta\n S. p. polyphylla"
          },
          {
            "id": "s1:p5",
            "text": " Bildgalleri "
          },
          {
            "id": "s1:p6",
            "text": " Källor "
          },
          {
            "id": "s1:p7",
            "text": " Externa länkar "
          },
          {
            "id": "s1:p8",
            "text": "Kategori:Sennor\npolyphylla"
          }
        ]
      },
      {
        "id": "s2",
        "title": "Senna polyphylla (Jacq.) H.S.Irwin & Barneby — Plants of the World Online",
        "language": "en",
        "scope": "requested_taxon_Kew_account",
        "passages": [
          {
            "id": "s2:p1",
            "text": "Plants of the World Online account: Senna polyphylla (Jacq.) H.S.Irwin & Barneby."
          },
          {
            "id": "s2:p2",
            "text": "The native range of this species is Mexico to Honduras, Caribbean to Venezuela, E. Brazil. It is a shrub or tree and grows primarily in the wet tropical biome."
          }
        ]
