        ]
      },
      {
        "id": "s2",
        "title": "Flora-On — Thymelaea salsa",
        "language": "pt",
        "scope": "requested_taxon_regional_habitat_Portugal",
        "passages": [
          {
            "id": "s2:p1",
            "text": "Flora-On botanical account for Thymelaea salsa. Geographic scope: Portugal; habitat descriptions and native status on this site refer to Portugal, not the global native range."
          },
          {
            "id": "s2:p2",
            "text": "Ecologia Comunidades arvenses de sequeiro, em solos básicos. Em Portugal, conhecida apenas em olival tradicional de sequeiro."
          },
          {
            "id": "s2:p3",
            "text": "Não confundir com Distingue-se das outras Thymelaea anuais por ter as flores sempre dispostas em número de três por nó, sendo a central masculina e as duas laterais femininas, e pela dimensão das flores (masculinas e femininas), que são minúsculas, menores que 2 mm."
          },
          {
            "id": "s2:p4",
            "text": "Ligações externas Descrição na Flora Iberica"
          },
          {
            "id": "s2:p5",
            "text": "Distância ao mar (n=22)"
          },
          {
            "id": "s2:p6",
            "text": "Preferências bioclimáticas explorar gráficos carregando... carregando..."
          },
          {
            "id": "s2:p7",
            "text": "Espécies com distribuição semelhante Linaria ricardoi , Phalaris canariensis , Galium viscosum , Cynara tournefortii , Linaria hirta , Biarum mendax , Linaria micrantha ver todas"
          },
          {
            "id": "s2:p8",
            "text": "Tipo biológico Terófito"
          }
        ]
      }
    ]
  },
