          {
            "id": "s1:p1",
            "text": "{{Título em itálico}}\n{{Info/Taxonomia\n| nome = ''Zannichellia peltata''\n| imagem = \n| imagem_legenda = \n| reino = [[Plantae]]\n| clado1 = [[angiospérmicas]]\n| clado2 = [[monocotiledóneas]]\n| clado3 = \n| ordem = [[Najadales]]\n| família = [[Zannichelliaceae]]\n| género = ''[[Zannichellia]]''\n| espécie = '''''Z. peltata'''''\n| binomial = ''Zannichellia peltata''\n| binomial_autoridade = Bertol.\n}}\nZannichellia peltata é uma espécie de planta com flor pertencente à família Zannichelliaceae. "
          },
          {
            "id": "s1:p2",
            "text": "A autoridade científica da espécie é Bertol., tendo sido publicada em Fl. Ital. (Bertoloni) x. 10."
          },
          {
            "id": "s1:p3",
            "text": " Portugal "
          },
          {
            "id": "s1:p4",
            "text": "Trata-se de uma espécie presente no território português, nomeadamente em Portugal Continental."
          },
          {
            "id": "s1:p5",
            "text": "Em termos de naturalidade é nativa da região atrás indicada."
          },
          {
            "id": "s1:p6",
            "text": " Protecção "
          },
          {
            "id": "s1:p7",
            "text": "Não se encontra protegida por legislação portuguesa ou da Comunidade Europeia."
          }
        ]
      },
