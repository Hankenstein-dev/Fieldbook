        "passages": [
          {
            "id": "s1:p1",
            "text": "Helenieae is a tribe of flowering plants in the family Asteraceae. The type genus is Helenium; among the best-known members of the tribe is Gaillardia. Helenieae is usually treated as a distinct tribe, though some authors subsume it and several related tribes as subtribes within a broader circumscription of Heliantheae."
          },
          {
            "id": "s1:p2",
            "text": " Subtribes and genera "
          },
          {
            "id": "s1:p3",
            "text": "Subtribes and genera of Helenieae recognised by the Global Compositae Database:"
          },
          {
            "id": "s1:p4",
            "text": " Subtribe Gaillardiinae {{small|Less.}}\n Balduina {{small|Nutt.}}\n Gaillardia {{small|Foug.}}\n Helenium {{small|L.}}"
          },
          {
            "id": "s1:p5",
            "text": " Subtribe Marshalliinae {{small|H.Rob.}}\n Marshallia {{small|Schreb.}}"
          },
          {
            "id": "s1:p6",
            "text": " Subtribe Plateileminae {{small|B.G.Baldwin}}\n Plateilema {{small|(A.Gray) Cockerell}}"
          },
          {
            "id": "s1:p7",
            "text": " Subtribe Psathyrotinae {{small|B.G.Baldwin}}\n Pelucha {{small|S.Watson}}\n Psathyrotes {{small|(Nutt.) A.Gray}}\n Trichoptilium {{small|A.Gray}}"
          },
          {
            "id": "s1:p8",
            "text": " Subtribe Tetraneurinae {{small|Rydb.}}\n Amblyolepis {{small|DC.}}\n Baileya {{small|Harv. & A.Gray ex Torr.}}\n Hymenoxys {{small|Cass.}}\n Ovicula Manley\n Psilostrophe {{small|DC.}}\n Tetraneuris {{small|Greene}}"
          }
        ]
      }
    ]
