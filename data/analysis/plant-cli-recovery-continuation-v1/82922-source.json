        "scope": "verified_requested_taxon",
        "passages": [
          {
            "id": "s1:p1",
            "text": "{{Título em itálico}}\n{{Info/Taxonomia\n| nome = ''Salvia sclareoides''\n| imagem = Salviasclareoides.jpeg\n| imagem_legenda = \n| reino = [[Plantae]]\n| clado1 = [[angiospérmicas]]\n| clado2 = [[eudicotiledóneas]]\n| ordem = [[Lamiales]]\n| família = [[Lamiaceae]]\n| género = ''[[Salvia]]''\n| espécie = '''''S. sclareoides'''''\n| binomial = ''Salvia sclareoides''\n| binomial_autoridade = Brot.\n}}\nSalvia sclareoides é uma espécie de planta com flor pertencente à família Lamiaceae. "
          },
          {
            "id": "s1:p2",
            "text": "A autoridade científica da espécie é Brot., tendo sido publicada em Fl. Lusit. 1: 17 (1804)."
          },
          {
            "id": "s1:p3",
            "text": " Portugal "
          },
          {
            "id": "s1:p4",
            "text": "Trata-se de uma espécie presente no território português, nomeadamente em Portugal Continental."
          },
          {
            "id": "s1:p5",
            "text": "Em termos de naturalidade é endémica da Península Ibérica."
          },
          {
            "id": "s1:p6",
            "text": " Protecção "
          },
          {
            "id": "s1:p7",
            "text": "Não se encontra protegida por legislação portuguesa ou da Comunidade Europeia."
          }
        ]
      },
      {
        "id": "s2",
        "title": "Flora-On — Salvia sclareoides",
        "language": "pt",
        "scope": "requested_taxon_regional_habitat_Portugal",
        "passages": [
          {
            "id": "s2:p1",
            "text": "Flora-On botanical account for Salvia sclareoides. Geographic scope: Portugal; habitat descriptions and native status on this site refer to Portugal, not the global native range."
          },
          {
            "id": "s2:p2",
            "text": "Ecologia ainda sem informação"
          },
          {
            "id": "s2:p3",
            "text": "Endémica de Península Ibérica"
          },
          {
            "id": "s2:p4",
            "text": "Ligações externas Descrição na Flora Iberica"
          },
          {
            "id": "s2:p5",
            "text": "Distância ao mar (n=775)"
          },
          {
            "id": "s2:p6",
            "text": "Preferências bioclimáticas explorar gráficos carregando... carregando..."
          },
          {
            "id": "s2:p7",
            "text": "Espécies com distribuição semelhante Smilax aspera , Rhamnus alaternus , Cistus crispus , Coronilla glauca , Stachys germanica , Pistacia lentiscus , Nepeta tuberosa ver todas"
          },
          {
            "id": "s2:p8",
            "text": "Tipo biológico Hemicriptófito"
          }
        ]
      }
