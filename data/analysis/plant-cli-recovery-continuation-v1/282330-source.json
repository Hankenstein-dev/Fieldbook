      {
        "id": "s1",
        "title": "Euphorbia hirsuta",
        "language": "pt",
        "scope": "verified_requested_taxon",
        "passages": [
          {
            "id": "s1:p1",
            "text": "Euphorbia hirsuta é uma espécie de planta com flor pertencente à família Euphorbiaceae. "
          },
          {
            "id": "s1:p2",
            "text": "A autoridade científica da espécie é L., tendo sido publicada em Amoenitates Academici 4: 483. 1759."
          },
          {
            "id": "s1:p3",
            "text": "Os seus nomes comuns são ésula-lanosa ou titímalo-lanoso."
          },
          {
            "id": "s1:p4",
            "text": " Portugal \nTrata-se de uma espécie presente no território português, nomeadamente em Portugal Continental."
          },
          {
            "id": "s1:p5",
            "text": "Em termos de naturalidade é nativa da região atrás indicada."
          },
          {
            "id": "s1:p6",
            "text": " Protecção \nNão se encontra protegida por legislação portuguesa ou da Comunidade Europeia."
          }
        ]
      },
      {
        "id": "s2",
        "title": "Flora-On — Euphorbia hirsuta",
        "language": "pt",
        "scope": "requested_taxon_regional_habitat_Portugal",
        "passages": [
          {
            "id": "s2:p1",
            "text": "Flora-On botanical account for Euphorbia hirsuta. Geographic scope: Portugal; habitat descriptions and native status on this site refer to Portugal, not the global native range."
          },
          {
            "id": "s2:p2",
            "text": "Ecologia Comunidades herbáceas na margem de cursos de água, lagoas e açudes. Em locais húmidos e subnitrófilos."
          },
          {
            "id": "s2:p3",
            "text": "Ligações externas Descrição na Flora Iberica"
          },
          {
            "id": "s2:p4",
            "text": "Distância ao mar (n=143)"
          },
          {
            "id": "s2:p5",
            "text": "Preferências bioclimáticas explorar gráficos carregando... carregando..."
          },
          {
            "id": "s2:p6",
            "text": "Espécies com distribuição semelhante Oxalis pes-caprae , Aetheorhiza bulbosa , Lagurus ovatus , Smilax aspera , Phragmites australis , Cistus salviifolius , Carpobrotus edulis ver todas"
          },
          {
            "id": "s2:p7",
            "text": "Tipo biológico Hemicriptófito"
          }
        ]
      }
    ]
  },
