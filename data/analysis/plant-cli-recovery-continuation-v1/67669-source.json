    "sources": [
      {
        "id": "s1",
        "title": "Gelidiaceae",
        "language": "en",
        "scope": "verified_requested_taxon",
        "passages": [
          {
            "id": "s1:p1",
            "text": "The Gelidiaceae is a small family of red algae containing eight genera. Many species of this algae are used to make agar."
          },
          {
            "id": "s1:p2",
            "text": "Uses\nAgar can be derived from many types of red seaweeds, including those from families such as Gelidiaceaae, Gracilariaceae, Gelidiellaceae and Pterocladiaceae. It is a polysaccharide located in the inner part of the red algal cell wall. It is used in food material, medicines, cosmetics, therapeutic and biotechnology industries."
          }
        ]
      },
      {
        "id": "s2",
        "title": "Gelidiaceae",
        "language": "pt",
        "scope": "verified_requested_taxon",
        "passages": [
          {
            "id": "s2:p1",
            "text": "{{Sem fontes|data=junho de 2019}}\n{{Info/Taxonomia\n|imagem=Tengusa work.jpg\n|imagem_legenda=Agarófitas a secar.\n|reino=[[Archaeplastida]]\n|filo=[[Rhodophyta]]\n|classe=[[Florideophyceae]]\n|ordem=[[Gelidiales]]\n|família=Gelidiaceae\n|subdivisão_nome=Géneros\n|subdivisão=\n*''[[Acanthopeltis]]''\n*''[[Beckerella]]''\n*''[[Capreolia]]''\n*''[[Gelidium]]''\n*''[[Pterocladiella]]''\n*''[[Ptilophora]]''\n*''[[Yatabella]]''\n}}"
          },
          {
            "id": "s2:p2",
            "text": "Gelidiaceae é uma pequena família de macroalgas rodofíceas contendo 7 géneros. Muitas das espécies são agarófitas sendo utilizadas na produção industrial de agar."
          },
          {
            "id": "s2:p3",
            "text": "{{Esboço-bio}}"
          }
        ]
      }
    ]
