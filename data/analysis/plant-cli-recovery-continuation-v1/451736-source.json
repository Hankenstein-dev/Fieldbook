        "passages": [
          {
            "id": "s2:p1",
            "text": "Plants of the World Online account: Salicornia procumbens Sm.."
          },
          {
            "id": "s2:p2",
            "text": "The native range of this species is Europe to W. Türkiye, W. Morocco. It is an annual and grows primarily in the temperate biome."
