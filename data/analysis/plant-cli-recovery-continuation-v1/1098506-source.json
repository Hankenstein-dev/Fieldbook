        "passages": [
          {
            "id": "s1:p1",
            "text": "Achillea aspleniifolia is a species of flowering plant belonging to the family Asteraceae."
          },
          {
            "id": "s1:p2",
            "text": "Its native range is Central and Southern Europe."
          },
          {
            "id": "s1:p3",
            "text": "Synonym:\n Achillea asplenifolia (orthographical variant){{citation needed|date=February 2021}}"
          }
        ]
