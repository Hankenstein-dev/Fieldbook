        "passages": [
          {
            "id": "s1:p1",
            "text": "Clerodendrum speciosissimum is a tropical shrub of the family Lamiaceae, native to Indonesia and Papuasia, but now naturalized in parts of Latin America, Africa, the Caribbean, Seychelles, and Florida."
          },
          {
            "id": "s1:p2",
            "text": "Description\nThe shrub can grow up to 4 m tall. The leaves are square-shaped, and the large heart-shaped flowers can reach up to 30 cm. It is cultivated as an ornamental plant, in particular for its bright red flowers."
          }
        ]
      }
