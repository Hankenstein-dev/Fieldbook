        "passages": [
          {
            "id": "s1:p1",
            "text": "Nephrolepis brownii, the Asian sword fern, is a species of fern native to Asia and introduced elsewhere. It is a perennial herb and grows up to {{Convert|3|ft|m|abbr=on}} tall."
          },
          {
            "id": "s1:p2",
            "text": "Range"
          },
          {
            "id": "s1:p3",
            "text": "The native range includes most of southeast Asia and extends north to China and Japan, west to Sri Lanka and India, east to Pacific islands, and south to Australia. It is introduced in North and South America and Hawaii."
          }
        ]
      }
    ]
