        "passages": [
          {
            "id": "s1:p1",
            "text": "Deschampsia argentea é uma espécie de planta com flor pertencente à família Poaceae. "
          },
          {
            "id": "s1:p2",
            "text": "A autoridade científica da espécie é (Lowe) Lowe, tendo sido publicada em Transactions of the Cambridge Philosophical Society 6: 529. 1838."
          },
          {
            "id": "s1:p3",
            "text": " Portugal \nTrata-se de uma espécie presente no território português, nomeadamente no Arquipélago da Madeira."
          },
          {
            "id": "s1:p4",
            "text": "Em termos de naturalidade é endémica da região atrás referida."
          },
          {
            "id": "s1:p5",
            "text": " Protecção \nNão se encontra protegida por legislação portuguesa ou da Comunidade Europeia."
          }
        ]
      }
    ]
