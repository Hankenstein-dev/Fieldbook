        "passages": [
          {
            "id": "s1:p1",
            "text": "Hypericum linariifolium é uma espécie de planta com flor pertencente à família Hypericaceae. "
          },
          {
            "id": "s1:p2",
            "text": "A autoridade científica da espécie é Vahl, tendo sido publicada em Symb. Bot. (Vahl) 1: 65. 1790."
          },
          {
            "id": "s1:p3",
            "text": " Portugal "
          },
          {
            "id": "s1:p4",
            "text": "Trata-se de uma espécie presente no território português, nomeadamente em Portugal Continental e no Arquipélago da Madeira."
          },
          {
            "id": "s1:p5",
            "text": "Em termos de naturalidade é nativa das duas regiões atrás indicadas."
          },
          {
            "id": "s1:p6",
            "text": " Protecção "
          },
          {
            "id": "s1:p7",
            "text": "Não se encontra protegida por legislação portuguesa ou da Comunidade Europeia."
          }
        ]
      }
    ]
  },
