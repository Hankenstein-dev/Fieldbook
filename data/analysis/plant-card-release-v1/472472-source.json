        "passages": [
          {
            "id": "s1:p1",
            "text": "Cylindropuntia whipplei (formerly known as Opuntia whipplei, common name Whipple cholla) is a member of the cactus family, Cactaceae."
          },
          {
            "id": "s1:p2",
            "text": " Usage \nThe Zuni people rub the spines off the fruit and then dry them for winter use. The dried fruit is also ground into a flour, mixed with ground corn meal and made into a mush. Spineless fruits are eaten raw or stewed."
          }
        ]
      }
