        "passages": [
          {
            "id": "s1:p1",
            "text": "Hura polyandra is a species of tree native to various parts of Latin America."
          },
          {
            "id": "s1:p2",
            "text": "In 2019 the IUCN classified this species as least concern due to there being no recent evidence of significant threats or future ones, as well as its large distribution and population."
          },
          {
            "id": "s1:p3",
            "text": "Trees can grow up to 30 meters in height and its flowers are monoecious with absent petals. The species occurs in cleared agricultural areas, forest plains, and rocky hillsides."
          }
        ]
      }
    ]
