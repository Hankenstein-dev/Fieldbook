        "passages": [
          {
            "id": "s1:p1",
            "text": "Justicia carnea, the Brazilian plume flower, Brazilian-plume, flamingo flower, or jacobinia, is a flowering plant in the family Acanthaceae."
          },
          {
            "id": "s1:p2",
            "text": "The perennial plant is native to the Atlantic Forest ecoregions of eastern Brazil, Misiones Province of northeastern Argentina, and Paraguay."
          },
          {
            "id": "s1:p3",
            "text": "It is cultivated and sold as a decorative potted plant and is planted in landscaping as a feature plant in warm temperate and subtropical climates."
          }
        ]
      }
    ]
