        "passages": [
          {
            "id": "s1:p1",
            "text": "Begonia minor is a species of flowering plant in the family Begoniaceae, native to Jamaica. It's also been introduced to Madeira, Réunion, and the Society Islands. In 1777, it was the first Begonia to be introduced to Great Britain. Initially, this specimen was known as B. nitida. \"Nitida\" means \"shining leaves\". "
          },
          {
            "id": "s1:p2",
            "text": "B. minor has a shrub-like growing habit, and produces masses of pink flowers year-round. When planted in gardens, it can grow to be {{Convert|3|ft|sigfig=1}} or more in size."
          },
          {
            "id": "s1:p3",
            "text": " Images"
          }
        ]
      }
    ]
