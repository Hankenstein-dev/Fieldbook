        "passages": [
          {
            "id": "s1:p1",
            "text": "Vinca difformis, commonly called the intermediate periwinkle, is an evergreen, flowering subshrub."
          },
          {
            "id": "s1:p2",
            "text": "It grows to about {{Convert|0.5|m|ft|frac=2}} tall, and forms mats over {{Convert|1|m|ft|abbr=on|frac=2}} across. Its whitish-blue flowers have a blooming season from late winter to early spring."
          },
          {
            "id": "s1:p3",
            "text": "It is native to Western Europe, including the Iberian Peninsula, France, the Italian Peninsula and Sardinia."
          }
        ]
      }
    ]
