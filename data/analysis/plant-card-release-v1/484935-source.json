        "passages": [
          {
            "id": "s1:p1",
            "text": "Viburnum treleasei (Portuguese: folhado), the Azorean laurustinus, is a species in the genus Viburnum endemic to the Azores. It inhabits natural forests of Juniperus brevifolia, Laurus azorica and Ilex perado, Erica azorica, in sloping areas. Generally at altitudes above {{convert|200|m|abbr=on}}. It is present in eight of the nine islands."
          }
        ]
      }
