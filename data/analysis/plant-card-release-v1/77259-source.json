        "passages": [
          {
            "id": "s1:p1",
            "text": "Geranium pyrenaicum, otherwise known as hedgerow cranesbill or mountain cranesbill is a perennial species of plant in the family Geraniaceae. \nIt can be found on roadside verges and along hedgerows."
          },
          {
            "id": "s1:p2",
            "text": "Distribution\nIt is probably introduced in England and Wales, where it is fairly common. Elsewhere, it can be found in the southern Alps, the Pyrenees and the Caucasus."
          }
        ]
      }
