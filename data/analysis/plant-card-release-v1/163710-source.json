        "passages": [
          {
            "id": "s1:p1",
            "text": "Heteranthera reniformis common name kidneyleaf mud-plantain, and mud plantain; is a species of flowering plant in the family Pontederiaceae. It is found in North America. It is listed as a special concern and believed extirpated in Connecticut. It listed as endangered in Illinois and Ohio."
          },
          {
            "id": "s1:p2",
            "text": "Native American ethnobotany\nThe Cherokee apply a hot poultice of the root to inflamed wounds and sores."
          }
        ]
      }
