        "passages": [
          {
            "id": "s1:p1",
            "text": "Oxyrrhynchium hians, also known as Swartz's feather-moss or light beaked moss, is a species of moss in the family Brachytheciaceae."
          },
          {
            "id": "s1:p2",
            "text": "Description\nThis moss has a highly variable phenotype in terms of density and leaf shape."
          },
          {
            "id": "s1:p3",
            "text": "Range\nThis plant is found globally. In North America, it is almost absent in the West."
          },
          {
            "id": "s1:p4",
            "text": "Taxonomy\nOxyrrhynchium hians contains the following subspecies:\n Oxyrrhynchium hians subsp. rappii\n Oxyrrhynchium hians subsp. hians"
          }
        ]
