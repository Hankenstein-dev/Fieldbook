        "passages": [
          {
            "id": "s1:p1",
            "text": "Trifolium medium, the zigzag clover, is a flowering plant species in the bean family Fabaceae. It is similar in appearance to red clover, Trifolium pratense, but the leaflets are narrower and have no white markings and the narrow stipules are not bristle-pointed."
          },
          {
            "id": "s1:p2",
            "text": "The species is native to Europe from Britain to the Caucasus."
          },
          {
            "id": "s1:p3",
            "text": "{{gallery|mode=packed\n|Trifolium medium subsp. medium sl7.jpg|The stipules do not have conspicuous veins or a bristle point, unlike in red clover.\n}}"
          }
        ]
      }
    ]
  },
