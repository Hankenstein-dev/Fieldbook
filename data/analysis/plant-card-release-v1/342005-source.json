        "passages": [
          {
            "id": "s1:p1",
            "text": "Lotus arenarius is a trailing plant in the Lotus genus ranging from Central & S. Portugal to S. Spain, Morocco, and Senegal."
          },
          {
            "id": "s1:p2",
            "text": " Identification \nThis plant is identified by its three spaced out pealike leaves and hairy stems that almost look sandy. The five clustered flower heads have hairs on the forked base giving way to small yellow pealike flowers."
          },
          {
            "id": "s1:p3",
            "text": "This plant has smooth to hairy leaves depending on where it is found."
          }
        ]
      }
    ]
