        "passages": [
          {
            "id": "s1:p1",
            "text": "Teucrium francoi é uma espécie de planta com flor pertencente à família Lamiaceae. "
          },
          {
            "id": "s1:p2",
            "text": "A autoridade científica da espécie é M.Seq., Capelo, J.C.Costa & R.Jardim, tendo sido publicada em Botanical Journal of the Linnean Society 156: 643. 2008."
          },
          {
            "id": "s1:p3",
            "text": " Portugal \nTrata-se de uma espécie presente no território português, nomeadamente no Arquipélago da Madeira."
          },
          {
            "id": "s1:p4",
            "text": "Em termos de naturalidade é endémica da região atrás referida."
          },
          {
            "id": "s1:p5",
            "text": " Protecção \nNão se encontra protegida por legislação portuguesa ou da Comunidade Europeia."
          }
        ]
      }
    ]
