        "passages": [
          {
            "id": "s1:p1",
            "text": "Cyperus textilis (flat sedge, basket grass, umbrella sedge, mat sedge) is a sedge in the family Cyperaceae. It is endemic to southern parts of South Africa where it grows near rivers and other water reservoirs."
          },
          {
            "id": "s1:p2",
            "text": "Cyperus textilis is used to make baskets, sleeping mats, rolled twine and other woven articles."
          },
          {
            "id": "s1:p3",
            "text": " Description \nCyperus textilis can grow to be 1 to 3 meters tall. It forms clumps like other Cyperus species and is similar to the commonly kept plant C. alternifolius."
          }
        ]
      }
    ]
