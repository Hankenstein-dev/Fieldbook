        "passages": [
          {
            "id": "s1:p1",
            "text": "The pale willowherb (Epilobium roseum) is a species of flowering plant belonging to the family Onagraceae."
          },
          {
            "id": "s1:p2",
            "text": "Description\n{{em|E. roseum}} can be difficult to distinguish from other species, for which reason it has been mistaken from Epilobium ciliatum, E. hirsutum, E. montanum and E. obscurum."
          },
          {
            "id": "s1:p3",
            "text": "Distribution and habitat\n{{em|E. roseum}}'s native range is Europe to China. It is a common species in lowlands, especially on moist ruderal sites."
          }
        ]
      }
    ]
