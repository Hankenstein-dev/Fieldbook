        "passages": [
          {
            "id": "s1:p1",
            "text": "{{Use dmy dates|date=August 2024}}"
          },
          {
            "id": "s1:p2",
            "text": "Lotus macranthus is a species that grows in the Madeira archipelago."
          },
          {
            "id": "s1:p3",
            "text": "Description\nLotus macranthus has a taproot that zigzags as it grows into the ground. Its roots are whiteish in color, soft, brittle, juicy."
          },
          {
            "id": "s1:p4",
            "text": "Taxonomy\nLotus macranthus was first scientifically described by Richard Thomas Lowe in 1838. He later described it as Pedrosia macrantha in 1856, a genus that is now synonymized with Lotus."
          },
          {
            "id": "s1:p5",
            "text": "Range and habitat\nIts native range is in the Madeira archipelago."
          }
        ]
      }
    ]
