        "passages": [
          {
            "id": "s1:p1",
            "text": "Smilax canariensis is a species of flowering plants of the Smilacaceae family. It occurs in Madeira and the Canary Islands. The species was first described by Carl Ludwig Willdenow in 1806. Its Spanish name is zarzaparrilla canaria."
          },
          {
            "id": "s1:p2",
            "text": "Description\nThe species is a climbing wintergreen plant. It has few or no thorns. The width to length ratio of its leaves is about 0.6. The flowers are unisexual, in a simple umbel. Its fruits are black when ripe."
          }
        ]
      }
    ]
