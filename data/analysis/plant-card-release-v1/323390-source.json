        "passages": [
          {
            "id": "s1:p1",
            "text": "Isolepis fluitans (syn. Scirpus fluitans), the floating scirpus, is a species of flowering plant in the sedge family. It is native to Africa, Australasia, Europe, and the Pacific islands. It was first described by Carl Linnaeus in 1753, and later transferred to Isolepis by the botanist Robert Brown in 1810."
          },
          {
            "id": "s1:p2",
            "text": "The species epithet fluitans is Latin for floating."
          }
        ]
      }
