        "passages": [
          {
            "id": "s1:p1",
            "text": "Allium polyanthum, called the many-flowered garlic, is a Mediterranean species of wild onion native to Spain, France, Italy, Morocco, and Tunisia. It is widely cultivated for its edible and potently aromatic bulbs and foliage."
          },
          {
            "id": "s1:p2",
            "text": "Allium polyanthum produces an egg-shaped bulb, often with small bulblets around the base. Scape can be up to 80 cm tall. Leaves are flat and broadly linear, tapering at the tip. Flowers are numerous and small, white or pink."
          }
        ]
      }
    ]
