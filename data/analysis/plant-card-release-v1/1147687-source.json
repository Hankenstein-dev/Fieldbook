        "scope": "title_matches_scientific_name",
        "passages": [
          {
            "id": "s1:p1",
            "text": "Astragalus cymbaecarpos, saveirinho, é uma espécie de planta com flor pertencente à família Fabaceae."
          },
          {
            "id": "s1:p2",
            "text": "A autoridade científica da espécie é Brot., tendo sido publicada em Phytogr. Lusit. Select. 63 (1800)."
          },
          {
            "id": "s1:p3",
            "text": " Portugal "
          },
          {
            "id": "s1:p4",
            "text": "Trata-se de uma espécie presente no território português, nomeadamente em Portugal Continental."
          },
          {
            "id": "s1:p5",
            "text": "Em termos de naturalidade é nativa da região atrás indicada."
          },
          {
            "id": "s1:p6",
            "text": " Protecção "
          },
          {
            "id": "s1:p7",
            "text": "Não se encontra protegida por legislação portuguesa ou da Comunidade Europeia."
          }
        ]
      }
    ]
  },
