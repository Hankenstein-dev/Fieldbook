        "passages": [
          {
            "id": "s1:p1",
            "text": "Polystichum drepanum, also known as Madeira shield-fern, is a species of fern in the Dryopteridaceae family."
          },
          {
            "id": "s1:p2",
            "text": "It is native to Madeira. Its natural habitat is subtropical moist lowland forests. It is threatened by habitat loss."
          },
          {
            "id": "s1:p3",
            "text": "Taxonomy\nIt was first described by Olof Swartz as Aspidium drepanum in 1801, and was moved to the genus Polystichum by Carl Borivoj Presl in 1836."
          }
        ]
      }
    ]
