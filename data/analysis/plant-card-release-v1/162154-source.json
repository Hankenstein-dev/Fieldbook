        "passages": [
          {
            "id": "s1:p1",
            "text": "Dyckia brevifolia, or sawblade, is a species of flowering plant in the Bromeliaceae family. This species is endemic to Brazil."
          },
          {
            "id": "s1:p2",
            "text": "Cultivars\nDyckia 'Yellow Glow' is a cultivar of Dyckia brevifolia. Dyckia brevifolia is also one parent of the hybrid cultivars Dyckia 'Lad Cutak', Dyckia 'Naked Lady' and Dyckia 'Vista'."
          }
        ]
