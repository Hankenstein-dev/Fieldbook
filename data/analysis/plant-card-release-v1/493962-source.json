        "passages": [
          {
            "id": "s1:p1",
            "text": "Dendrobium thyrsiflorum is a species of orchid, commonly called the pinecone-like raceme dendrobium. It is native to the Himalayas (Bhutan, Assam, Yunnan and Arunachal Pradesh) as well as to the mountains of northern Indochina (Myanmar, Thailand, Laos and Vietnam)."
          },
          {
            "id": "s1:p2",
            "text": "Two varieties are recognized:"
          },
          {
            "id": "s1:p3",
            "text": "Dendrobium thyrsiflorum var. minutiflorum Aver. - Laos\nDendrobium thyrsiflorum var. thyrsiflorum - most of species range"
          }
        ]
      }
    ]
