        "passages": [
          {
            "id": "s1:p1",
            "text": "Elatine triandra is a species of flowering plant belonging to the family Elatinaceae. It is known by the common name longstem waterwort."
          },
          {
            "id": "s1:p2",
            "text": "Its native range is Temperate and Subtropical Old World to Western Malesia. "
          },
          {
            "id": "s1:p3",
            "text": "In New England, it's regarded as introduced and has been documented in both Massachusetts and Maine and it is found primarily around rivers."
          }
        ]
      }
    ]
