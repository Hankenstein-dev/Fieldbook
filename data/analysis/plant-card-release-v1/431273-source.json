        "passages": [
          {
            "id": "s1:p1",
            "text": "Rhododendron mucronatum is a rhododendron species native to China, where it grows at altitudes of {{convert|2800-4500|m|ft|abbr=on}}. This evergreen shrub grows to {{convert|1-2|m|ft|abbr=on}} in height, with leaves that are lanceolate to ovate-lanceolate or oblong-lanceolate, 2–6 by 0.5–1.8 cm in size. The flowers are white, pink, or pale red."
          }
        ]
