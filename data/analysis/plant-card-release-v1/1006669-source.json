        "passages": [
          {
            "id": "s1:p1",
            "text": "Ptychostomum imbricatulum, handbell moss, is a species of moss belonging to the family Bryaceae."
          },
          {
            "id": "s1:p2",
            "text": "It has almost cosmopolitan distribution."
          },
          {
            "id": "s1:p3",
            "text": "Ptychostomum imbricatulum is known to be able to use artificial light to grow in places which are otherwise devoid of natural light, such as Crystal Cave in Wisconsin."
          }
        ]
      }
