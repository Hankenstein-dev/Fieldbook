        "passages": [
          {
            "id": "s1:p1",
            "text": "{{Use dmy dates|date=July 2019}}"
          },
          {
            "id": "s1:p2",
            "text": "Amblystegium serpens, also known as the creeping feathermoss or nano moss, is a species of moss. It is a common species in Britain."
          },
          {
            "id": "s1:p3",
            "text": "The species is pleurocarpous in form, with ovate to lanceolate leaves which end in a fine acute point. It forms creeping mats on decaying tree stumps, hedgebanks and other shaded sites."
          },
          {
            "id": "s1:p4",
            "text": "It can live under water, and is used as a plant in some home aquariums."
          }
        ]
      }
    ]
