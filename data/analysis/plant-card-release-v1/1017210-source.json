        "passages": [
          {
            "id": "s1:p1",
            "text": "Persea barbujana, the Canary laurel or barbusano, is a species of tree in the laurel family, Lauraceae. It is endemic to the Macaronesian islands of Madeira (incl. Porto Santo) and the Canary Islands. It is often placed as the sole species in genus Apollonias. Molecular phylogenic analyses found that the species is nested within the genus Persea, which also includes the Macaronesian endemic Persea indica."
          },
          {
            "id": "s1:p2",
            "text": "The La Gomera subspecies is distinct and endangered."
          }
        ]
      }
    ]
