        "passages": [
          {
            "id": "s1:p1",
            "text": "Philodendron radiatum (called corija de pobre) is a rainforest vine in the family Araceae. It is found from southern Mexico southward to Panama. It is a root climber growing to a height of {{cvt|25|m}}. Its leaves are ovoid-triangular, and measure up to 1 m long by 1 m broad at the base, and often so deeply lobed as to almost be pinnate."
          }
        ]
      }
