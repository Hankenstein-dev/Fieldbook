        "passages": [
          {
            "id": "s1:p1",
            "text": "Sedum moranense, or red stonecrop, is a species of flowering plant in the family Crassulaceae."
          },
          {
            "id": "s1:p2",
            "text": "Description\nAdult plant has many small green succulent leaves densely clustered around stems."
          },
          {
            "id": "s1:p3",
            "text": "Habitat and distribution\nNative to Mexico, it has also been introduced to Colombia. It grows primarily in the desert or dry shrubland biome."
          },
          {
            "id": "s1:p4",
            "text": "Taxonomy\nThere are two accepted subspecies:\n{{species list\n|Sedum moranense subsp. grandiflorum |R.T.Clausen\n|Sedum moranense subsp. moranense\n}}"
          }
        ]
      }
    ]
