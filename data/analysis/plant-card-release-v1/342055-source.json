        "passages": [
          {
            "id": "s1:p1",
            "text": "Lotus argyrodes is a plant species in the genus Lotus endemic to the Azores and Madeira Islands."
          },
          {
            "id": "s1:p2",
            "text": "Description\nThis species is a subshrub with succulent leaves each with fine hairs. The flowers have a red wing and a yellow beak, looking swanlike, along with a preseadhead flower part. the leaves are oval when mature."
          },
          {
            "id": "s1:p3",
            "text": "This species also has green hairless seed pods that stick upright off the old leaves."
          },
          {
            "id": "s1:p4",
            "text": "Conservation status\nThis species is actually considered Least Concern by the Kew database."
          }
        ]
      }
    ]
