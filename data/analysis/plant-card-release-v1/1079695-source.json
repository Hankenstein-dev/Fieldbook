        "passages": [
          {
            "id": "s1:p1",
            "text": "Bellis pappulosa is a species of daisy in the genus Bellis. This species is native in Western Europe, Algeria, France, Morocco and Spain."
          },
          {
            "id": "s1:p2",
            "text": "B. pappulosa is morphologically similar to Bellis sylvestris but has scales on the pappus of the seeds, which are absent in B. sylvestris. Moreover, B. pappulosa is diploid while B. sylvestris is polyploid."
          }
        ]
      }
    ]
