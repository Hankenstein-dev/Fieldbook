        "passages": [
          {
            "id": "s1:p1",
            "text": "Poa compressa, the Canada bluegrass or flattened meadow-grass, is a perennial flattened meadow grass, similar to common meadow-grass, Poa pratensis. It is native to Europe but it can be found nearly worldwide as an introduced species. It grows in old wall tops, pavement cracks, dry stony grassland, and many types of wild habitat. It has a flattened stem, 23–30 cm tall, a close one sided panicle of grey green, with purple florets."
          },
          {
            "id": "s1:p2",
            "text": "The ligule is rounded."
          }
        ]
      }
    ]
