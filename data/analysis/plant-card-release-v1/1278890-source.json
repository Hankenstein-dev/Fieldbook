        "passages": [
          {
            "id": "s1:p1",
            "text": "Coleus comosus, synonym Plectranthus ornatus, is a flowering plant from the mint family Lamiaceae, native to eastern Africa (Eritrea, Ethiopia, Kenya, Tanzania and Uganda)."
          },
          {
            "id": "s1:p2",
            "text": "A plant sold under the name \"Coleus canina\" or \"scaredy cat plant\" is supposed to scare off cats and dogs. An attempt to register \"Coleus canina\" to receive plant variety protection failed as it was considered to be only a clone of Coleus comosus."
          }
        ]
      }
