        "passages": [
          {
            "id": "s1:p1",
            "text": "Rhododendron molle (羊踯躅) is a rhododendron species native to China and Japan, where it grows at altitudes of sea level to 2500 meters. This deciduous shrub grows to {{convert|50-200|cm|in|abbr=on}} in height, with leaves that are oblong to oblong-lanceolate, 5–11 by 1.5–3.5 cm in size. The flowers are yellow with dark red flecks."
          },
          {
            "id": "s1:p2",
            "text": "This azalea is not often seen in cultivation, but is the parent of many yellow-flowered hybrids."
          }
        ]
      }
    ]
