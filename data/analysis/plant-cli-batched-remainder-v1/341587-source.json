        "passages": [
          {
            "id": "s1:p1",
            "text": "Lotus conimbricensis has a trailing plant in the genus Lotus."
          },
          {
            "id": "s1:p2",
            "text": "this species is also known in Arabic as לוֹטוּס רִיסָנִי."
          },
          {
            "id": "s1:p3",
            "text": " Appearance \nLotus conimbricensis is identified by its singular white flower pea shaped flowers looking much like Lotus micranthus except with purple veining. This species also has hairs on the bottom and a smooth top of the small oval leaves which is a key identification feature."
          },
          {
            "id": "s1:p4",
            "text": " Recognition \nThis species is recognized under the USDA PLANTS database."
          },
          {
            "id": "s1:p5",
            "text": " Status \nThis plant is considered least concern."
          }
        ]
      }
    ]
