        "passages": [
          {
            "id": "s1:p1",
            "text": "Rhododendron indicum is an azalea Rhododendron species native to Japan (S & W Honshu, Shikoku, Kyushu, Yakushima)."
          },
          {
            "id": "s1:p2",
            "text": "Taxonomy\nIt is the type species for the Tsutsusi section and subsection, and was the original Tsutsusi described by Engelbert Kaempfer in Japan in 1712, from the Japanese name Kirishima-tsutsuji."
          },
          {
            "id": "s1:p3",
            "text": " Cultivation \nThere are many cultivars, including the Satsuki azaleas."
          }
        ]
      }
