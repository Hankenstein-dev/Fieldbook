        "passages": [
          {
            "id": "s1:p1",
            "text": "Ophrys tenthredinifera, or the sawfly orchid, is a terrestrial species of orchid native to the Mediterranean region from Portugal and Morocco to Turkey. The common name refers to a purported resemblance between the flower and the sawfly, a wasp-like insect."
          },
          {
            "id": "s1:p2",
            "text": "Many subspecies, varieties and forms have been proposed, but as of May 2014, none are recognized."
          }
        ]
      }
