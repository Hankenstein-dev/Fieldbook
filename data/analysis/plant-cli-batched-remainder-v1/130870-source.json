        "scope": "title_matches_scientific_name",
        "passages": [
          {
            "id": "s1:p1",
            "text": "Iresine diffusa, or Juba's bush, is a species of plant in the family Amaranthaceae. Its form Iresine diffusa f. lindenii, formerly Iresine lindenii, is commercially available as an ornamental."
          },
          {
            "id": "s1:p2",
            "text": "Appearance \nHerb 1–2 m, stem a little grooved, nodes jointed. Leaves opp, 14 x 7 cm, edge smooth. Flowers minute, greenish-white, panicle 40 cm long, male more open, female compact, 1 mm. Seed 0.5 mm."
          },
          {
            "id": "s1:p3",
            "text": "Folk use\nIt is used to treat ovary inflammation in Peru."
          },
          {
            "id": "s1:p4",
            "text": "Chemistry\nDrimenes in aerial parts."
          }
        ]
      }
    ]
  },
