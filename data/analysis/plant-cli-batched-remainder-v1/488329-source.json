        "passages": [
          {
            "id": "s1:p1",
            "text": "Schottera nicaeensis is a species of red algae (Rhodophyta) similar to other small red algae particularly Phyllophora."
          },
          {
            "id": "s1:p2",
            "text": "Description\nThe thallus consists of short flat fronds rising from a prostrate terete branched holdfast and growing to a length of about 10 cm. It branches once or twice and bears terete proliferations at the tips."
          },
          {
            "id": "s1:p3",
            "text": "Distribution\nIn Ireland, S. nicaeensis occurs in Portmuck, in Island Magee. On the western shores of Great Britain, Portugal and in the Mediterranean."
          }
        ]
      }
    ]
