          {
            "id": "s1:p1",
            "text": "Ruta angustifolia, the narrow-leaved fringed rue, is a small shrub belonging to the Rutaceae family. It is native to the Mediterranean, and has been adapted to various parts of the world."
          },
          {
            "id": "s1:p2",
            "text": " Distribution "
          },
          {
            "id": "s1:p3",
            "text": "It is found in Algeria, Morocco, Tunisia, Italy, Sicily, Yugoslavia, Corsica, France, Portugal, Sardinia and Spain."
          }
        ]
      }
