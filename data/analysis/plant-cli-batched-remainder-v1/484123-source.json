        "passages": [
          {
            "id": "s1:p1",
            "text": "Cymbidium lowianum, called Low's boat orchid, is a species of orchid in the genus Cymbidium, native to Assam in India, Yunnan in China, Myanmar, Thailand, and Vietnam. It has gained the Royal Horticultural Society's Award of Garden Merit."
          },
          {
            "id": "s1:p2",
            "text": "Subtaxa\nThe following varieties are currently accepted:\nCymbidium lowianum var. ailaoense X.M.Xu\nCymbidium lowianum var. kalawense (Colyear) Govaerts\nCymbidium lowianum var. lowianum"
          }
        ]
      }
    ]
