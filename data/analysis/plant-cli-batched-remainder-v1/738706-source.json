        "passages": [
          {
            "id": "s1:p1",
            "text": "Veronica epacridea, synonym Hebe epacridea, is a plant of the family Plantaginaceae. It is endemic to altitudes above 3,000 feet from the Marlborough Region to Otago region on the South Island of New Zealand. It is a low-growing, evergreen shrub, reaching 10 cm in height, with thick, closely placed, recurved green leaves that are 5–7 mm long. Flowers are white."
          }
        ]
      }
