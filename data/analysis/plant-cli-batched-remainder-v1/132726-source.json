        "passages": [
          {
            "id": "s1:p1",
            "text": "Begonia obliqua is the type species of the genus Begonia and the species to which Plumier first gave the name Begonia. It is native to Martinique, Dominica, and Guadeloupe."
          },
          {
            "id": "s1:p2",
            "text": "The name has been misapplied to Begonia grandis by Thunberg, to Begonia minor by L'Héritier, and to Begonia fischeri by Vellozo."
          }
        ]
      }
    ]
