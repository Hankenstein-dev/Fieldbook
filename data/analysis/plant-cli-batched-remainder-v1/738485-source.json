        "passages": [
          {
            "id": "s1:p1",
            "text": "Sonchus ustulatus, also known as a leituga, is a species of herb in the Asteraceae family. It is endemic to Madeira, an island group in the Atlantic which is politically part of Portugal. It grows to be around 0.2 meters."
          },
          {
            "id": "s1:p2",
            "text": " Description \nThe leituga is a perennial plant that either has no stem or a very short one. It does not have many floral heads and generally grows on a rocky shoreline. It is herbaceous."
          },
          {
            "id": "s1:p3",
            "text": " Subspecies \nThe leituga has 2 subspecies:"
          },
          {
            "id": "s1:p4",
            "text": " Sonchus ustulatus subsp. ustulatus \n Sonchus ustulatus subsp. mederensis (Syn.: S. latifolius) "
          },
          {
            "id": "s1:p5",
            "text": " Found near "
          },
          {
            "id": "s1:p6",
            "text": " San Cristóbal de la Laguna \n Distrito Anaga\n Funchal \n Calheta \n São Vicente"
          }
        ]
      }
    ]
