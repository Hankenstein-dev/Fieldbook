    "sources": [
      {
        "id": "s1",
        "title": "Albuca spiralis",
        "language": "en",
        "scope": "title_matches_scientific_name",
        "passages": [
          {
            "id": "s1:p1",
            "text": "Albuca spiralis, commonly called the corkscrew albuca or frizzle sizzle, is a species of flowering plant in the family Asparagaceae, that is native to Western and Northern Cape Provinces, South Africa."
          },
          {
            "id": "s1:p2",
            "text": "Description"
          },
          {
            "id": "s1:p3",
            "text": "The plant has narrow leaves that curve, forming a spiral. They are sometimes tipped with glandular hairs, but are not sticky (unlike those of the similar species, Albuca viscosa)."
          },
          {
            "id": "s1:p4",
            "text": "The plant bears nodding green flowers with pale yellow margins. The flowers are sweetly scented, with an aroma like that of vanilla."
          }
        ]
      }
    ]
  },
