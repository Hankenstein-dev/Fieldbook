        "title": "Trifolium micranthum",
        "language": "en",
        "scope": "title_matches_scientific_name",
        "passages": [
          {
            "id": "s1:p1",
            "text": "Trifolium micranthum, the slender trefoil or slender hop clover, is a plant species of the genus Trifolium in the \"pea family\"; Fabaceae or Papillionaceae."
          },
          {
            "id": "s1:p2",
            "text": "It is distributed in Central and Western Europe on river dunes. It is an annual species with ovate or lance shaped leaves, the middle leaves with shorter petioles."
          },
          {
            "id": "s1:p3",
            "text": "The stems of the flowering head hang over slightly. The heads have 5-7 bright yellowish orange flowers which appear from May until July."
          },
          {
            "id": "s1:p4",
            "text": "The pods are turned in one direction."
          }
        ]
      }
    ]
  },
