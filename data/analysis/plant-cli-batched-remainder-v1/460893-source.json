        "passages": [
          {
            "id": "s1:p1",
            "text": "Globularia vulgaris is a plant belonging to the genus Globularia, in the family Plantaginaceae."
          },
          {
            "id": "s1:p2",
            "text": "It has a very disjunct distribution: One population in the mountains of southern France and north-central and eastern Spain; and another population on the islands Öland and Gotland in the Baltic Sea."
          },
          {
            "id": "s1:p3",
            "text": "It differs from Globularia trichosantha of the Balkans and Crimea by lacking stolons and having the teeth of the calyx as long as (or slightly longer) than its tube (3–4 times longer in G. trichosantha)."
          }
        ]
      }
    ]
