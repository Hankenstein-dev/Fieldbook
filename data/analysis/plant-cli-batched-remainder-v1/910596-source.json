        "passages": [
          {
            "id": "s1:p1",
            "text": "Jacaranda brasiliana is a species of flowering plant in the family Bignoniaceae. It is native to Brazil, including in the Amazon, Cerrado, and Caatinga domains—typically from Mato Grosso to Minas Gerais, and Pará to Bahia."
          },
          {
            "id": "s1:p2",
            "text": "The flowers can be collected from November to February, with the fruit collected in February."
          }
        ]
      }
