        "passages": [
          {
            "id": "s1:p1",
            "text": "Agrostis curtisii, the bristle bent, is a species of grass in the family Poaceae native to Eurasia."
          },
          {
            "id": "s1:p2",
            "text": "It is densely tufted, with hair like leaves and stems that grow up to {{convert|60|cm|ft}}. Its spikelets are yellow-green in colour, and its lemmas are awned. The ligule is pointed."
          },
          {
            "id": "s1:p3",
            "text": "It has no rhizomes or stolons."
          },
          {
            "id": "s1:p4",
            "text": "Bristle bent flowers in the UK from June until July and is found typically on dry heaths and moors."
          }
        ]
      }
    ]
