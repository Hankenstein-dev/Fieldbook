        "passages": [
          {
            "id": "s1:p1",
            "text": "Tillandsia xiphioides is a species in the genus Tillandsia. This species is native to Bolivia, Brazil, Paraguay, Uruguay, and Argentina."
          },
          {
            "id": "s1:p2",
            "text": "Four infraspecific taxa are recognized:"
          },
          {
            "id": "s1:p3",
            "text": "Tillandsia xiphioides var. minor L.Hrom. – Argentina\nTillandsia xiphioides subsp. prolata H.E.Luther – Bolivia\nTillandsia xiphioides var. tafiensis L.B.Sm – Argentina\nTillandsia xiphioides subsp. xiphioides – most of species range"
          },
          {
            "id": "s1:p4",
            "text": "Cultivars\n Tillandsia 'Folly'\n Tillandsia 'Mystic Trumpet'\n Tillandsia 'Mystic Trumpet Peach'\n Tillandsia 'Mystic Trumpet Pink'"
          }
        ]
      }
    ]
