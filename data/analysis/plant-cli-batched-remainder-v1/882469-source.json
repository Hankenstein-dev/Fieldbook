        "passages": [
          {
            "id": "s1:p1",
            "text": "Rhododendron kiusianum, the Kyushu azalea or Miyama-Kirishima, is a species of flowering plant in the family Ericaceae, native to Kyushu, Japan. It is a parent of a large number of hybrid dwarf azaleas, drawn from the naturally occurring Kurume azaleas used in bonsai. It is the official flower of Unzen, Nagasaki, and of Kagoshima Prefecture."
          }
        ]
