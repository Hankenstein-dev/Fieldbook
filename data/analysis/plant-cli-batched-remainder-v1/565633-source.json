        "passages": [
          {
            "id": "s1:p1",
            "text": "Gagea lacaitae is a Mediterranean and Black Sea species of plants in the lily family. It is native to Spain incl. Balearic Islands, France incl. Corsica, Italy (Abruzzo + Sicily), Morocco, and Algeria."
          },
          {
            "id": "s1:p2",
            "text": "Gagea lacaitae is a bulb-forming herb with yellow flowers."
          },
          {
            "id": "s1:p3",
            "text": "The species is named for British botanist and politician Charles Carmichael Lacaita, 1853–1933."
          }
        ]
      }
    ]
