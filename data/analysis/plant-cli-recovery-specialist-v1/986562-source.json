        "title": "Promenaea stapelioides (Link & Otto) Lindl. — Plants of the World Online",
        "language": "en",
        "scope": "requested_taxon_Kew_account",
        "passages": [
          {
            "id": "s2:p1",
            "text": "Plants of the World Online account: Promenaea stapelioides (Link & Otto) Lindl.."
          },
          {
            "id": "s2:p2",
            "text": "The native range of this species is E. & S. Brazil. It is a pseudobulbous epiphyte and grows primarily in the wet tropical biome."
          }
