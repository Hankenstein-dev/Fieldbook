        "passages": [
          {
            "id": "s1:p1",
            "text": "Iochroma gesnerioides är en potatisväxtart som först beskrevs av Carl Sigismund Kunth, och fick sitt nu gällande namn av John Miers. Iochroma gesnerioides ingår i släktet Iochroma och familjen potatisväxter. Utöver nominatformen finns också underarten I. g. flavum."
          },
          {
            "id": "s1:p2",
            "text": " Källor "
          },
          {
            "id": "s1:p3",
            "text": "Kategori:Potatisväxter\ngesnerioides"
          }
        ]
      },
      {
        "id": "s2",
        "title": "Iochroma gesnerioides (Kunth) Miers — Plants of the World Online",
        "language": "en",
        "scope": "requested_taxon_Kew_account",
        "passages": [
          {
            "id": "s2:p1",
            "text": "Plants of the World Online account: Iochroma gesnerioides (Kunth) Miers."
          },
          {
            "id": "s2:p2",
            "text": "The native range of this species is Central Colombia to Central Ecuador. It is a tree and grows primarily in the wet tropical biome."
          }
        ]
      }
    ]
