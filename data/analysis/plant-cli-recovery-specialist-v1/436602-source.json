        "passages": [
          {
            "id": "s1:p1",
            "text": "Juncus decipiens är en tågväxtart som först beskrevs av Franz Georg Philipp Buchenau, och fick sitt nu gällande namn av Takenoshin Nakai. Juncus decipiens ingår i släktet tåg, och familjen tågväxter. IUCN kategoriserar arten globalt som livskraftig. Inga underarter finns listade i Catalogue of Life."
          },
          {
            "id": "s1:p2",
            "text": " Källor "
          },
          {
            "id": "s1:p3",
            "text": " Externa länkar "
          },
          {
            "id": "s1:p4",
            "text": "decipiens\ndecipiens"
          }
        ]
      },
      {
        "id": "s2",
        "title": "Juncus decipiens (Buchenau) Nakai — Plants of the World Online",
        "language": "en",
        "scope": "requested_taxon_Kew_account",
        "passages": [
          {
            "id": "s2:p1",
            "text": "Plants of the World Online account: Juncus decipiens (Buchenau) Nakai."
          },
          {
            "id": "s2:p2",
            "text": "The native range of this species is Assam to Russian Far East and New Guinea. It is a perennial and grows primarily in the temperate biome."
          }
        ]
      }
    ]
