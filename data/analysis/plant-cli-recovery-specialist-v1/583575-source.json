        "passages": [
          {
            "id": "s2:p1",
            "text": "Plants of the World Online account: Delosperma testaceum (Haw.) Schwantes."
          },
          {
            "id": "s2:p2",
            "text": "The native range of this species is Cape Prov. to Free State. It is a succulent subshrub and grows primarily in the subtropical biome."
          }
        ]
      }
