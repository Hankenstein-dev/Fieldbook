        "passages": [
          {
            "id": "s1:p1",
            "text": "Stranvaesia nussia is a species of flowering plant in the family Rosaceae. It is an evergreen tree which ranges from Nepal and Tibet to south-central China (Yunnan), Indochina (Laos, Myanmar, and Thailand), and the Philippines."
          },
          {
            "id": "s1:p2",
            "text": " Description \n Height: 5-9m tall.\n Branches: pilose when young, purple/brown when old.\n Petiole: 1 cm."
          },
          {
            "id": "s1:p3",
            "text": " Habitat \nS. nussia are restricted to particular elevational ranges in the Himalayas, along with being a rare tree species found in the Binsar Wildlife Sanctuary."
          }
        ]
      }
    ]
