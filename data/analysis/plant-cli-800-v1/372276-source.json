        "passages": [
          {
            "id": "s1:p1",
            "text": "Platanthera micrantha (formerly P. azorica) or the narrow-lipped butterfly orchid is a species of orchid in the genus Platanthera endemic to the Azores. It is an endangered species and is closely related to P. azorica and P. pollostantha, also endemic to the Azores."
          },
          {
            "id": "s1:p2",
            "text": "Distribution\nIt occurs on eight islands of the archipelago but is restricted to small, scattered populations in laurisilva scrub."
          },
          {
            "id": "s1:p3",
            "text": "Platanthera micrantha is one of the best indicators of semi-natural laurisilva habitats remaining on the Azores."
          }
        ]
      }
    ]
