        "passages": [
          {
            "id": "s1:p1",
            "text": "Microsorum scolopendria, synonym Phymatosorus scolopendria, commonly called monarch fern, musk fern, maile-scented fern, breadfruit fern, or wart fern is a species of fern within the family Polypodiaceae. This fern grows in the wild in the Western Pacific rim from Australia to New Caledonia to Fiji and throughout the South Pacific to French Polynesia."
          },
          {
            "id": "s1:p2",
            "text": "The scientific name M. scolopendria has been misapplied to Microsorum grossum (and their synonyms in Phymatosorus)."
          },
          {
            "id": "s1:p3",
            "text": " Media"
          }
        ]
      }
    ]
