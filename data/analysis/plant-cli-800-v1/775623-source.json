        "language": "pt",
        "scope": "title_matches_scientific_name",
        "passages": [
          {
            "id": "s1:p1",
            "text": "Euphorbia pterococca é uma espécie de planta com flor pertencente à família Euphorbiaceae. "
          },
          {
            "id": "s1:p2",
            "text": "A autoridade científica da espécie é Brot., tendo sido publicada em Flora Lusitanica 3: 312. 1805."
          },
          {
            "id": "s1:p3",
            "text": "O seu nome comum é ésula-angulosa."
          },
          {
            "id": "s1:p4",
            "text": " Portugal \nTrata-se de uma espécie presente no território português, nomeadamente em Portugal Continental e no Arquipélago da Madeira."
          },
          {
            "id": "s1:p5",
            "text": "Em termos de naturalidade é nativa das duas regiões atrás indicadas."
          },
          {
            "id": "s1:p6",
            "text": " Protecção \nNão se encontra protegida por legislação portuguesa ou da Comunidade Europeia."
          }
        ]
      }
    ]
  },
