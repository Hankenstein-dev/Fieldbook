        "scope": "title_matches_scientific_name",
        "passages": [
          {
            "id": "s1:p1",
            "text": "Ornithogalum pyrenaicum, also called Prussian asparagus, wild asparagus, Bath asparagus, Pyrenees star of Bethlehem, or spiked star of Bethlehem, is a plant whose young flower shoots may be eaten as a vegetable, similar to asparagus."
          },
          {
            "id": "s1:p2",
            "text": "The common name Bath asparagus comes from the fact it was once abundant near the city of the same name in England."
          },
          {
            "id": "s1:p3",
            "text": " Cultivation History "
          },
          {
            "id": "s1:p4",
            "text": "Cato the Elder recommends growing wild asparagus in his treatise De agri cultura."
          }
        ]
      }
    ]
