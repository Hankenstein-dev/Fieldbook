# Shared private-testing key. Never commit a real value.
PLANTNET_API_KEY=

# Explicitly allow the key in browser assets. Configure the stable HTTPS origin
# in Pl@ntNet Authorized domains. The key is then visible to site visitors.
# Put the opt-in in ignored .env.web.local for the hosted build.
PLANTNET_WEB_ENABLED=false
# Optional alternative browser key; omit to reuse PLANTNET_API_KEY.
# PLANTNET_WEB_API_KEY=
